# Folder containing the episode .txt files (searched recursively). Never commit the pack itself.
PROMOPILOT_INPUT_DIR=C:\path\to\input\pack

# Root for screenplay-derived outputs (parsed JSON, model responses, rankings).
# Keep it outside synced folders; defaults to ./outputs (gitignored) if unset.
PROMOPILOT_OUTPUT_DIR=C:\path\to\outputs

# Provider used for candidate generation: gemini | groq
LLM_PROVIDER=gemini

# Free-tier keys from aistudio.google.com and console.groq.com. Put real values only in .env (gitignored).
GEMINI_API_KEY=
GROQ_API_KEY=

# Model IDs as listed by each provider (no defaults are hardcoded in the code).
GEMINI_MODEL=
GROQ_MODEL=

# Blind quality judge (Phase 4C). Optional; defaults: gemini / gemini-3.5-flash-lite.
PROMOPILOT_JUDGE_PROVIDER=
PROMOPILOT_JUDGE_MODEL=
# judge-v1 (pilot benchmark, default) or judge-v2 (tightened anchors; under validation)
PROMOPILOT_JUDGE_PROMPT_VERSION=
