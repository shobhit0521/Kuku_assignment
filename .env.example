# Folder containing the episode .txt files (searched recursively). Never commit the pack itself.
PROMOPILOT_INPUT_DIR=C:\path\to\input\pack

# Root for screenplay-derived outputs (parsed JSON, model responses, rankings).
# Keep it outside synced folders; defaults to ./outputs (gitignored) if unset.
PROMOPILOT_OUTPUT_DIR=C:\path\to\outputs

# Provider used for candidate generation: gemini | groq
LLM_PROVIDER=gemini

# Free-tier keys from aistudio.google.com and console.groq.com. Put real values only in .env (gitignored).
GEMINI_API_KEY=
GROQ_API_KEY=

# Model IDs as listed by each provider (no defaults are hardcoded in the code).
GEMINI_MODEL=
GROQ_MODEL=

# Optional: parsed dataset folder (default: PROMOPILOT_OUTPUT_DIR\parsed).
# PROMOPILOT_PARSED_DIR=

# Blind quality judge (Phase 4C). Optional; defaults: gemini / gemini-3.5-flash-lite.
# PROMOPILOT_JUDGE_MODEL applies to PROMOPILOT_JUDGE_PROVIDER only; GROQ_JUDGE_MODEL / GEMINI_JUDGE_MODEL
# set a per-provider judge model (groq otherwise judges with GROQ_MODEL).
PROMOPILOT_JUDGE_PROVIDER=
PROMOPILOT_JUDGE_MODEL=
# judge-v1 (pilot benchmark, default) or judge-v2 (tightened anchors; under validation)
PROMOPILOT_JUDGE_PROMPT_VERSION=

# Optional extra OpenAI-compatible providers (none configured by default). Example for a provider "local":
# PROMOPILOT_PROVIDERS=local
# LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_MODEL=
# LOCAL_API_KEY=            (or LOCAL_API_KEY_ENV=NAME_OF_VARIABLE_HOLDING_THE_KEY)
# Request capabilities (any provider, e.g. GROQ_MAX_TOKENS_PARAM); defaults: true, true, max_tokens
# LOCAL_JSON_MODE=true
# LOCAL_SEND_TEMPERATURE=true
# LOCAL_MAX_TOKENS_PARAM=max_tokens

# --- Web app ---
# Dashboard data folder (default: PROMOPILOT_OUTPUT_DIR). The hosted app sets published/fullpack.
# PROMOPILOT_DASHBOARD_DIR=

# Upload page ("Analyse your own screenplays"). Every upload makes real model calls on the configured key.
# Scratch folder for upload jobs (default: the system temp folder\promopilot_live). Jobs are deleted after use.
# PROMOPILOT_LIVE_DIR=
# PROMOPILOT_LIVE_MAX_FILES=5
# PROMOPILOT_LIVE_MAX_FILE_KB=100
# Request budget per uploaded file: generation (one call plus one repair) and judging.
# PROMOPILOT_LIVE_GEN_REQUESTS_PER_FILE=2
# PROMOPILOT_LIVE_JUDGE_REQUESTS_PER_FILE=12
# Model requests allowed per UTC day across all visitors (resets if the server restarts; not a billing limit).
# PROMOPILOT_LIVE_DAILY_REQUEST_CAP=150
# Minutes before an unused job is deleted.
# PROMOPILOT_LIVE_JOB_TTL_MIN=120
