      "end_raw": "02:36.47",
      "start_ms": 147500,
      "end_ms": 156470,
      "text": "Slow push-in on the dark polished tabletop where the open invitation lies beside the wax seal. The bold Gothic lettering \"EXECUTION CLAUSE\" sits beneath the gold crest, while the fire dances reflected on the mahogany.",
      "line_number": 343,
      "duration_ms": 8970
    },
