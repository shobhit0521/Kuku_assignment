      "start_raw": "00:49.50",
      "end_raw": "00:53.00",
      "start_ms": 49500,
      "end_ms": 53000,
      "text": "Close-up of Clarissa smiling down at the calligraphy.",
      "line_number": 133,
      "duration_ms": 3500
    },
