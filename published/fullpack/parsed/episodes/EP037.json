      "start_raw": "02:25.50",
      "end_raw": "02:28.00",
      "start_ms": 145500,
      "end_ms": 148000,
      "text": "Clarissa takes a slow sip of the red wine, her eyes gleaming with dark relish.",
      "line_number": 339,
      "duration_ms": 2500
    },
    {
      "block_id": "EP037_B078",
      "episode_id": "EP037",
      "file_index": 77,
      "scene_id": "EP037_S04",
