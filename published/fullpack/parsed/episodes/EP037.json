      "offscreen": null,
      "start_raw": "00:50.00",
      "end_raw": "00:52.80",
      "start_ms": 50000,
      "end_ms": 52800,
      "text": "\"Lady Catherine Ashbridge.\"",
      "line_number": 137,
      "duration_ms": 2800
    },
    {
      "block_id": "EP037_B031",
      "episode_id": "EP037",
      "file_index": 30,
      "scene_id": "EP037_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:53.00",
      "end_raw": "00:56.00",
      "start_ms": 53000,
      "end_ms": 56000,
      "text": "Medium shot as Clarissa unfolds the second page attached to the invitation, her expression shifting to intrigue.",
      "line_number": 141,
      "duration_ms": 3000
    },
    {
      "block_id": "EP037_B032",
      "episode_id": "EP037",
      "file_index": 31,
      "scene_id": "EP037_S02",
      "block_type": "DIALOGUE",
      "label_raw": "LADY CLARISSA (Intrigued)",
      "speaker": "LADY CLARISSA",
      "delivery": [
        "Intrigued"
      ],
      "offscreen": null,
      "start_raw": "00:54.00",
      "end_raw": "00:56.20",
      "start_ms": 54000,
      "end_ms": 56200,
      "text": "\"And after the ceremony...\"",
      "line_number": 145,
      "duration_ms": 2200
    },
    {
      "block_id": "EP037_B033",
      "episode_id": "EP037",
      "file_index": 32,
      "scene_id": "EP037_S02",
      "block_type": "DIALOGUE",
      "label_raw": "NOBLEMAN (Curious)",
      "speaker": "NOBLEMAN",
      "delivery": [
        "Curious"
      ],
      "offscreen": null,
      "start_raw": "00:56.20",
      "end_raw": "00:57.20",
      "start_ms": 56200,
      "end_ms": 57200,
      "text": "\"What?\"",
      "line_number": 149,
      "duration_ms": 1000
    },
    {
      "block_id": "EP037_B034",
      "episode_id": "EP037",
      "file_index": 33,
      "scene_id": "EP037_S02",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:56.80",
      "end_raw": "00:58.50",
      "start_ms": 56800,
      "end_ms": 58500,
      "text": "Clarissa hands the letter upward to him. He takes it and looks down at the bold heading.",
      "line_number": 153,
      "duration_ms": 1700
    },
    {
      "block_id": "EP037_B035",
      "episode_id": "EP037",
      "file_index": 34,
      "scene_id": "EP037_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:58.50",
      "end_raw": "01:02.00",
      "start_ms": 58500,
      "end_ms": 62000,
      "text": "Close-up of the nobleman reading, his eyes widening in shock before breaking into a grin.",
      "line_number": 157,
      "duration_ms": 3500
    },
    {
      "block_id": "EP037_B036",
      "episode_id": "EP037",
      "file_index": 35,
      "scene_id": "EP037_S02",
      "block_type": "DIALOGUE",
      "label_raw": "NOBLEMAN (Reading in Awe)",
      "speaker": "NOBLEMAN",
      "delivery": [
        "Reading in Awe"
      ],
      "offscreen": null,
      "start_raw": "00:58.80",
      "end_raw": "01:01.80",
      "start_ms": 58800,
      "end_ms": 61800,
      "text": "\"The sentencing of the condemned.\"",
      "line_number": 161,
      "duration_ms": 3000
    },
    {
      "block_id": "EP037_B037",
      "episode_id": "EP037",
      "file_index": 36,
      "scene_id": "EP037_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:02.00",
      "end_raw": "01:05.50",
      "start_ms": 62000,
      "end_ms": 65500,
      "text": "Close-up of Clarissa turning back to the fire, laughing softly with dark delight.",
      "line_number": 165,
      "duration_ms": 3500
    },
    {
      "block_id": "EP037_B038",
      "episode_id": "EP037",
      "file_index": 37,
      "scene_id": "EP037_S02",
      "block_type": "DIALOGUE",
      "label_raw": "LADY CLARISSA (Gloating, Mocking)",
      "speaker": "LADY CLARISSA",
      "delivery": [
        "Gloating",
        "Mocking"
      ],
      "offscreen": null,
      "start_raw": "01:02.80",
      "end_raw": "01:05.50",
      "start_ms": 62800,
      "end_ms": 65500,
      "text": "\"They want the families to witness it.\"",
      "line_number": 169,
      "duration_ms": 2700
    },
    {
      "block_id": "EP037_B039",
      "episode_id": "EP037",
      "file_index": 38,
      "scene_id": "EP037_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:05.50",
      "end_raw": "01:09.00",
      "start_ms": 65500,
      "end_ms": 69000,
      "text": "Medium shot of the nobleman holding the invitation, chuckling at the audacity.",
      "line_number": 173,
      "duration_ms": 3500
    },
    {
      "block_id": "EP037_B040",
      "episode_id": "EP037",
      "file_index": 39,
      "scene_id": "EP037_S02",
      "block_type": "DIALOGUE",
      "label_raw": "NOBLEMAN (Fascinated)",
      "speaker": "NOBLEMAN",
      "delivery": [
        "Fascinated"
      ],
      "offscreen": null,
      "start_raw": "01:06.50",
      "end_raw": "01:08.80",
      "start_ms": 66500,
      "end_ms": 68800,
      "text": "\"A public execution after a wedding.\"",
      "line_number": 177,
      "duration_ms": 2300
    },
    {
      "block_id": "EP037_B041",
      "episode_id": "EP037",
      "file_index": 40,
      "scene_id": "EP037_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:09.00",
      "end_raw": "01:12.50",
      "start_ms": 69000,
      "end_ms": 72500,
      "text": "Medium profile shot of Clarissa gazing back at him over her shoulder.",
      "line_number": 181,
      "duration_ms": 3500
    },
    {
      "block_id": "EP037_B042",
      "episode_id": "EP037",
      "file_index": 41,
      "scene_id": "EP037_S02",
      "block_type": "DIALOGUE",
      "label_raw": "LADY CLARISSA (Chilling, Sharp)",
      "speaker": "LADY CLARISSA",
      "delivery": [
        "Chilling",
        "Sharp"
      ],
      "offscreen": null,
      "start_raw": "01:09.50",
      "end_raw": "01:12.20",
      "start_ms": 69500,
      "end_ms": 72200,
      "text": "\"Not just an execution. A warning.\"",
      "line_number": 185,
      "duration_ms": 2700
    },
    {
      "block_id": "EP037_B043",
      "episode_id": "EP037",
      "file_index": 42,
      "scene_id": "EP037_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:12.50",
      "end_raw": "01:15.50",
      "start_ms": 72500,
      "end_ms": 75500,
      "text": "Close-up of the nobleman's stern face, leaning down.",
      "line_number": 189,
      "duration_ms": 3000
    },
    {
      "block_id": "EP037_B044",
      "episode_id": "EP037",
      "file_index": 43,
      "scene_id": "EP037_S02",
      "block_type": "DIALOGUE",
      "label_raw": "NOBLEMAN (Curious)",
      "speaker": "NOBLEMAN",
      "delivery": [
        "Curious"
      ],
      "offscreen": null,
      "start_raw": "01:13.00",
      "end_raw": "01:14.20",
      "start_ms": 73000,
      "end_ms": 74200,
      "text": "\"To whom?\"",
      "line_number": 193,
      "duration_ms": 1200
    },
    {
      "block_id": "EP037_B045",
      "episode_id": "EP037",
      "file_index": 44,
      "scene_id": "EP037_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:15.50",
      "end_raw": "01:22.50",
      "start_ms": 75500,
      "end_ms": 82500,
      "text": "Close-up on Clarissa taking the letter back into her gloved fingers, her eyes gleaming with aristocratic cruelty.",
      "line_number": 197,
      "duration_ms": 7000
    },
    {
      "block_id": "EP037_B046",
      "episode_id": "EP037",
      "file_index": 45,
      "scene_id": "EP037_S02",
      "block_type": "DIALOGUE",
      "label_raw": "LADY CLARISSA (Contemptuous, Scornful)",
      "speaker": "LADY CLARISSA",
      "delivery": [
        "Contemptuous",
        "Scornful"
      ],
      "offscreen": null,
      "start_raw": "01:17.00",
      "end_raw": "01:21.80",
      "start_ms": 77000,
      "end_ms": 81800,
      "text": "\"To every woman who thinks she can rise above the place she was given.\"",
      "line_number": 201,
      "duration_ms": 4800
    },
    {
      "block_id": "EP037_B047",
      "episode_id": "EP037",
      "file_index": 46,
      "scene_id": "EP037_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:22.50",
      "end_raw": "01:28.00",
      "start_ms": 82500,
      "end_ms": 88000,
      "text": "Wide shot of the parlor as Clarissa tosses the invitation dismissively onto the side table and looks directly toward the viewer.",
      "line_number": 205,
      "duration_ms": 5500
    },
    {
      "block_id": "EP037_B048",
      "episode_id": "EP037",
      "file_index": 47,
      "scene_id": "EP037_S02",
      "block_type": "DIALOGUE",
      "label_raw": "LADY CLARISSA (Smug Triumph)",
      "speaker": "LADY CLARISSA",
      "delivery": [
        "Smug Triumph"
      ],
      "offscreen": null,
      "start_raw": "01:23.00",
      "end_raw": "01:27.50",
      "start_ms": 83000,
      "end_ms": 87500,
      "text": "\"Juliana's ruin will be a lesson. And we will be there to watch.\"",
      "line_number": 209,
      "duration_ms": 4500
    },
    {
      "block_id": "EP037_B049",
      "episode_id": "EP037",
      "file_index": 48,
      "scene_id": "EP037_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:28.00",
      "end_raw": "01:32.00",
      "start_ms": 88000,
      "end_ms": 92000,
      "text": "Wide, dim shot of the subterranean stone dungeon. Juliana sits slumped against a weeping stone wall on the wet floor, dressed in a tattered prison smock, illuminated only by faint overhead moonlight piercing a ceiling grate.",
      "line_number": 220,
      "duration_ms": 4000
    },
    {
      "block_id": "EP037_B050",
      "episode_id": "EP037",
      "file_index": 49,
      "scene_id": "EP037_S03",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:28.50",
      "end_raw": "01:32.00",
      "start_ms": 88500,
      "end_ms": 92000,
      "text": "Rhythmic water drips splashing onto stagnant dungeon puddles and a low, mournful ambient drone.",
      "line_number": 224,
      "duration_ms": 3500
    },
    {
      "block_id": "EP037_B051",
      "episode_id": "EP037",
      "file_index": 50,
      "scene_id": "EP037_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:32.00",
      "end_raw": "01:35.50",
      "start_ms": 92000,
      "end_ms": 95500,
      "text": "Close-up on Juliana's bruised hand, locked in a heavy iron shackle chained to the wall, trembling as she hesitates inches away from a dirty earthen bowl filled with murky liquid.",
      "line_number": 228,
      "duration_ms": 3500
    },
    {
      "block_id": "EP037_B052",
      "episode_id": "EP037",
      "file_index": 51,
      "scene_id": "EP037_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:33.50",
      "end_raw": "01:35.50",
      "start_ms": 93500,
      "end_ms": 95500,
      "text": "Juliana curls her fingers back, pulling away from the foul sustenance in defiance.",
      "line_number": 232,
      "duration_ms": 2000
    },
    {
      "block_id": "EP037_B053",
      "episode_id": "EP037",
      "file_index": 52,
      "scene_id": "EP037_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:35.50",
      "end_raw": "01:40.50",
      "start_ms": 95500,
      "end_ms": 100500,
      "text": "Tight close-up of Juliana's dirty, tear-stained face. Her eyes squeeze shut as tears stream down her cheeks from overwhelming physical agony and hunger.",
      "line_number": 236,
      "duration_ms": 5000
    },
    {
      "block_id": "EP037_B054",
      "episode_id": "EP037",
      "file_index": 53,
      "scene_id": "EP037_S03",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Weak, Whispering through Tears)",
      "speaker": "JULIANA",
      "delivery": [
        "Weak",
        "Whispering through Tears"
      ],
      "offscreen": null,
      "start_raw": "01:36.00",
      "end_raw": "01:39.50",
      "start_ms": 96000,
      "end_ms": 99500,
      "text": "\"They think hunger will make me surrender.\"",
      "line_number": 240,
      "duration_ms": 3500
    },
    {
      "block_id": "EP037_B055",
      "episode_id": "EP037",
      "file_index": 54,
      "scene_id": "EP037_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:40.50",
      "end_raw": "01:43.50",
      "start_ms": 100500,
      "end_ms": 103500,
      "text": "Extreme close-up of Juliana's blue eyes snapping open, blazing with unyielding defiance.",
      "line_number": 244,
      "duration_ms": 3000
    },
    {
      "block_id": "EP037_B056",
      "episode_id": "EP037",
      "file_index": 55,
      "scene_id": "EP037_S03",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Fierce Resolve)",
      "speaker": "JULIANA",
      "delivery": [
        "Fierce Resolve"
      ],
      "offscreen": null,
      "start_raw": "01:40.80",
      "end_raw": "01:43.20",
      "start_ms": 100800,
      "end_ms": 103200,
      "text": "\"They think fear will make me beg.\"",
      "line_number": 248,
      "duration_ms": 2400
    },
    {
      "block_id": "EP037_B057",
      "episode_id": "EP037",
      "file_index": 56,
      "scene_id": "EP037_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:43.50",
      "end_raw": "01:48.50",
      "start_ms": 103500,
      "end_ms": 108500,
      "text": "Full shot of Juliana using her bare hands against the slimy stone floor to drag herself upright to her knees, chains rattling loudly.",
      "line_number": 252,
      "duration_ms": 5000
    },
    {
      "block_id": "EP037_B058",
      "episode_id": "EP037",
      "file_index": 57,
      "scene_id": "EP037_S03",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:44.00",
      "end_raw": "01:47.00",
      "start_ms": 104000,
      "end_ms": 107000,
      "text": "The harsh scrape and clatter of heavy iron chains dragging across wet stone.",
      "line_number": 256,
      "duration_ms": 3000
    },
    {
      "block_id": "EP037_B059",
      "episode_id": "EP037",
      "file_index": 58,
      "scene_id": "EP037_S03",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Straining, Defiant Gasps)",
      "speaker": "JULIANA",
      "delivery": [
        "Straining",
        "Defiant Gasps"
      ],
      "offscreen": null,
      "start_raw": "01:45.50",
      "end_raw": "01:47.80",
      "start_ms": 105500,
      "end_ms": 107800,
      "text": "\"I will not!\"",
      "line_number": 260,
      "duration_ms": 2300
    },
    {
      "block_id": "EP037_B060",
      "episode_id": "EP037",
      "file_index": 59,
      "scene_id": "EP037_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:48.50",
      "end_raw": "01:53.50",
      "start_ms": 108500,
      "end_ms": 113500,
      "text": "Low-angle shot looking up at Juliana as she thrusts her chin high toward the iron ceiling grate, bathed in cold shafts of light.",
      "line_number": 264,
      "duration_ms": 5000
    },
    {
      "block_id": "EP037_B061",
      "episode_id": "EP037",
      "file_index": 60,
      "scene_id": "EP037_S03",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Passionate Defiance)",
      "speaker": "JULIANA",
      "delivery": [
        "Passionate Defiance"
      ],
      "offscreen": null,
      "start_raw": "01:49.00",
      "end_raw": "01:52.50",
      "start_ms": 109000,
      "end_ms": 112500,
      "text": "\"They can take my name. They can take my home.\"",
      "line_number": 268,
      "duration_ms": 3500
    },
    {
      "block_id": "EP037_B062",
      "episode_id": "EP037",
      "file_index": 61,
      "scene_id": "EP037_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:53.50",
      "end_raw": "01:56.50",
      "start_ms": 113500,
      "end_ms": 116500,
      "text": "Tight close-up of Juliana's iron-shackled hand reaching out and gripping the massive iron ring anchored into the dungeon pillar with crushing determination.",
      "line_number": 272,
      "duration_ms": 3000
    },
    {
      "block_id": "EP037_B063",
      "episode_id": "EP037",
      "file_index": 62,
      "scene_id": "EP037_S03",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Indomitable Spirit)",
      "speaker": "JULIANA",
      "delivery": [
        "Indomitable Spirit"
      ],
      "offscreen": null,
      "start_raw": "01:53.60",
      "end_raw": "01:56.20",
      "start_ms": 113600,
      "end_ms": 116200,
      "text": "\"They cannot take who I am!\"",
      "line_number": 276,
      "duration_ms": 2600
    },
    {
      "block_id": "EP037_B064",
      "episode_id": "EP037",
      "file_index": 63,
      "scene_id": "EP037_S04",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:56.50",
      "end_raw": "02:00.00",
      "start_ms": 116500,
      "end_ms": 120000,
      "text": "Medium two-shot in the dimly lit parlor, illuminated by the warm glow of the fireplace. Clarissa now wears a deep blue velvet gown, reclining in an armchair beside the nobleman.",
      "line_number": 287,
      "duration_ms": 3500
    },
    {
      "block_id": "EP037_B065",
      "episode_id": "EP037",
      "file_index": 64,
      "scene_id": "EP037_S04",
      "block_type": "DIALOGUE",
      "label_raw": "NOBLEMAN (Quietly Skeptical)",
      "speaker": "NOBLEMAN",
      "delivery": [
        "Quietly Skeptical"
      ],
      "offscreen": null,
      "start_raw": "01:57.20",
      "end_raw": "01:59.80",
      "start_ms": 117200,
      "end_ms": 119800,
      "text": "\"Do you think she'll actually be executed?\"",
      "line_number": 291,
      "duration_ms": 2600
    },
    {
      "block_id": "EP037_B066",
      "episode_id": "EP037",
      "file_index": 65,
      "scene_id": "EP037_S04",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "02:00.00",
      "end_raw": "02:04.50",
      "start_ms": 120000,
      "end_ms": 124500,
      "text": "Close-up of Clarissa giving a slight, dismissive scoff before turning to him with cold certainty.",
      "line_number": 295,
      "duration_ms": 4500
    },
    {
      "block_id": "EP037_B067",
      "episode_id": "EP037",
      "file_index": 66,
      "scene_id": "EP037_S04",
      "block_type": "DIALOGUE",
      "label_raw": "LADY CLARISSA (Dismissive, Certain)",
      "speaker": "LADY CLARISSA",
