      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "02:04.50",
      "end_raw": "02:07.00",
      "start_ms": 124500,
      "end_ms": 127000,
      "text": "Medium close-up of the nobleman looking down pensively at the open execution clause on the table.",
      "line_number": 303,
      "duration_ms": 2500
    },
    {
      "block_id": "EP037_B069",
      "episode_id": "EP037",
      "file_index": 68,
      "scene_id": "EP037_S04",
      "block_type": "DIALOGUE",
      "label_raw": "NOBLEMAN (Musing)",
      "speaker": "NOBLEMAN",
      "delivery": [
        "Musing"
