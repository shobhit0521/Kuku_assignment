      ],
      "offscreen": null,
      "start_raw": "02:00.50",
      "end_raw": "02:04.20",
      "start_ms": 120500,
      "end_ms": 124200,
      "text": "\"After what she has been accused of? Of course.\"",
      "line_number": 299,
      "duration_ms": 3700
    },
    {
      "block_id": "EP037_B068",
      "episode_id": "EP037",
      "file_index": 67,
      "scene_id": "EP037_S04",
      "block_type": "CAMERA",
