  "blocks": [
    {
      "block_id": "EP007_B001",
      "episode_id": "EP007",
      "file_index": 0,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:04.80",
      "start_ms": 0,
      "end_ms": 4800,
      "text": "Medium shot of Juliana kneeling on the cold, damp ground outside the stone cottage, pulling weeds from the dirt with her bare hands.",
      "line_number": 14,
      "duration_ms": 4800
    },
    {
      "block_id": "EP007_B002",
      "episode_id": "EP007",
      "file_index": 1,
      "scene_id": "EP007_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:04.80",
      "start_ms": 0,
      "end_ms": 4800,
      "text": "Juliana, dressed in her simple grey long-sleeved gown, works tirelessly with soil caked beneath her fingernails.",
      "line_number": 18,
      "duration_ms": 4800
    },
    {
      "block_id": "EP007_B003",
      "episode_id": "EP007",
      "file_index": 2,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:04.80",
      "end_raw": "00:11.80",
      "start_ms": 4800,
      "end_ms": 11800,
      "text": "Low-angle tracking shot as an ornate black-and-gold carriage with crest emblazoned on the door rolls to a stop on the muddy path outside the gate.",
      "line_number": 22,
      "duration_ms": 7000
    },
    {
      "block_id": "EP007_B004",
      "episode_id": "EP007",
      "file_index": 3,
      "scene_id": "EP007_S01",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:05.00",
      "end_raw": "00:11.50",
      "start_ms": 5000,
      "end_ms": 11500,
      "text": "Heavy carriage wheels grinding in mud, horse snorts, and rhythmic hoofbeats halting.",
      "line_number": 26,
      "duration_ms": 6500
    },
    {
      "block_id": "EP007_B005",
      "episode_id": "EP007",
      "file_index": 4,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:11.80",
      "end_raw": "00:15.00",
      "start_ms": 11800,
      "end_ms": 15000,
      "text": "Medium shot as Aristocratic Woman steps out of the carriage into the misty air, shielding herself under an intricate lace parasol in an elegant lavender gown.",
      "line_number": 30,
      "duration_ms": 3200
    },
    {
      "block_id": "EP007_B006",
      "episode_id": "EP007",
      "file_index": 5,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:15.00",
      "end_raw": "00:19.50",
      "start_ms": 15000,
      "end_ms": 19500,
      "text": "Gerald steps down from the carriage behind her, looking immaculate in a high-collared navy frock coat, white waistcoat, and dark cravat.",
      "line_number": 34,
      "duration_ms": 4500
    },
    {
      "block_id": "EP007_B007",
      "episode_id": "EP007",
      "file_index": 6,
      "scene_id": "EP007_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:19.50",
      "end_raw": "00:21.00",
      "start_ms": 19500,
      "end_ms": 21000,
      "text": "Aristocratic Woman smirks cruelly as she surveys the humble stone cottage.",
      "line_number": 38,
      "duration_ms": 1500
    },
    {
      "block_id": "EP007_B008",
      "episode_id": "EP007",
      "file_index": 7,
      "scene_id": "EP007_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:21.00",
      "end_raw": "00:24.00",
      "start_ms": 21000,
      "end_ms": 24000,
      "text": "Juliana rinses the heavy mud from her hands in a cold rainwater puddle and rises to her feet, holding her head high.",
      "line_number": 42,
      "duration_ms": 3000
    },
    {
      "block_id": "EP007_B009",
      "episode_id": "EP007",
      "file_index": 8,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ARISTOCRATIC WOMAN (Mocking, Condescending)",
      "speaker": "ARISTOCRATIC WOMAN",
      "delivery": [
        "Mocking",
        "Condescending"
      ],
      "offscreen": null,
      "start_raw": "00:22.00",
      "end_raw": "00:24.50",
      "start_ms": 22000,
      "end_ms": 24500,
      "text": "\"This is where you live now?\"",
      "line_number": 46,
      "duration_ms": 2500
    },
    {
      "block_id": "EP007_B010",
      "episode_id": "EP007",
      "file_index": 9,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:24.50",
      "end_raw": "00:29.80",
      "start_ms": 24500,
      "end_ms": 29800,
      "text": "Medium shot of Gerald standing beside Aristocratic Woman, sneering disdainfully.",
      "line_number": 50,
      "duration_ms": 5300
    },
    {
      "block_id": "EP007_B011",
      "episode_id": "EP007",
      "file_index": 10,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "GERALD (Arrogant, Scornful)",
      "speaker": "GERALD",
      "delivery": [
        "Arrogant",
        "Scornful"
      ],
      "offscreen": null,
      "start_raw": "00:25.00",
      "end_raw": "00:29.80",
      "start_ms": 25000,
      "end_ms": 29800,
      "text": "\"A fitting home for a woman who threw away everything for a penniless soldier.\"",
      "line_number": 54,
      "duration_ms": 4800
    },
    {
      "block_id": "EP007_B012",
      "episode_id": "EP007",
      "file_index": 11,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:29.80",
      "end_raw": "00:32.80",
      "start_ms": 29800,
      "end_ms": 32800,
      "text": "Medium close-up of Juliana, defiant and unflinching despite her soiled dress and damp hair.",
      "line_number": 58,
      "duration_ms": 3000
    },
    {
      "block_id": "EP007_B013",
      "episode_id": "EP007",
      "file_index": 12,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Sharp, Unintimidated)",
      "speaker": "JULIANA",
      "delivery": [
        "Sharp",
        "Unintimidated"
      ],
      "offscreen": null,
      "start_raw": "00:30.00",
      "end_raw": "00:32.60",
      "start_ms": 30000,
      "end_ms": 32600,
      "text": "\"You came all this way just to insult my home?\"",
      "line_number": 62,
      "duration_ms": 2600
    },
    {
      "block_id": "EP007_B014",
      "episode_id": "EP007",
      "file_index": 13,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:32.80",
      "end_raw": "00:37.50",
      "start_ms": 32800,
      "end_ms": 37500,
      "text": "Close-up of Aristocratic Woman erupting into high-pitched, malicious laughter beneath her parasol.",
      "line_number": 66,
      "duration_ms": 4700
    },
    {
      "block_id": "EP007_B015",
      "episode_id": "EP007",
      "file_index": 14,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ARISTOCRATIC WOMAN (Gloating, Mocking)",
      "speaker": "ARISTOCRATIC WOMAN",
      "delivery": [
        "Gloating",
        "Mocking"
      ],
      "offscreen": null,
      "start_raw": "00:33.20",
      "end_raw": "00:37.80",
      "start_ms": 33200,
      "end_ms": 37800,
      "text": "\"Home? Look at your hands, Juliana.\"",
      "line_number": 70,
      "duration_ms": 4600
    },
    {
      "block_id": "EP007_B016",
      "episode_id": "EP007",
      "file_index": 15,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:37.80",
      "end_raw": "00:39.80",
      "start_ms": 37800,
      "end_ms": 39800,
      "text": "Close-up of Juliana's mud-stained palms held open against her apron.",
      "line_number": 74,
      "duration_ms": 2000
    },
    {
      "block_id": "EP007_B017",
      "episode_id": "EP007",
      "file_index": 16,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ARISTOCRATIC WOMAN (O.S.) (Cruel)",
      "speaker": "ARISTOCRATIC WOMAN",
      "delivery": [
        "Cruel"
      ],
      "offscreen": "O.S.",
      "start_raw": "00:38.20",
      "end_raw": "00:39.80",
      "start_ms": 38200,
      "end_ms": 39800,
      "text": "\"You look like a servant.\"",
      "line_number": 78,
      "duration_ms": 1600
    },
    {
      "block_id": "EP007_B018",
      "episode_id": "EP007",
      "file_index": 17,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:39.80",
      "end_raw": "00:41.00",
      "start_ms": 39800,
      "end_ms": 41000,
      "text": "Close-up of Gerald's smug expression watching Juliana.",
      "line_number": 82,
      "duration_ms": 1200
    },
    {
      "block_id": "EP007_B019",
      "episode_id": "EP007",
      "file_index": 18,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:41.00",
      "end_raw": "00:45.00",
      "start_ms": 41000,
      "end_ms": 45000,
      "text": "Medium close-up of Juliana lifting her chin with unwavering dignity.",
      "line_number": 86,
      "duration_ms": 4000
    },
    {
      "block_id": "EP007_B020",
      "episode_id": "EP007",
      "file_index": 19,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Proud, Resolute)",
      "speaker": "JULIANA",
      "delivery": [
        "Proud",
        "Resolute"
      ],
      "offscreen": null,
      "start_raw": "00:41.20",
      "end_raw": "00:44.80",
      "start_ms": 41200,
      "end_ms": 44800,
      "text": "\"I work with my hands. There is no shame in that.\"",
      "line_number": 90,
      "duration_ms": 3600
    },
    {
      "block_id": "EP007_B021",
      "episode_id": "EP007",
      "file_index": 20,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:45.00",
      "end_raw": "00:47.00",
      "start_ms": 45000,
      "end_ms": 47000,
      "text": "Close-up on Gerald's tightening jaw.",
      "line_number": 94,
      "duration_ms": 2000
    },
    {
      "block_id": "EP007_B022",
      "episode_id": "EP007",
      "file_index": 21,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "GERALD (Biting, Condescending)",
      "speaker": "GERALD",
      "delivery": [
        "Biting",
        "Condescending"
      ],
      "offscreen": null,
      "start_raw": "00:45.20",
      "end_raw": "00:46.80",
      "start_ms": 45200,
      "end_ms": 46800,
      "text": "\"You were born a lady.\"",
      "line_number": 98,
      "duration_ms": 1600
    },
    {
      "block_id": "EP007_B023",
      "episode_id": "EP007",
      "file_index": 22,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:47.00",
      "end_raw": "00:50.80",
      "start_ms": 47000,
      "end_ms": 50800,
      "text": "Close-up on Juliana's clear blue eyes, shining with unbroken pride.",
      "line_number": 102,
      "duration_ms": 3800
    },
    {
      "block_id": "EP007_B024",
      "episode_id": "EP007",
      "file_index": 23,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Firm, Unapologetic)",
      "speaker": "JULIANA",
      "delivery": [
        "Firm",
        "Unapologetic"
      ],
      "offscreen": null,
      "start_raw": "00:48.80",
      "end_raw": "00:50.40",
      "start_ms": 48800,
      "end_ms": 50400,
      "text": "\"And I remain one.\"",
      "line_number": 106,
      "duration_ms": 1600
    },
    {
      "block_id": "EP007_B025",
      "episode_id": "EP007",
      "file_index": 24,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:50.80",
      "end_raw": "00:54.80",
      "start_ms": 50800,
      "end_ms": 54800,
      "text": "Wide shot framing Juliana facing off against Gerald and Aristocratic Woman in the bleak courtyard.",
      "line_number": 110,
      "duration_ms": 4000
    },
    {
      "block_id": "EP007_B026",
      "episode_id": "EP007",
      "file_index": 25,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "GERALD (Bitter, Sneering)",
      "speaker": "GERALD",
      "delivery": [
        "Bitter",
        "Sneering"
      ],
      "offscreen": null,
      "start_raw": "00:51.50",
      "end_raw": "00:54.60",
      "start_ms": 51500,
      "end_ms": 54600,
      "text": "\"You chose that scarred beggar over a life of comfort.\"",
      "line_number": 114,
      "duration_ms": 3100
    },
    {
      "block_id": "EP007_B027",
      "episode_id": "EP007",
      "file_index": 26,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:54.80",
      "end_raw": "01:01.50",
      "start_ms": 54800,
      "end_ms": 61500,
      "text": "Two-shot profile of Juliana looking straight into Gerald's eyes without flinching.",
      "line_number": 118,
      "duration_ms": 6700
    },
    {
      "block_id": "EP007_B028",
      "episode_id": "EP007",
      "file_index": 27,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Passionate, Defiant)",
      "speaker": "JULIANA",
      "delivery": [
        "Passionate",
        "Defiant"
      ],
      "offscreen": null,
      "start_raw": "00:57.80",
      "end_raw": "01:01.00",
      "start_ms": 57800,
      "end_ms": 61000,
      "text": "\"I chose a man who stood beside me when you walked away.\"",
      "line_number": 122,
      "duration_ms": 3200
    },
    {
      "block_id": "EP007_B029",
      "episode_id": "EP007",
      "file_index": 28,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:01.50",
      "end_raw": "01:05.20",
      "start_ms": 61500,
      "end_ms": 65200,
      "text": "Intense close-up of Juliana dismissing him with utter contempt.",
      "line_number": 126,
      "duration_ms": 3700
    },
    {
      "block_id": "EP007_B030",
      "episode_id": "EP007",
      "file_index": 29,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Cold, Commanding)",
      "speaker": "JULIANA",
      "delivery": [
        "Cold",
        "Commanding"
      ],
      "offscreen": null,
      "start_raw": "01:01.80",
      "end_raw": "01:04.80",
      "start_ms": 61800,
      "end_ms": 64800,
      "text": "\"You have no authority here. Leave.\"",
      "line_number": 130,
      "duration_ms": 3000
    },
    {
      "block_id": "EP007_B031",
      "episode_id": "EP007",
      "file_index": 30,
      "scene_id": "EP007_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:05.20",
      "end_raw": "01:09.50",
      "start_ms": 65200,
      "end_ms": 69500,
      "text": "Close-up of Gerald lunging forward, aggressively pointing his finger into Juliana's face.",
      "line_number": 134,
      "duration_ms": 4300
    },
    {
      "block_id": "EP007_B032",
      "episode_id": "EP007",
      "file_index": 31,
      "scene_id": "EP007_S01",
      "block_type": "DIALOGUE",
      "label_raw": "GERALD (Furious, Threatening)",
