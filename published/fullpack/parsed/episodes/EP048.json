  "blocks": [
    {
      "block_id": "EP048_B001",
      "episode_id": "EP048",
      "file_index": 0,
      "scene_id": "EP048_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:04.50",
      "start_ms": 0,
      "end_ms": 4500,
      "text": "Medium shot tracking slightly as Catherine stands beside a tall mullioned stone window, silhouetted against the moonlight over the distant castle spires.",
      "line_number": 14,
      "duration_ms": 4500
    },
    {
      "block_id": "EP048_B002",
      "episode_id": "EP048",
      "file_index": 1,
      "scene_id": "EP048_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:03.00",
      "start_ms": 0,
      "end_ms": 3000,
      "text": "Catherine, adorned in an ornate dark burgundy gown with braided golden hair, gazes out the dark window before turning slowly with a cold, venomous smirk.",
      "line_number": 18,
      "duration_ms": 3000
    },
    {
      "block_id": "EP048_B003",
      "episode_id": "EP048",
      "file_index": 2,
      "scene_id": "EP048_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Vindictive, Cold)",
      "speaker": "CATHERINE",
      "delivery": [
        "Vindictive",
        "Cold"
      ],
      "offscreen": null,
      "start_raw": "00:02.40",
      "end_raw": "00:07.50",
      "start_ms": 2400,
      "end_ms": 7500,
      "text": "\"Two words, and that healer's crown rolls right back into the gutter where it belongs.\"",
      "line_number": 22,
      "duration_ms": 5100
    },
    {
      "block_id": "EP048_B004",
      "episode_id": "EP048",
      "file_index": 3,
      "scene_id": "EP048_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:04.50",
      "end_raw": "00:08.50",
      "start_ms": 4500,
      "end_ms": 8500,
      "text": "Close-up on Catherine's profile and jewelry as she speaks with calculating contempt.",
      "line_number": 26,
      "duration_ms": 4000
    },
    {
      "block_id": "EP048_B005",
      "episode_id": "EP048",
      "file_index": 4,
      "scene_id": "EP048_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:07.80",
      "end_raw": "00:12.30",
      "start_ms": 7800,
      "end_ms": 12300,
      "text": "Catherine glides across the chamber past a roaring stone hearth, picking up an orange from a silver platter on the table.",
      "line_number": 30,
      "duration_ms": 4500
    },
    {
      "block_id": "EP048_B006",
      "episode_id": "EP048",
      "file_index": 5,
      "scene_id": "EP048_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Scheming)",
      "speaker": "CATHERINE",
      "delivery": [
        "Scheming"
      ],
      "offscreen": null,
      "start_raw": "00:08.00",
      "end_raw": "00:12.30",
      "start_ms": 8000,
      "end_ms": 12300,
      "text": "\"Ten days. He gave himself ten days to fix it.\"",
      "line_number": 34,
      "duration_ms": 4300
    },
    {
      "block_id": "EP048_B007",
      "episode_id": "EP048",
      "file_index": 6,
      "scene_id": "EP048_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:12.30",
      "end_raw": "00:20.00",
      "start_ms": 12300,
      "end_ms": 20000,
      "text": "Medium close-up frontal shot of Catherine turning directly toward the viewer, her expression tightening into ruthless determination.",
      "line_number": 38,
      "duration_ms": 7700
    },
    {
      "block_id": "EP048_B008",
      "episode_id": "EP048",
      "file_index": 7,
      "scene_id": "EP048_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Intense, Measured)",
      "speaker": "CATHERINE",
      "delivery": [
        "Intense",
        "Measured"
      ],
      "offscreen": null,
      "start_raw": "00:12.60",
      "end_raw": "00:14.90",
      "start_ms": 12600,
      "end_ms": 14900,
      "text": "\"Ten days for the council to sit.\"",
      "line_number": 42,
      "duration_ms": 2300
    },
    {
      "block_id": "EP048_B009",
      "episode_id": "EP048",
      "file_index": 8,
      "scene_id": "EP048_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:15.00",
      "end_raw": "00:18.50",
      "start_ms": 15000,
      "end_ms": 18500,
      "text": "Catherine raises a gloved index finger, emphasizing each point with sinister precision.",
      "line_number": 46,
      "duration_ms": 3500
    },
    {
      "block_id": "EP048_B010",
      "episode_id": "EP048",
      "file_index": 9,
      "scene_id": "EP048_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Calculating)",
      "speaker": "CATHERINE",
      "delivery": [
        "Calculating"
      ],
      "offscreen": null,
      "start_raw": "00:15.10",
      "end_raw": "00:17.20",
      "start_ms": 15100,
      "end_ms": 17200,
      "text": "\"Ten days for witnesses to be gathered.\"",
      "line_number": 50,
      "duration_ms": 2100
    },
    {
      "block_id": "EP048_B011",
      "episode_id": "EP048",
      "file_index": 10,
      "scene_id": "EP048_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Dark, Threatening)",
      "speaker": "CATHERINE",
      "delivery": [
        "Dark",
        "Threatening"
      ],
      "offscreen": null,
      "start_raw": "00:17.40",
      "end_raw": "00:19.70",
      "start_ms": 17400,
      "end_ms": 19700,
      "text": "\"Ten days for a decree to be undone.\"",
      "line_number": 54,
      "duration_ms": 2300
    },
    {
      "block_id": "EP048_B012",
      "episode_id": "EP048",
      "file_index": 11,
      "scene_id": "EP048_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:20.00",
      "end_raw": "00:26.70",
      "start_ms": 20000,
      "end_ms": 26700,
      "text": "Slight push-in on Catherine as she clenches her fist against her chest, her eyes blazing with malice.",
      "line_number": 58,
      "duration_ms": 6700
    },
    {
      "block_id": "EP048_B013",
      "episode_id": "EP048",
      "file_index": 12,
      "scene_id": "EP048_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Menacing, Resolute)",
      "speaker": "CATHERINE",
      "delivery": [
        "Menacing",
        "Resolute"
      ],
      "offscreen": null,
      "start_raw": "00:20.10",
      "end_raw": "00:23.70",
      "start_ms": 20100,
      "end_ms": 23700,
      "text": "\"Ten days is not a wall, Alexander. It's a door.\"",
      "line_number": 62,
      "duration_ms": 3600
    },
    {
      "block_id": "EP048_B014",
      "episode_id": "EP048",
      "file_index": 13,
      "scene_id": "EP048_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Chillingly Calm)",
      "speaker": "CATHERINE",
      "delivery": [
        "Chillingly Calm"
      ],
      "offscreen": null,
      "start_raw": "00:23.90",
      "end_raw": "00:26.50",
      "start_ms": 23900,
      "end_ms": 26500,
      "text": "\"And doors can be closed from the other side.\"",
      "line_number": 66,
      "duration_ms": 2600
    },
    {
      "block_id": "EP048_B015",
      "episode_id": "EP048",
      "file_index": 14,
      "scene_id": "EP048_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:26.70",
      "end_raw": "00:30.80",
      "start_ms": 26700,
      "end_ms": 30800,
      "text": "Medium shot over Catherine's shoulder seated before her vanity mirror as the chamber door eases open and Agnes enters quietly.",
      "line_number": 77,
      "duration_ms": 4100
    },
    {
      "block_id": "EP048_B016",
      "episode_id": "EP048",
      "file_index": 15,
      "scene_id": "EP048_S02",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:26.80",
      "end_raw": "00:29.50",
      "start_ms": 26800,
      "end_ms": 29500,
      "text": "Agnes, dressed in a grey maid's dress and white apron, steps inside with cautious hesitation and clasps her hands.",
      "line_number": 81,
      "duration_ms": 2700
    },
    {
      "block_id": "EP048_B017",
      "episode_id": "EP048",
      "file_index": 16,
      "scene_id": "EP048_S02",
      "block_type": "DIALOGUE",
      "label_raw": "AGNES (Hushed, Submissive)",
      "speaker": "AGNES",
      "delivery": [
        "Hushed",
        "Submissive"
      ],
      "offscreen": null,
      "start_raw": "00:29.20",
      "end_raw": "00:30.80",
      "start_ms": 29200,
      "end_ms": 30800,
      "text": "\"You sent for me, my lady?\"",
      "line_number": 85,
      "duration_ms": 1600
    },
    {
      "block_id": "EP048_B018",
      "episode_id": "EP048",
      "file_index": 17,
      "scene_id": "EP048_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Commanding, Sharp)",
      "speaker": "CATHERINE",
      "delivery": [
        "Commanding",
        "Sharp"
      ],
      "offscreen": null,
      "start_raw": "00:30.90",
      "end_raw": "00:32.00",
      "start_ms": 30900,
      "end_ms": 32000,
      "text": "\"Lock it.\"",
      "line_number": 89,
      "duration_ms": 1100
    },
    {
      "block_id": "EP048_B019",
      "episode_id": "EP048",
      "file_index": 18,
      "scene_id": "EP048_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:32.00",
      "end_raw": "00:33.90",
      "start_ms": 32000,
      "end_ms": 33900,
      "text": "Close-up on Agnes's hands turning the ornate iron key in the wooden door's brass lock.",
      "line_number": 93,
      "duration_ms": 1900
    },
    {
      "block_id": "EP048_B020",
      "episode_id": "EP048",
      "file_index": 19,
      "scene_id": "EP048_S02",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:32.30",
      "end_raw": "00:33.80",
      "start_ms": 32300,
      "end_ms": 33800,
      "text": "Heavy metallic click of an iron key latching into a deadbolt.",
      "line_number": 97,
      "duration_ms": 1500
    },
    {
      "block_id": "EP048_B021",
      "episode_id": "EP048",
      "file_index": 20,
      "scene_id": "EP048_S02",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:34.00",
      "end_raw": "00:36.50",
      "start_ms": 34000,
      "end_ms": 36500,
      "text": "Catherine strides forward and firmly grasps Agnes by both hands, stepping uncomfortably close.",
      "line_number": 101,
      "duration_ms": 2500
    },
    {
      "block_id": "EP048_B022",
      "episode_id": "EP048",
      "file_index": 21,
      "scene_id": "EP048_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:34.00",
      "end_raw": "00:43.00",
      "start_ms": 34000,
      "end_ms": 43000,
      "text": "Two-shot profile of Catherine towering over Agnes in the candlelight.",
      "line_number": 105,
      "duration_ms": 9000
    },
    {
      "block_id": "EP048_B023",
      "episode_id": "EP048",
      "file_index": 22,
      "scene_id": "EP048_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Fierce, Hissing)",
      "speaker": "CATHERINE",
      "delivery": [
        "Fierce",
        "Hissing"
      ],
      "offscreen": null,
      "start_raw": "00:34.20",
      "end_raw": "00:37.10",
      "start_ms": 34200,
      "end_ms": 37100,
      "text": "\"Everyone in that chapel saw me humiliated today.\"",
      "line_number": 109,
      "duration_ms": 2900
    },
    {
      "block_id": "EP048_B024",
      "episode_id": "EP048",
      "file_index": 23,
      "scene_id": "EP048_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Spiteful, calculating)",
      "speaker": "CATHERINE",
      "delivery": [
        "Spiteful",
        "calculating"
      ],
      "offscreen": null,
      "start_raw": "00:37.30",
      "end_raw": "00:39.00",
      "start_ms": 37300,
      "end_ms": 39000,
      "text": "\"Good. Let them remember it.\"",
      "line_number": 113,
      "duration_ms": 1700
    },
    {
      "block_id": "EP048_B025",
      "episode_id": "EP048",
      "file_index": 24,
      "scene_id": "EP048_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Sinister, Predatory)",
      "speaker": "CATHERINE",
      "delivery": [
        "Sinister",
        "Predatory"
      ],
      "offscreen": null,
      "start_raw": "00:39.20",
      "end_raw": "00:43.00",
      "start_ms": 39200,
      "end_ms": 43000,
      "text": "\"Grief makes people careless, and carelessness is exactly what I need from that household right now.\"",
      "line_number": 117,
      "duration_ms": 3800
    },
    {
      "block_id": "EP048_B026",
      "episode_id": "EP048",
      "file_index": 25,
      "scene_id": "EP048_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:43.00",
      "end_raw": "00:46.80",
      "start_ms": 43000,
      "end_ms": 46800,
      "text": "Over-the-shoulder close-up on Agnes, her brow furrowed in anxious alarm.",
      "line_number": 121,
      "duration_ms": 3800
    },
    {
      "block_id": "EP048_B027",
      "episode_id": "EP048",
      "file_index": 26,
      "scene_id": "EP048_S02",
      "block_type": "DIALOGUE",
      "label_raw": "AGNES (Anxious, Whispering)",
      "speaker": "AGNES",
      "delivery": [
        "Anxious",
        "Whispering"
      ],
      "offscreen": null,
      "start_raw": "00:43.30",
      "end_raw": "00:46.80",
      "start_ms": 43300,
      "end_ms": 46800,
      "text": "\"My lady... the Duke has bailiffs watching every road out of the county.\"",
      "line_number": 125,
      "duration_ms": 3500
    },
    {
      "block_id": "EP048_B028",
      "episode_id": "EP048",
      "file_index": 27,
      "scene_id": "EP048_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:46.80",
      "end_raw": "00:51.50",
      "start_ms": 46800,
      "end_ms": 51500,
      "text": "Close-up on Catherine, a smug, venomous smile spreading across her painted lips.",
      "line_number": 129,
      "duration_ms": 4700
    },
    {
      "block_id": "EP048_B029",
      "episode_id": "EP048",
      "file_index": 28,
      "scene_id": "EP048_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Confident, Devious)",
      "speaker": "CATHERINE",
      "delivery": [
        "Confident",
        "Devious"
      ],
      "offscreen": null,
      "start_raw": "00:47.00",
      "end_raw": "00:51.30",
      "start_ms": 47000,
      "end_ms": 51300,
      "text": "\"I'm not leaving the county, Agnes. I'm going back into that house.\"",
      "line_number": 133,
      "duration_ms": 4300
    },
    {
      "block_id": "EP048_B030",
      "episode_id": "EP048",
      "file_index": 29,
      "scene_id": "EP048_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:51.50",
      "end_raw": "00:58.20",
      "start_ms": 51500,
      "end_ms": 58200,
      "text": "Medium tracking shot following Catherine as she releases Agnes and stalks across the room toward the window sill.",
      "line_number": 137,
      "duration_ms": 6700
    },
    {
      "block_id": "EP048_B031",
      "episode_id": "EP048",
      "file_index": 30,
      "scene_id": "EP048_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Pleased, Scheming)",
      "speaker": "CATHERINE",
      "delivery": [
        "Pleased",
        "Scheming"
      ],
      "offscreen": null,
      "start_raw": "00:52.00",
      "end_raw": "00:55.00",
      "start_ms": 52000,
      "end_ms": 55000,
      "text": "\"Father Thomas did his part beautifully today.\"",
      "line_number": 141,
      "duration_ms": 3000
    },
    {
      "block_id": "EP048_B032",
      "episode_id": "EP048",
      "file_index": 31,
      "scene_id": "EP048_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Calculated, Demanding)",
      "speaker": "CATHERINE",
      "delivery": [
        "Calculated",
        "Demanding"
      ],
      "offscreen": null,
      "start_raw": "00:55.20",
      "end_raw": "00:58.20",
      "start_ms": 55200,
      "end_ms": 58200,
      "text": "\"Now I need him to do a little more before that hearing convenes.\"",
      "line_number": 145,
      "duration_ms": 3000
    },
    {
      "block_id": "EP048_B033",
      "episode_id": "EP048",
      "file_index": 32,
      "scene_id": "EP048_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
