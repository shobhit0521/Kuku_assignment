      "start_ms": 0,
      "end_ms": 4600,
      "text": "Medium shot of the Constable raising a set of heavy iron handcuffs, addressing Alexander sternly in front of the stone hearth.",
      "line_number": 14,
      "duration_ms": 4600
    },
    {
      "block_id": "EP012_B002",
      "episode_id": "EP012",
      "file_index": 1,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CONSTABLE (Authoritative, Stern)",
      "speaker": "CONSTABLE",
      "delivery": [
        "Authoritative",
        "Stern"
      ],
      "offscreen": null,
      "start_raw": "00:00.50",
      "end_raw": "00:04.50",
      "start_ms": 500,
      "end_ms": 4500,
      "text": "\"Put out your hands, veteran. You are under arrest for theft.\"",
      "line_number": 18,
      "duration_ms": 4000
    },
    {
      "block_id": "EP012_B003",
      "episode_id": "EP012",
      "file_index": 2,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:04.60",
      "end_raw": "00:09.10",
      "start_ms": 4600,
      "end_ms": 9100,
      "text": "Medium shot of Juliana swiftly moving in front of Alexander, placing herself defiantly between him and the Constable's outstretched handcuffs.",
      "line_number": 22,
      "duration_ms": 4500
    },
    {
      "block_id": "EP012_B004",
      "episode_id": "EP012",
      "file_index": 3,
      "scene_id": "EP012_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:04.80",
      "end_raw": "00:06.00",
      "start_ms": 4800,
      "end_ms": 6000,
      "text": "Juliana steps firmly forward, shielding Alexander with her body.",
      "line_number": 26,
      "duration_ms": 1200
    },
    {
      "block_id": "EP012_B005",
      "episode_id": "EP012",
      "file_index": 4,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Furious, Defiant)",
      "speaker": "JULIANA",
      "delivery": [
        "Furious",
        "Defiant"
      ],
      "offscreen": null,
      "start_raw": "00:05.70",
      "end_raw": "00:08.80",
      "start_ms": 5700,
      "end_ms": 8800,
      "text": "\"No! That watch was not in his coat!\"",
      "line_number": 30,
      "duration_ms": 3100
    },
    {
      "block_id": "EP012_B006",
      "episode_id": "EP012",
      "file_index": 5,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:09.10",
      "end_raw": "00:11.80",
      "start_ms": 9100,
      "end_ms": 11800,
      "text": "Close-up of the Constable narrowing his eyes coldly at Juliana.",
      "line_number": 34,
      "duration_ms": 2700
    },
    {
      "block_id": "EP012_B007",
      "episode_id": "EP012",
      "file_index": 6,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CONSTABLE (Blunt, Unyielding)",
      "speaker": "CONSTABLE",
      "delivery": [
        "Blunt",
        "Unyielding"
      ],
      "offscreen": null,
      "start_raw": "00:10.00",
      "end_raw": "00:11.70",
      "start_ms": 10000,
      "end_ms": 11700,
      "text": "\"I found it there myself.\"",
      "line_number": 38,
      "duration_ms": 1700
    },
    {
      "block_id": "EP012_B008",
      "episode_id": "EP012",
      "file_index": 7,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:11.80",
      "end_raw": "00:13.90",
      "start_ms": 11800,
      "end_ms": 13900,
      "text": "Close-up of Juliana glaring back with unwavering conviction.",
      "line_number": 42,
      "duration_ms": 2100
    },
    {
      "block_id": "EP012_B009",
      "episode_id": "EP012",
      "file_index": 8,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Passionate, Accusatory)",
      "speaker": "JULIANA",
      "delivery": [
        "Passionate",
        "Accusatory"
      ],
      "offscreen": null,
      "start_raw": "00:12.30",
      "end_raw": "00:13.90",
      "start_ms": 12300,
      "end_ms": 13900,
      "text": "\"Then someone put it there!\"",
      "line_number": 46,
      "duration_ms": 1600
    },
    {
      "block_id": "EP012_B010",
      "episode_id": "EP012",
      "file_index": 9,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:13.90",
      "end_raw": "00:20.80",
      "start_ms": 13900,
      "end_ms": 20800,
      "text": "Medium full shot of Gerald framed in the open cottage doorway holding his riding crop, stepping inside with a patronizing, gloating grin.",
      "line_number": 50,
      "duration_ms": 6900
    },
    {
      "block_id": "EP012_B011",
      "episode_id": "EP012",
      "file_index": 10,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "GERALD (Smug, Condescending)",
      "speaker": "GERALD",
      "delivery": [
        "Smug",
        "Condescending"
      ],
      "offscreen": null,
      "start_raw": "00:14.30",
      "end_raw": "00:20.60",
      "start_ms": 14300,
      "end_ms": 20600,
      "text": "\"The proof is in his coat, Juliana. A valuable pocket watch doesn't just walk into a beggar's pocket.\"",
      "line_number": 54,
      "duration_ms": 6300
    },
    {
      "block_id": "EP012_B012",
      "episode_id": "EP012",
      "file_index": 11,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:20.80",
      "end_raw": "00:23.70",
      "start_ms": 20800,
      "end_ms": 23700,
      "text": "Close-up of Alexander, his scarred brow furrowed in dark, quiet defiance.",
      "line_number": 58,
      "duration_ms": 2900
    },
    {
      "block_id": "EP012_B013",
      "episode_id": "EP012",
      "file_index": 12,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Low, Steady, Dangerous)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Low",
        "Steady",
        "Dangerous"
      ],
      "offscreen": null,
      "start_raw": "00:21.60",
      "end_raw": "00:23.60",
      "start_ms": 21600,
      "end_ms": 23600,
      "text": "\"I have never touched your property.\"",
      "line_number": 62,
      "duration_ms": 2000
    },
    {
      "block_id": "EP012_B014",
      "episode_id": "EP012",
      "file_index": 13,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:23.70",
      "end_raw": "00:26.90",
      "start_ms": 23700,
      "end_ms": 26900,
      "text": "Medium shot of Gerald pointing his riding crop toward them, with Clarissa hovering behind him in her violet silk gown.",
      "line_number": 66,
      "duration_ms": 3200
    },
    {
      "block_id": "EP012_B015",
      "episode_id": "EP012",
      "file_index": 14,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "GERALD (Mocking, Malicious)",
      "speaker": "GERALD",
      "delivery": [
        "Mocking",
        "Malicious"
      ],
      "offscreen": null,
      "start_raw": "00:23.70",
      "end_raw": "00:26.80",
      "start_ms": 23700,
      "end_ms": 26800,
      "text": "\"Then perhaps your wife should explain why it was found in your coat.\"",
      "line_number": 70,
      "duration_ms": 3100
    },
    {
      "block_id": "EP012_B016",
      "episode_id": "EP012",
      "file_index": 15,
      "scene_id": "EP012_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:26.80",
      "end_raw": "00:28.00",
      "start_ms": 26800,
      "end_ms": 28000,
      "text": "Juliana lunges a step forward, jabbing an accusing finger toward Gerald.",
      "line_number": 74,
      "duration_ms": 1200
    },
    {
      "block_id": "EP012_B017",
      "episode_id": "EP012",
      "file_index": 16,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Enraged, Shouting)",
      "speaker": "JULIANA",
      "delivery": [
        "Enraged",
        "Shouting"
      ],
      "offscreen": null,
      "start_raw": "00:26.80",
      "end_raw": "00:27.90",
      "start_ms": 26800,
      "end_ms": 27900,
      "text": "\"You planted it!\"",
      "line_number": 78,
      "duration_ms": 1100
    },
    {
      "block_id": "EP012_B018",
      "episode_id": "EP012",
      "file_index": 17,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:28.00",
      "end_raw": "00:29.80",
      "start_ms": 28000,
      "end_ms": 29800,
      "text": "Medium shot of Clarissa gliding past Gerald, a venomous, amused smile playing upon her lips.",
      "line_number": 82,
      "duration_ms": 1800
    },
    {
      "block_id": "EP012_B019",
      "episode_id": "EP012",
      "file_index": 18,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CLARISSA (Purring, Taunting)",
      "speaker": "CLARISSA",
      "delivery": [
        "Purring",
        "Taunting"
      ],
      "offscreen": null,
      "start_raw": "00:28.10",
      "end_raw": "00:30.00",
      "start_ms": 28100,
      "end_ms": 30000,
      "text": "\"Oh, dear sister...\"",
      "line_number": 86,
      "duration_ms": 1900
    },
    {
      "block_id": "EP012_B020",
      "episode_id": "EP012",
      "file_index": 19,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:29.80",
      "end_raw": "00:31.00",
      "start_ms": 29800,
      "end_ms": 31000,
      "text": "Tight shot of Alexander's hand clenching into a tight, trembling fist against the glow of the roaring fireplace.",
      "line_number": 90,
      "duration_ms": 1200
    },
    {
      "block_id": "EP012_B021",
      "episode_id": "EP012",
      "file_index": 20,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:31.00",
      "end_raw": "00:32.40",
      "start_ms": 31000,
      "end_ms": 32400,
      "text": "Close-up of Alexander glaring daggers at Clarissa.",
      "line_number": 94,
      "duration_ms": 1400
    },
    {
      "block_id": "EP012_B022",
      "episode_id": "EP012",
      "file_index": 21,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CLARISSA (O.S.) (Continuing taunt)",
      "speaker": "CLARISSA",
      "delivery": [
        "Continuing taunt"
      ],
      "offscreen": "O.S.",
      "start_raw": "00:30.00",
      "end_raw": "00:32.40",
      "start_ms": 30000,
      "end_ms": 32400,
      "text": "\"...still defending your broken scrap of a man?\"",
      "line_number": 98,
      "duration_ms": 2400
    },
    {
      "block_id": "EP012_B023",
      "episode_id": "EP012",
      "file_index": 22,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:32.40",
      "end_raw": "00:35.30",
      "start_ms": 32400,
      "end_ms": 35300,
      "text": "Medium close-up of Juliana, her eyes narrowing with sharp perception.",
      "line_number": 102,
      "duration_ms": 2900
    },
    {
      "block_id": "EP012_B024",
      "episode_id": "EP012",
      "file_index": 23,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Steely, Resolute)",
      "speaker": "JULIANA",
      "delivery": [
        "Steely",
        "Resolute"
      ],
      "offscreen": null,
      "start_raw": "00:32.40",
      "end_raw": "00:35.20",
      "start_ms": 32400,
      "end_ms": 35200,
      "text": "\"Name your price, Clarissa. I know you.\"",
      "line_number": 106,
      "duration_ms": 2800
    },
    {
      "block_id": "EP012_B025",
      "episode_id": "EP012",
      "file_index": 24,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:35.30",
      "end_raw": "00:40.00",
      "start_ms": 35300,
      "end_ms": 40000,
      "text": "Medium close-up of Clarissa smiling with vicious delight.",
      "line_number": 110,
      "duration_ms": 4700
    },
    {
      "block_id": "EP012_B026",
      "episode_id": "EP012",
      "file_index": 25,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CLARISSA (Smooth, Derisive)",
      "speaker": "CLARISSA",
      "delivery": [
        "Smooth",
        "Derisive"
      ],
      "offscreen": null,
      "start_raw": "00:35.40",
      "end_raw": "00:40.00",
      "start_ms": 35400,
      "end_ms": 40000,
      "text": "\"You always were clever, Juliana. Always searching for some way to escape.\"",
      "line_number": 114,
      "duration_ms": 4600
    },
    {
      "block_id": "EP012_B027",
      "episode_id": "EP012",
      "file_index": 26,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:40.00",
      "end_raw": "00:41.80",
      "start_ms": 40000,
      "end_ms": 41800,
      "text": "Tight shot of Clarissa smoothing her long purple evening glove along her wrist.",
      "line_number": 118,
      "duration_ms": 1800
    },
    {
      "block_id": "EP012_B028",
      "episode_id": "EP012",
      "file_index": 27,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CLARISSA (Scheming)",
      "speaker": "CLARISSA",
      "delivery": [
        "Scheming"
      ],
      "offscreen": null,
      "start_raw": "00:40.10",
      "end_raw": "00:41.50",
      "start_ms": 40100,
      "end_ms": 41500,
      "text": "\"Perhaps I can give you one.\"",
      "line_number": 122,
      "duration_ms": 1400
    },
    {
      "block_id": "EP012_B029",
      "episode_id": "EP012",
      "file_index": 28,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:41.80",
      "end_raw": "00:43.70",
      "start_ms": 41800,
      "end_ms": 43700,
      "text": "Close-up of Juliana watching her with cautious skepticism.",
      "line_number": 126,
      "duration_ms": 1900
    },
    {
      "block_id": "EP012_B030",
      "episode_id": "EP012",
      "file_index": 29,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Guarded, Cold)",
      "speaker": "JULIANA",
      "delivery": [
        "Guarded",
        "Cold"
      ],
      "offscreen": null,
      "start_raw": "00:42.20",
      "end_raw": "00:43.50",
      "start_ms": 42200,
      "end_ms": 43500,
      "text": "\"What do you want?\"",
      "line_number": 130,
      "duration_ms": 1300
    },
    {
      "block_id": "EP012_B031",
      "episode_id": "EP012",
      "file_index": 30,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:43.70",
      "end_raw": "00:46.60",
      "start_ms": 43700,
      "end_ms": 46600,
      "text": "Medium two-shot of Clarissa in the foreground, turning slowly to face Juliana.",
      "line_number": 134,
      "duration_ms": 2900
    },
    {
      "block_id": "EP012_B032",
      "episode_id": "EP012",
      "file_index": 31,
      "scene_id": "EP012_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CLARISSA (Cruel, Savoring)",
      "speaker": "CLARISSA",
      "delivery": [
        "Cruel",
        "Savoring"
      ],
      "offscreen": null,
      "start_raw": "00:44.00",
      "end_raw": "00:46.40",
      "start_ms": 44000,
      "end_ms": 46400,
      "text": "\"I want to see you crawl, sister.\"",
      "line_number": 138,
      "duration_ms": 2400
    },
    {
      "block_id": "EP012_B033",
      "episode_id": "EP012",
      "file_index": 32,
      "scene_id": "EP012_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:46.60",
      "end_raw": "00:52.40",
      "start_ms": 46600,
      "end_ms": 52400,
      "text": "Medium close-up profile tracking shot of Clarissa pacing slowly as she spins her sadistic tale.",
