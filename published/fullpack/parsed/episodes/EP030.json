      "end_ms": 136800,
      "text": "Medium shot of Rupert pulling out the desk chair and seating himself with dark resolve.",
      "line_number": 273,
      "duration_ms": 3300
    },
    {
      "block_id": "EP030_B065",
      "episode_id": "EP030",
