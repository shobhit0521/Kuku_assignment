      "offscreen": null,
      "start_raw": "02:14.10",
      "end_raw": "02:16.20",
      "start_ms": 134100,
      "end_ms": 136200,
      "text": "\"I will write the arrest warrant myself.\"",
      "line_number": 277,
      "duration_ms": 2100
    },
    {
      "block_id": "EP030_B066",
