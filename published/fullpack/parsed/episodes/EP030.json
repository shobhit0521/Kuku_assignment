      "start_raw": "02:00.00",
      "end_raw": "02:01.50",
      "start_ms": 120000,
      "end_ms": 121500,
      "text": "\"And Juliana?\"",
      "line_number": 253,
      "duration_ms": 1500
    },
    {
      "block_id": "EP030_B060",
      "episode_id": "EP030",
