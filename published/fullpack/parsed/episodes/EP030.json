      "block_type": "DIALOGUE",
      "label_raw": "ELDER NOBLEMAN (Unflinching)",
      "speaker": "ELDER NOBLEMAN",
      "delivery": [
        "Unflinching"
      ],
      "offscreen": null,
      "start_raw": "01:32.00",
      "end_raw": "01:33.40",
      "start_ms": 92000,
      "end_ms": 93400,
      "text": "\"Precisely.\"",
      "line_number": 205,
      "duration_ms": 1400
    },
    {
      "block_id": "EP030_B048",
      "episode_id": "EP030",
      "file_index": 47,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:34.50",
      "end_raw": "01:41.90",
      "start_ms": 94500,
      "end_ms": 101900,
      "text": "Medium three-shot framing Rupert, the Elder Nobleman between them, and Catherine listening closely.",
      "line_number": 209,
      "duration_ms": 7400
    },
    {
      "block_id": "EP030_B049",
      "episode_id": "EP030",
      "file_index": 48,
      "scene_id": "EP030_S02",
      "block_type": "DIALOGUE",
      "label_raw": "ELDER NOBLEMAN (Authoritative, Command)",
