      "start_raw": "01:25.80",
      "end_raw": "01:27.80",
      "start_ms": 85800,
      "end_ms": 87800,
      "text": "\"Then call it witchcraft.\"",
      "line_number": 189,
      "duration_ms": 2000
    },
    {
      "block_id": "EP030_B044",
      "episode_id": "EP030",
      "file_index": 43,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
