      "start_raw": "01:14.80",
      "end_raw": "01:22.80",
      "start_ms": 74800,
      "end_ms": 82800,
      "text": "Medium shot framing the Elder Nobleman seated at the desk beside Catherine standing in the firelight.",
      "line_number": 169,
      "duration_ms": 8000
    },
    {
      "block_id": "EP030_B039",
      "episode_id": "EP030",
      "file_index": 38,
      "scene_id": "EP030_S02",
      "block_type": "DIALOGUE",
      "label_raw": "ELDER NOBLEMAN (Cold, Calculating)",
      "speaker": "ELDER NOBLEMAN",
