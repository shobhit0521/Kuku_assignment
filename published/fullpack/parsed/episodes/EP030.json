      "start_raw": "01:15.00",
      "end_raw": "01:22.50",
      "start_ms": 75000,
      "end_ms": 82500,
      "text": "\"Give those facts to a magistrate in the right order, and she becomes a poisoner.\"",
      "line_number": 173,
      "duration_ms": 7500
    },
    {
      "block_id": "EP030_B040",
      "episode_id": "EP030",
      "file_index": 39,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:22.80",
      "end_raw": "01:25.60",
      "start_ms": 82800,
      "end_ms": 85600,
      "text": "Medium close-up of Catherine gently moving her fan, raising an intrigued brow.",
      "line_number": 177,
      "duration_ms": 2800
    },
    {
      "block_id": "EP030_B041",
      "episode_id": "EP030",
      "file_index": 40,
      "scene_id": "EP030_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Curious, Conniving)",
      "speaker": "CATHERINE",
      "delivery": [
        "Curious",
