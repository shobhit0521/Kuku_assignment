      "start_raw": "01:49.50",
      "end_raw": "01:56.50",
      "start_ms": 109500,
      "end_ms": 116500,
      "text": "\"She is weak, confused. No magistrate will trust a dying woman's accusations against a respected household.\"",
      "line_number": 245,
      "duration_ms": 7000
    },
    {
      "block_id": "EP030_B058",
      "episode_id": "EP030",
      "file_index": 57,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:56.80",
      "end_raw": "02:01.90",
      "start_ms": 116800,
      "end_ms": 121900,
      "text": "Medium close-up of Rupert exhaling deeply, processing the horrifying certainty of their conspiracy.",
      "line_number": 249,
      "duration_ms": 5100
    },
    {
      "block_id": "EP030_B059",
      "episode_id": "EP030",
      "file_index": 58,
      "scene_id": "EP030_S02",
      "block_type": "DIALOGUE",
      "label_raw": "RUPERT (Hesitant)",
