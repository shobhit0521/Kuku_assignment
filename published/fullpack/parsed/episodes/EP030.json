      "start_raw": "01:29.00",
      "end_raw": "01:31.30",
      "start_ms": 89000,
      "end_ms": 91300,
      "text": "\"Witchcraft is a capital charge.\"",
      "line_number": 197,
      "duration_ms": 2300
    },
    {
      "block_id": "EP030_B046",
      "episode_id": "EP030",
      "file_index": 45,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:31.80",
      "end_raw": "01:34.50",
      "start_ms": 91800,
      "end_ms": 94500,
      "text": "Straight-on close-up of the Elder Nobleman staring back without a flicker of remorse.",
