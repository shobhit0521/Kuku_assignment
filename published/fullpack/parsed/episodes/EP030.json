      "start_raw": "02:16.80",
      "end_raw": "02:24.50",
      "start_ms": 136800,
      "end_ms": 144500,
      "text": "Extreme close-up of the Elder Nobleman's weathered face, his eyes cold and predatory in the firelight.",
      "line_number": 281,
      "duration_ms": 7700
    },
    {
      "block_id": "EP030_B067",
      "episode_id": "EP030",
      "file_index": 66,
      "scene_id": "EP030_S02",
      "block_type": "DIALOGUE",
      "label_raw": "ELDER NOBLEMAN (Chilling, Decisive)",
      "speaker": "ELDER NOBLEMAN",
      "delivery": [
        "Chilling",
        "Decisive"
      ],
      "offscreen": null,
      "start_raw": "02:17.50",
      "end_raw": "02:23.50",
      "start_ms": 137500,
      "end_ms": 143500,
      "text": "\"Tomorrow, she stops being a prisoner. She becomes a witch.\"",
      "line_number": 285,
      "duration_ms": 6000
    },
    {
      "block_id": "EP030_B068",
      "episode_id": "EP030",
      "file_index": 67,
      "scene_id": "EP030_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
