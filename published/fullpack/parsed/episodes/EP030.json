      "start_raw": "02:02.40",
      "end_raw": "02:04.90",
      "start_ms": 122400,
      "end_ms": 124900,
      "text": "\"She goes before the magistrate tomorrow.\"",
      "line_number": 261,
      "duration_ms": 2500
    },
    {
      "block_id": "EP030_B062",
      "episode_id": "EP030",
      "file_index": 61,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "02:05.10",
      "end_raw": "02:13.50",
      "start_ms": 125100,
      "end_ms": 133500,
      "text": "Close-up of Catherine beaming with venomous glee, spreading her red fan wide.",
      "line_number": 265,
      "duration_ms": 8400
    },
    {
      "block_id": "EP030_B063",
      "episode_id": "EP030",
      "file_index": 62,
      "scene_id": "EP030_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Cruel, Exultant)",
      "speaker": "CATHERINE",
      "delivery": [
        "Cruel",
        "Exultant"
      ],
      "offscreen": null,
      "start_raw": "02:05.50",
      "end_raw": "02:13.00",
      "start_ms": 125500,
      "end_ms": 133000,
      "text": "\"She will hang. A perfect solution. The town will cheer as the witch's disgraced daughter faces the noose.\"",
      "line_number": 269,
      "duration_ms": 7500
    },
    {
      "block_id": "EP030_B064",
      "episode_id": "EP030",
      "file_index": 63,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
