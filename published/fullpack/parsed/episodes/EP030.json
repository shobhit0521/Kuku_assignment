      "end_raw": "01:31.80",
      "start_ms": 88500,
      "end_ms": 91800,
      "text": "Close-up of Rupert wide-eyed with shock at the severity of the plan.",
      "line_number": 193,
      "duration_ms": 3300
    },
    {
      "block_id": "EP030_B045",
      "episode_id": "EP030",
      "file_index": 44,
      "scene_id": "EP030_S02",
      "block_type": "DIALOGUE",
