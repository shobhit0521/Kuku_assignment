      "start_raw": "01:34.60",
      "end_raw": "01:41.80",
      "start_ms": 94600,
      "end_ms": 101800,
      "text": "\"Do not hide the evidence, manufacture it. Drag her before the magistrate tomorrow, frame the trial, buy the jury, and let the State hang her.\"",
      "line_number": 213,
      "duration_ms": 7200
    },
    {
