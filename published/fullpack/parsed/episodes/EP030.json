      "start_raw": "01:10.80",
      "end_raw": "01:13.20",
      "start_ms": 70800,
      "end_ms": 73200,
      "text": "The Elder Nobleman leans both hands against the desk, leaning forward intently.",
      "line_number": 161,
      "duration_ms": 2400
    },
    {
      "block_id": "EP030_B037",
      "episode_id": "EP030",
