  "blocks": [
    {
      "block_id": "EP030_B001",
      "episode_id": "EP030",
      "file_index": 0,
      "scene_id": "EP030_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:05.20",
      "start_ms": 0,
      "end_ms": 5200,
      "text": "Low-angle tracking shot following polished black dress shoes and the tip of a gold-handled cane striding deliberately along a sunlit marble hallway, tilting up gradually to reveal an austere, grey-haired elder nobleman.",
      "line_number": 14,
      "duration_ms": 5200
    },
    {
      "block_id": "EP030_B002",
      "episode_id": "EP030",
      "file_index": 1,
      "scene_id": "EP030_S01",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:04.50",
      "start_ms": 0,
      "end_ms": 4500,
      "text": "Rhythmic, heavy footsteps and the sharp metallic click of a cane striking the polished stone floor.",
      "line_number": 18,
      "duration_ms": 4500
    },
    {
      "block_id": "EP030_B003",
      "episode_id": "EP030",
      "file_index": 2,
      "scene_id": "EP030_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:03.00",
      "end_raw": "00:05.50",
      "start_ms": 3000,
      "end_ms": 5500,
      "text": "The Elder Nobleman walks with stern, unhurried authority, dressed in an immaculate black tailcoat and dark vest with a gold pocket watch chain.",
      "line_number": 22,
      "duration_ms": 2500
    },
    {
      "block_id": "EP030_B004",
      "episode_id": "EP030",
      "file_index": 3,
      "scene_id": "EP030_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:05.20",
      "end_raw": "00:07.50",
      "start_ms": 5200,
      "end_ms": 7500,
      "text": "Medium close-up of Rupert standing nervously beside ornate double doors, wearing black gloves and an embroidered dark coat, glancing up with anxiety.",
      "line_number": 26,
      "duration_ms": 2300
    },
    {
      "block_id": "EP030_B005",
      "episode_id": "EP030",
      "file_index": 4,
      "scene_id": "EP030_S01",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:06.80",
      "end_raw": "00:07.90",
      "start_ms": 6800,
      "end_ms": 7900,
      "text": "A firm tap of the wooden walking stick halting against the floor.",
      "line_number": 30,
      "duration_ms": 1100
    },
    {
      "block_id": "EP030_B006",
      "episode_id": "EP030",
      "file_index": 5,
      "scene_id": "EP030_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:07.50",
      "end_raw": "00:13.50",
      "start_ms": 7500,
      "end_ms": 13500,
      "text": "Two-shot profile of the Elder Nobleman facing Rupert in the vaulted corridor.",
      "line_number": 34,
      "duration_ms": 6000
    },
    {
      "block_id": "EP030_B007",
      "episode_id": "EP030",
      "file_index": 6,
      "scene_id": "EP030_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ELDER NOBLEMAN (Cold, Accusatory)",
      "speaker": "ELDER NOBLEMAN",
      "delivery": [
        "Cold",
        "Accusatory"
      ],
      "offscreen": null,
      "start_raw": "00:08.80",
      "end_raw": "00:13.30",
      "start_ms": 8800,
      "end_ms": 13300,
      "text": "\"You have a rat in your cellar, Rupert. And the servants are beginning to smell it.\"",
      "line_number": 38,
      "duration_ms": 4500
    },
    {
      "block_id": "EP030_B008",
      "episode_id": "EP030",
      "file_index": 7,
      "scene_id": "EP030_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:13.50",
      "end_raw": "00:16.90",
      "start_ms": 13500,
      "end_ms": 16900,
      "text": "Close-up of Rupert defensive and agitated.",
      "line_number": 42,
      "duration_ms": 3400
    },
    {
      "block_id": "EP030_B009",
      "episode_id": "EP030",
      "file_index": 8,
      "scene_id": "EP030_S01",
      "block_type": "DIALOGUE",
      "label_raw": "RUPERT (Defensive, Anxious)",
      "speaker": "RUPERT",
      "delivery": [
        "Defensive",
        "Anxious"
      ],
      "offscreen": null,
      "start_raw": "00:13.60",
      "end_raw": "00:16.80",
      "start_ms": 13600,
      "end_ms": 16800,
      "text": "\"The Ashcroft girl is locked tight. Nobody knows she is down there.\"",
      "line_number": 46,
      "duration_ms": 3200
    },
    {
      "block_id": "EP030_B010",
      "episode_id": "EP030",
      "file_index": 9,
      "scene_id": "EP030_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:16.90",
      "end_raw": "00:26.00",
      "start_ms": 16900,
      "end_ms": 26000,
      "text": "Medium close-up of the Elder Nobleman fixing Rupert with a piercing, contemptuous glare.",
      "line_number": 50,
      "duration_ms": 9100
    },
    {
      "block_id": "EP030_B011",
      "episode_id": "EP030",
      "file_index": 10,
      "scene_id": "EP030_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ELDER NOBLEMAN (Stern, Disapproving)",
      "speaker": "ELDER NOBLEMAN",
      "delivery": [
        "Stern",
        "Disapproving"
      ],
      "offscreen": null,
      "start_raw": "00:17.30",
      "end_raw": "00:25.80",
      "start_ms": 17300,
      "end_ms": 25800,
      "text": "\"The kitchen maids are whispering. They see the soup bowls returned unwiped. They see your guards outside the lower grates.\"",
      "line_number": 54,
      "duration_ms": 8500
    },
    {
      "block_id": "EP030_B012",
      "episode_id": "EP030",
      "file_index": 11,
      "scene_id": "EP030_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:26.00",
      "end_raw": "00:29.80",
      "start_ms": 26000,
      "end_ms": 29800,
      "text": "Medium shot of Rupert looking down, nervously pulling at his black leather gloves as dread creeps over his face.",
      "line_number": 58,
      "duration_ms": 3800
    },
    {
      "block_id": "EP030_B013",
      "episode_id": "EP030",
      "file_index": 12,
      "scene_id": "EP030_S01",
      "block_type": "DIALOGUE",
      "label_raw": "RUPERT (Muttered, Paranoid)",
      "speaker": "RUPERT",
      "delivery": [
        "Muttered",
        "Paranoid"
      ],
      "offscreen": null,
      "start_raw": "00:26.50",
      "end_raw": "00:29.20",
      "start_ms": 26500,
      "end_ms": 29200,
      "text": "\"She knows the Duchess was poisoned.\"",
      "line_number": 62,
      "duration_ms": 2700
    },
    {
      "block_id": "EP030_B014",
      "episode_id": "EP030",
      "file_index": 13,
      "scene_id": "EP030_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:29.80",
      "end_raw": "00:32.00",
      "start_ms": 29800,
      "end_ms": 32000,
      "text": "Tight close-up on the Elder Nobleman's unyielding eyes narrowing in cold calculation.",
      "line_number": 66,
      "duration_ms": 2200
    },
    {
      "block_id": "EP030_B015",
      "episode_id": "EP030",
      "file_index": 14,
      "scene_id": "EP030_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:32.00",
      "end_raw": "00:33.40",
      "start_ms": 32000,
      "end_ms": 33400,
      "text": "Tight close-up of Rupert swallows hard, breathless with dread.",
      "line_number": 70,
      "duration_ms": 1400
    },
    {
      "block_id": "EP030_B016",
      "episode_id": "EP030",
      "file_index": 15,
      "scene_id": "EP030_S01",
      "block_type": "DIALOGUE",
      "label_raw": "RUPERT (Fearful)",
      "speaker": "RUPERT",
      "delivery": [
        "Fearful"
      ],
      "offscreen": null,
      "start_raw": "00:32.10",
      "end_raw": "00:33.30",
      "start_ms": 32100,
      "end_ms": 33300,
      "text": "\"If she speaks...\"",
      "line_number": 74,
      "duration_ms": 1200
    },
    {
      "block_id": "EP030_B017",
      "episode_id": "EP030",
      "file_index": 16,
      "scene_id": "EP030_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:33.40",
      "end_raw": "00:39.80",
      "start_ms": 33400,
      "end_ms": 39800,
      "text": "Medium two-shot as the Elder Nobleman lunges forward aggressively, stepping into Rupert's personal space.",
      "line_number": 78,
      "duration_ms": 6400
    },
    {
      "block_id": "EP030_B018",
      "episode_id": "EP030",
      "file_index": 17,
      "scene_id": "EP030_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:33.40",
      "end_raw": "00:35.20",
      "start_ms": 33400,
      "end_ms": 35200,
      "text": "The Elder Nobleman thrusts the gold knob of his walking stick directly against Rupert's chest, pinning him against the wall.",
      "line_number": 82,
      "duration_ms": 1800
    },
    {
      "block_id": "EP030_B019",
      "episode_id": "EP030",
      "file_index": 18,
      "scene_id": "EP030_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ELDER NOBLEMAN (Fierce, Venomous)",
      "speaker": "ELDER NOBLEMAN",
      "delivery": [
        "Fierce",
        "Venomous"
      ],
      "offscreen": null,
      "start_raw": "00:33.60",
      "end_raw": "00:39.80",
      "start_ms": 33600,
      "end_ms": 39800,
      "text": "\"Then make certain she isn't! A peasant weed, Rupert! You do not store weeds in your cellar, you burn them!\"",
      "line_number": 86,
      "duration_ms": 6200
    },
    {
      "block_id": "EP030_B020",
      "episode_id": "EP030",
      "file_index": 19,
      "scene_id": "EP030_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:39.80",
      "end_raw": "00:43.80",
      "start_ms": 39800,
      "end_ms": 43800,
      "text": "Low-angle close-up of Rupert gasping softly, intimidated by the cane pressed firmly beneath his cravat.",
      "line_number": 90,
      "duration_ms": 4000
    },
    {
      "block_id": "EP030_B021",
      "episode_id": "EP030",
      "file_index": 20,
      "scene_id": "EP030_S01",
      "block_type": "DIALOGUE",
      "label_raw": "RUPERT (Faltering, Submissive)",
      "speaker": "RUPERT",
      "delivery": [
        "Faltering",
        "Submissive"
      ],
      "offscreen": null,
      "start_raw": "00:41.80",
      "end_raw": "00:43.50",
      "start_ms": 41800,
      "end_ms": 43500,
      "text": "\"What are you suggesting?\"",
      "line_number": 94,
      "duration_ms": 1700
    },
    {
      "block_id": "EP030_B022",
      "episode_id": "EP030",
      "file_index": 21,
      "scene_id": "EP030_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:43.80",
      "end_raw": "00:47.60",
      "start_ms": 43800,
      "end_ms": 47600,
      "text": "Medium shot as the Elder Nobleman withdraws his cane and turns sharply toward the library doors.",
      "line_number": 98,
      "duration_ms": 3800
    },
    {
      "block_id": "EP030_B023",
      "episode_id": "EP030",
      "file_index": 22,
      "scene_id": "EP030_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ELDER NOBLEMAN (Calculated, Ominous)",
      "speaker": "ELDER NOBLEMAN",
      "delivery": [
        "Calculated",
        "Ominous"
      ],
      "offscreen": null,
      "start_raw": "00:44.80",
      "end_raw": "00:47.30",
      "start_ms": 44800,
      "end_ms": 47300,
      "text": "\"We stop hiding the prisoner.\"",
      "line_number": 102,
      "duration_ms": 2500
    },
    {
      "block_id": "EP030_B024",
      "episode_id": "EP030",
      "file_index": 23,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:47.60",
      "end_raw": "00:51.00",
      "start_ms": 47600,
      "end_ms": 51000,
      "text": "Tracking shot from behind the Elder Nobleman as he pushes open the heavy double doors into the dark wood-paneled library.",
      "line_number": 113,
      "duration_ms": 3400
    },
    {
      "block_id": "EP030_B025",
      "episode_id": "EP030",
      "file_index": 24,
      "scene_id": "EP030_S02",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:48.00",
      "end_raw": "00:50.50",
      "start_ms": 48000,
      "end_ms": 50500,
      "text": "The heavy creak of massive mahogany doors gliding open on brass hinges.",
      "line_number": 117,
      "duration_ms": 2500
    },
    {
      "block_id": "EP030_B026",
      "episode_id": "EP030",
      "file_index": 25,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:51.00",
      "end_raw": "00:54.60",
      "start_ms": 51000,
      "end_ms": 54600,
      "text": "Front medium shot of the Elder Nobleman pausing inside the library doorway, Rupert following behind him.",
      "line_number": 121,
      "duration_ms": 3600
    },
    {
      "block_id": "EP030_B027",
      "episode_id": "EP030",
      "file_index": 26,
      "scene_id": "EP030_S02",
      "block_type": "DIALOGUE",
      "label_raw": "ELDER NOBLEMAN (Deadpan, Sinister)",
      "speaker": "ELDER NOBLEMAN",
      "delivery": [
        "Deadpan",
        "Sinister"
      ],
      "offscreen": null,
      "start_raw": "00:51.20",
      "end_raw": "00:54.00",
      "start_ms": 51200,
      "end_ms": 54000,
      "text": "\"We give them a reason to condemn her.\"",
      "line_number": 125,
      "duration_ms": 2800
    },
    {
      "block_id": "EP030_B028",
      "episode_id": "EP030",
      "file_index": 27,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:54.60",
      "end_raw": "00:58.80",
      "start_ms": 54600,
      "end_ms": 58800,
      "text": "Wide shot of Catherine standing regally before the roaring stone hearth, dressed in an ornate burgundy and gold brocade gown, slowly unfurling a red lace fan.",
      "line_number": 129,
      "duration_ms": 4200
    },
    {
      "block_id": "EP030_B029",
      "episode_id": "EP030",
      "file_index": 28,
      "scene_id": "EP030_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Inquiring, Sharp)",
      "speaker": "CATHERINE",
      "delivery": [
        "Inquiring",
        "Sharp"
      ],
      "offscreen": null,
      "start_raw": "00:57.00",
      "end_raw": "00:58.80",
      "start_ms": 57000,
      "end_ms": 58800,
      "text": "\"You have a solution?\"",
      "line_number": 133,
      "duration_ms": 1800
    },
    {
      "block_id": "EP030_B030",
      "episode_id": "EP030",
      "file_index": 29,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:58.80",
      "end_raw": "01:02.80",
      "start_ms": 58800,
      "end_ms": 62800,
      "text": "Side profile close-up of the Elder Nobleman speaking with icy confidence.",
      "line_number": 137,
      "duration_ms": 4000
    },
    {
      "block_id": "EP030_B031",
      "episode_id": "EP030",
      "file_index": 30,
      "scene_id": "EP030_S02",
      "block_type": "DIALOGUE",
      "label_raw": "ELDER NOBLEMAN (Ruthless)",
      "speaker": "ELDER NOBLEMAN",
      "delivery": [
        "Ruthless"
      ],
      "offscreen": null,
      "start_raw": "00:59.40",
      "end_raw": "01:02.50",
      "start_ms": 59400,
      "end_ms": 62500,
