      "start_raw": "01:46.60",
      "end_raw": "01:49.00",
      "start_ms": 106600,
      "end_ms": 109000,
      "text": "Close-up of Catherine leaning slightly forward.",
      "line_number": 233,
      "duration_ms": 2400
    },
