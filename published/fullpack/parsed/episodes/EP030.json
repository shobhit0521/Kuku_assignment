      "end_raw": "01:28.50",
      "start_ms": 85600,
      "end_ms": 88500,
      "text": "Tight close-up of the Elder Nobleman's face illuminated by warm firelight.",
      "line_number": 185,
      "duration_ms": 2900
    },
    {
      "block_id": "EP030_B043",
      "episode_id": "EP030",
