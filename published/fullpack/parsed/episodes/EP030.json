      "end_raw": "01:14.80",
      "start_ms": 73500,
      "end_ms": 74800,
      "text": "Medium close-up of Catherine fluttering her fan beneath her chin, smirking approvingly.",
      "line_number": 165,
      "duration_ms": 1300
    },
    {
      "block_id": "EP030_B038",
      "episode_id": "EP030",
      "file_index": 37,
      "scene_id": "EP030_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
