      "duration_ms": 2500
    },
    {
      "block_id": "EP029_B046",
      "episode_id": "EP029",
      "file_index": 45,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Scoffing, Amused)",
      "speaker": "CATHERINE",
      "delivery": [
        "Scoffing",
        "Amused"
      ],
      "offscreen": null,
      "start_raw": "01:12.10",
      "end_raw": "01:14.30",
      "start_ms": 72100,
      "end_ms": 74300,
      "text": "\"Your scarred soldier?\"",
      "line_number": 201,
      "duration_ms": 2200
    },
    {
      "block_id": "EP029_B047",
      "episode_id": "EP029",
      "file_index": 46,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:14.30",
      "end_raw": "01:18.50",
      "start_ms": 74300,
      "end_ms": 78500,
      "text": "Close-up of Catherine's face hardening into sharp mockery.",
