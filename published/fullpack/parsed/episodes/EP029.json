      "scene_id": "EP029_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:24.00",
      "end_raw": "01:26.50",
      "start_ms": 84000,
      "end_ms": 86500,
      "text": "The guards shove Juliana violently into the cell; she falls hard onto all fours across the cold, wet stone floor.",
      "line_number": 236,
      "duration_ms": 2500
    },
    {
      "block_id": "EP029_B054",
      "episode_id": "EP029",
      "file_index": 53,
      "scene_id": "EP029_S03",
      "block_type": "DIALOGUE",
