      "end_ms": 105200,
      "text": "Muffled, dull metallic clanging reverberates as Juliana hammers against the iron door.",
      "line_number": 288,
      "duration_ms": 2700
    },
    {
      "block_id": "EP029_B067",
      "episode_id": "EP029",
      "file_index": 66,
      "scene_id": "EP029_S03",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Shouting in Anguish)",
      "speaker": "JULIANA",
