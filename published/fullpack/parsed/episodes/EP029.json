      "start_raw": "00:00.00",
      "end_raw": "00:03.50",
      "start_ms": 0,
      "end_ms": 3500,
      "text": "Dripping water echoes hollowly against stone steps alongside the shuffling scuffle of boots.",
      "line_number": 18,
      "duration_ms": 3500
    },
    {
      "block_id": "EP029_B003",
      "episode_id": "EP029",
      "file_index": 2,
      "scene_id": "EP029_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:02.80",
      "end_raw": "00:05.10",
      "start_ms": 2800,
      "end_ms": 5100,
      "text": "Tracking shot facing two stern uniform guards hauling a struggling Juliana down the dark corridor by her arms.",
      "line_number": 22,
      "duration_ms": 2300
    },
    {
      "block_id": "EP029_B004",
      "episode_id": "EP029",
      "file_index": 3,
      "scene_id": "EP029_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:02.90",
      "end_raw": "00:05.10",
      "start_ms": 2900,
      "end_ms": 5100,
      "text": "Juliana resists furiously, her feet stumbling on the wet flagstones as the guards forcibly propel her forward.",
      "line_number": 26,
      "duration_ms": 2200
    },
    {
      "block_id": "EP029_B005",
      "episode_id": "EP029",
      "file_index": 4,
      "scene_id": "EP029_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:05.10",
      "end_raw": "00:07.40",
      "start_ms": 5100,
      "end_ms": 7400,
      "text": "Medium low-angle shot of Catherine standing regally under an arched stone doorway, clutching the leather-bound herbarium.",
      "line_number": 30,
      "duration_ms": 2300
    },
    {
      "block_id": "EP029_B006",
      "episode_id": "EP029",
      "file_index": 5,
      "scene_id": "EP029_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:07.40",
      "end_raw": "00:11.70",
      "start_ms": 7400,
      "end_ms": 11700,
      "text": "Tight close-up of Juliana's tearful face as she reaches an arm out toward Catherine in anguish.",
      "line_number": 34,
      "duration_ms": 4300
    },
    {
      "block_id": "EP029_B007",
      "episode_id": "EP029",
      "file_index": 6,
      "scene_id": "EP029_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Desperate, Weeping)",
      "speaker": "JULIANA",
      "delivery": [
        "Desperate",
        "Weeping"
      ],
      "offscreen": null,
      "start_raw": "00:07.40",
      "end_raw": "00:11.70",
      "start_ms": 7400,
      "end_ms": 11700,
      "text": "\"Catherine! Please! That book is my mother's only legacy!\"",
      "line_number": 38,
      "duration_ms": 4300
    },
    {
      "block_id": "EP029_B008",
      "episode_id": "EP029",
      "file_index": 7,
      "scene_id": "EP029_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:11.70",
      "end_raw": "00:13.20",
      "start_ms": 11700,
      "end_ms": 13200,
      "text": "Medium shot from behind Catherine as she stands motionless, watching Juliana being dragged away.",
      "line_number": 42,
      "duration_ms": 1500
    },
    {
      "block_id": "EP029_B009",
      "episode_id": "EP029",
      "file_index": 8,
      "scene_id": "EP029_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:13.20",
      "end_raw": "00:17.30",
      "start_ms": 13200,
      "end_ms": 17300,
      "text": "Close-up of Juliana turning her head back toward Catherine, screaming through tears.",
      "line_number": 46,
      "duration_ms": 4100
    },
    {
      "block_id": "EP029_B010",
      "episode_id": "EP029",
      "file_index": 9,
      "scene_id": "EP029_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Pleading, Agonized)",
      "speaker": "JULIANA",
      "delivery": [
        "Pleading",
        "Agonized"
      ],
      "offscreen": null,
      "start_raw": "00:13.20",
      "end_raw": "00:17.30",
      "start_ms": 13200,
      "end_ms": 17300,
      "text": "\"It contains years of her work! Her knowledge! Everything she left me!\"",
      "line_number": 50,
      "duration_ms": 4100
    },
    {
      "block_id": "EP029_B011",
      "episode_id": "EP029",
      "file_index": 10,
      "scene_id": "EP029_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:17.30",
      "end_raw": "00:20.10",
      "start_ms": 17300,
      "end_ms": 20100,
      "text": "Full shot of Catherine turning gracefully on the dungeon steps, holding the book loosely at her side.",
      "line_number": 54,
      "duration_ms": 2800
    },
    {
      "block_id": "EP029_B012",
      "episode_id": "EP029",
      "file_index": 11,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:20.10",
      "end_raw": "00:26.80",
      "start_ms": 20100,
      "end_ms": 26800,
      "text": "Medium close-up pushing in on Catherine as she presents the worn botanical book with both gloved hands.",
      "line_number": 65,
      "duration_ms": 6700
    },
    {
      "block_id": "EP029_B013",
      "episode_id": "EP029",
      "file_index": 12,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Mocking, Condescending)",
      "speaker": "CATHERINE",
      "delivery": [
        "Mocking",
        "Condescending"
      ],
      "offscreen": null,
      "start_raw": "00:21.00",
      "end_raw": "00:24.00",
      "start_ms": 21000,
      "end_ms": 24000,
      "text": "\"Your mother's little book of weeds?\"",
      "line_number": 69,
      "duration_ms": 3000
    },
    {
      "block_id": "EP029_B014",
      "episode_id": "EP029",
      "file_index": 13,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Cruel, Smug)",
      "speaker": "CATHERINE",
      "delivery": [
        "Cruel",
        "Smug"
      ],
      "offscreen": null,
      "start_raw": "00:24.80",
      "end_raw": "00:26.70",
      "start_ms": 24800,
      "end_ms": 26700,
      "text": "\"You still call this a legacy?\"",
      "line_number": 73,
      "duration_ms": 1900
    },
    {
      "block_id": "EP029_B015",
      "episode_id": "EP029",
      "file_index": 14,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:26.80",
      "end_raw": "00:28.90",
      "start_ms": 26800,
      "end_ms": 28900,
      "text": "Close-up of Juliana held firmly between the guards, glaring back with fierce defiance.",
      "line_number": 77,
      "duration_ms": 2100
    },
    {
      "block_id": "EP029_B016",
      "episode_id": "EP029",
      "file_index": 15,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Defiant, Furious)",
      "speaker": "JULIANA",
      "delivery": [
        "Defiant",
        "Furious"
      ],
      "offscreen": null,
      "start_raw": "00:27.10",
      "end_raw": "00:28.70",
      "start_ms": 27100,
      "end_ms": 28700,
      "text": "\"It is medicine!\"",
      "line_number": 81,
      "duration_ms": 1600
    },
    {
      "block_id": "EP029_B017",
      "episode_id": "EP029",
      "file_index": 16,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:28.90",
      "end_raw": "00:31.90",
      "start_ms": 28900,
      "end_ms": 31900,
      "text": "Medium close-up of Catherine smiling condescendingly.",
      "line_number": 85,
      "duration_ms": 3000
    },
    {
      "block_id": "EP029_B018",
      "episode_id": "EP029",
      "file_index": 17,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Smooth, Patronizing)",
      "speaker": "CATHERINE",
      "delivery": [
        "Smooth",
        "Patronizing"
      ],
      "offscreen": null,
      "start_raw": "00:30.40",
      "end_raw": "00:31.80",
      "start_ms": 30400,
      "end_ms": 31800,
      "text": "\"Of course.\"",
      "line_number": 89,
      "duration_ms": 1400
    },
    {
      "block_id": "EP029_B019",
      "episode_id": "EP029",
      "file_index": 18,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:31.90",
      "end_raw": "00:37.40",
      "start_ms": 31900,
      "end_ms": 37400,
      "text": "Overhead close-up of Catherine's gloved fingers flipping through the herbarium's delicate, hand-drawn floral remedies and annotations.",
      "line_number": 93,
      "duration_ms": 5500
    },
    {
      "block_id": "EP029_B020",
      "episode_id": "EP029",
      "file_index": 19,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (O.S.) (Disdainful, Calculating)",
      "speaker": "CATHERINE",
      "delivery": [
        "Disdainful",
        "Calculating"
      ],
      "offscreen": "O.S.",
      "start_raw": "00:31.90",
      "end_raw": "00:37.30",
      "start_ms": 31900,
      "end_ms": 37300,
      "text": "\"Roots. Leaves. Powders. Strange mixtures written in a dead woman's hand.\"",
      "line_number": 97,
      "duration_ms": 5400
    },
    {
      "block_id": "EP029_B021",
      "episode_id": "EP029",
      "file_index": 20,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:37.40",
      "end_raw": "00:40.00",
      "start_ms": 37400,
      "end_ms": 40000,
      "text": "Medium shot of Catherine tucking the book under her arm, her eyes glinting with malicious intent.",
      "line_number": 101,
      "duration_ms": 2600
    },
    {
      "block_id": "EP029_B022",
      "episode_id": "EP029",
      "file_index": 21,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Icy, Threatening)",
      "speaker": "CATHERINE",
      "delivery": [
        "Icy",
        "Threatening"
      ],
      "offscreen": null,
      "start_raw": "00:37.70",
      "end_raw": "00:40.00",
      "start_ms": 37700,
      "end_ms": 40000,
      "text": "\"The magistrate will call it witchcraft.\"",
      "line_number": 105,
      "duration_ms": 2300
    },
    {
      "block_id": "EP029_B023",
      "episode_id": "EP029",
      "file_index": 22,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:40.00",
      "end_raw": "00:41.90",
      "start_ms": 40000,
      "end_ms": 41900,
      "text": "Close-up of Juliana lunging against the guard's grip, her teeth bared in indignation.",
      "line_number": 109,
      "duration_ms": 1900
    },
    {
      "block_id": "EP029_B024",
      "episode_id": "EP029",
      "file_index": 23,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Furious, Shouted)",
      "speaker": "JULIANA",
      "delivery": [
        "Furious",
        "Shouted"
      ],
      "offscreen": null,
      "start_raw": "00:40.10",
      "end_raw": "00:41.80",
      "start_ms": 40100,
      "end_ms": 41800,
      "text": "\"You know that is a lie!\"",
      "line_number": 113,
      "duration_ms": 1700
    },
    {
      "block_id": "EP029_B025",
      "episode_id": "EP029",
      "file_index": 24,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:41.90",
      "end_raw": "00:44.30",
      "start_ms": 41900,
      "end_ms": 44300,
      "text": "Medium shot of Catherine lifting her chin arrogantly against the stone backdrop.",
      "line_number": 117,
      "duration_ms": 2400
    },
    {
      "block_id": "EP029_B026",
      "episode_id": "EP029",
      "file_index": 25,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Calm, Sinister)",
      "speaker": "CATHERINE",
      "delivery": [
        "Calm",
        "Sinister"
      ],
      "offscreen": null,
      "start_raw": "00:42.00",
      "end_raw": "00:44.20",
      "start_ms": 42000,
      "end_ms": 44200,
      "text": "\"I know exactly what I need him to believe.\"",
      "line_number": 121,
      "duration_ms": 2200
    },
    {
      "block_id": "EP029_B027",
      "episode_id": "EP029",
      "file_index": 26,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:44.30",
      "end_raw": "00:46.90",
      "start_ms": 44300,
      "end_ms": 46900,
      "text": "Medium shot of Juliana thrashing frantically against the two guards.",
      "line_number": 125,
      "duration_ms": 2600
    },
    {
      "block_id": "EP029_B028",
      "episode_id": "EP029",
      "file_index": 27,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Screaming, Desperate)",
      "speaker": "JULIANA",
      "delivery": [
        "Screaming",
        "Desperate"
      ],
      "offscreen": null,
      "start_raw": "00:44.40",
      "end_raw": "00:46.50",
      "start_ms": 44400,
      "end_ms": 46500,
      "text": "\"You cannot just destroy it!\"",
      "line_number": 129,
      "duration_ms": 2100
    },
    {
      "block_id": "EP029_B029",
      "episode_id": "EP029",
      "file_index": 28,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:46.90",
      "end_raw": "00:49.80",
      "start_ms": 46900,
      "end_ms": 49800,
      "text": "Tight close-up of Catherine's eyes narrowing into an icy, venomous gaze.",
      "line_number": 133,
      "duration_ms": 2900
    },
    {
      "block_id": "EP029_B030",
      "episode_id": "EP029",
      "file_index": 29,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Whispered, Malicious)",
      "speaker": "CATHERINE",
      "delivery": [
        "Whispered",
        "Malicious"
      ],
      "offscreen": null,
      "start_raw": "00:47.30",
      "end_raw": "00:49.10",
      "start_ms": 47300,
      "end_ms": 49100,
      "text": "\"I can burn it.\"",
      "line_number": 137,
      "duration_ms": 1800
    },
    {
      "block_id": "EP029_B031",
      "episode_id": "EP029",
      "file_index": 30,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:49.80",
      "end_raw": "00:53.60",
      "start_ms": 49800,
      "end_ms": 53600,
      "text": "Close-up of Juliana's stricken expression, her eyes widening in horror.",
      "line_number": 141,
      "duration_ms": 3800
    },
    {
      "block_id": "EP029_B032",
      "episode_id": "EP029",
      "file_index": 31,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (O.S.) (Chilling, Relentless)",
      "speaker": "CATHERINE",
      "delivery": [
        "Chilling",
        "Relentless"
      ],
      "offscreen": "O.S.",
      "start_raw": "00:50.10",
      "end_raw": "00:53.60",
      "start_ms": 50100,
      "end_ms": 53600,
      "text": "\"And when they find your corpse at the end of the rope...\"",
      "line_number": 145,
      "duration_ms": 3500
    },
    {
      "block_id": "EP029_B033",
      "episode_id": "EP029",
      "file_index": 32,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:53.60",
      "end_raw": "00:56.60",
      "start_ms": 53600,
      "end_ms": 56600,
      "text": "Side close-up of Catherine leaning slightly forward, her voice low and merciless.",
      "line_number": 149,
      "duration_ms": 3000
    },
    {
      "block_id": "EP029_B034",
      "episode_id": "EP029",
      "file_index": 33,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Cruel, Resolute)",
      "speaker": "CATHERINE",
      "delivery": [
        "Cruel",
        "Resolute"
      ],
      "offscreen": null,
      "start_raw": "00:53.80",
      "end_raw": "00:56.50",
      "start_ms": 53800,
      "end_ms": 56500,
      "text": "\"...no one will remember what was written inside.\"",
      "line_number": 153,
      "duration_ms": 2700
    },
    {
      "block_id": "EP029_B035",
      "episode_id": "EP029",
      "file_index": 34,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:56.60",
      "end_raw": "00:59.20",
      "start_ms": 56600,
      "end_ms": 59200,
      "text": "Close-up of Juliana screaming back in raw outrage.",
      "line_number": 157,
      "duration_ms": 2600
    },
    {
      "block_id": "EP029_B036",
      "episode_id": "EP029",
      "file_index": 35,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Enraged, Defiant)",
      "speaker": "JULIANA",
      "delivery": [
        "Enraged",
        "Defiant"
      ],
      "offscreen": null,
      "start_raw": "00:56.70",
      "end_raw": "00:59.00",
      "start_ms": 56700,
      "end_ms": 59000,
      "text": "\"You are doing this because I saved the Duchess!\"",
      "line_number": 161,
      "duration_ms": 2300
    },
    {
      "block_id": "EP029_B037",
      "episode_id": "EP029",
      "file_index": 36,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:59.20",
      "end_raw": "01:03.80",
      "start_ms": 59200,
      "end_ms": 63800,
      "text": "Medium low-angle shot of Catherine standing rigid in her silk gown, contempt etched across her features.",
      "line_number": 165,
      "duration_ms": 4600
    },
    {
      "block_id": "EP029_B038",
      "episode_id": "EP029",
      "file_index": 37,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Scornful, Arrogant)",
      "speaker": "CATHERINE",
      "delivery": [
        "Scornful",
        "Arrogant"
      ],
      "offscreen": null,
      "start_raw": "00:59.30",
      "end_raw": "01:03.40",
      "start_ms": 59300,
      "end_ms": 63400,
      "text": "\"I am doing this because women like you forget their place.\"",
      "line_number": 169,
      "duration_ms": 4100
    },
    {
      "block_id": "EP029_B039",
      "episode_id": "EP029",
      "file_index": 38,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:03.80",
      "end_raw": "01:07.00",
      "start_ms": 63800,
      "end_ms": 67000,
      "text": "Quick pan from Juliana's apron up to Catherine's face.",
      "line_number": 173,
      "duration_ms": 3200
    },
    {
      "block_id": "EP029_B040",
      "episode_id": "EP029",
      "file_index": 39,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Cold, Venomous)",
      "speaker": "CATHERINE",
