      "start_raw": "01:04.50",
      "end_raw": "01:06.50",
      "start_ms": 64500,
      "end_ms": 66500,
      "text": "\"You were cast out once.\"",
      "line_number": 177,
      "duration_ms": 2000
    },
    {
      "block_id": "EP029_B041",
      "episode_id": "EP029",
      "file_index": 40,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:07.00",
      "end_raw": "01:09.50",
      "start_ms": 67000,
      "end_ms": 69500,
      "text": "Extreme close-up on Catherine's smiling lips and cold blue eyes.",
      "line_number": 181,
      "duration_ms": 2500
    },
    {
      "block_id": "EP029_B042",
      "episode_id": "EP029",
      "file_index": 41,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Menacing)",
      "speaker": "CATHERINE",
      "delivery": [
        "Menacing"
      ],
      "offscreen": null,
      "start_raw": "01:07.20",
      "end_raw": "01:09.10",
      "start_ms": 67200,
      "end_ms": 69100,
      "text": "\"You should have stayed forgotten.\"",
      "line_number": 185,
      "duration_ms": 1900
    },
    {
      "block_id": "EP029_B043",
      "episode_id": "EP029",
      "file_index": 42,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:09.50",
      "end_raw": "01:11.80",
      "start_ms": 69500,
      "end_ms": 71800,
      "text": "Close-up of Juliana raising her chin, unwavering pride breaking through her tears.",
      "line_number": 189,
      "duration_ms": 2300
    },
    {
      "block_id": "EP029_B044",
      "episode_id": "EP029",
      "file_index": 43,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Steely, Resolute)",
      "speaker": "JULIANA",
      "delivery": [
        "Steely",
        "Resolute"
      ],
      "offscreen": null,
      "start_raw": "01:09.80",
      "end_raw": "01:11.40",
      "start_ms": 69800,
      "end_ms": 71400,
      "text": "\"My husband will find me.\"",
      "line_number": 193,
      "duration_ms": 1600
    },
    {
      "block_id": "EP029_B045",
      "episode_id": "EP029",
      "file_index": 44,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:11.80",
      "end_raw": "01:14.30",
      "start_ms": 71800,
      "end_ms": 74300,
      "text": "Medium shot of Catherine letting out a scornful laugh, tilting her head.",
