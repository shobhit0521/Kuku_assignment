      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:20.90",
      "end_raw": "01:23.00",
      "start_ms": 80900,
      "end_ms": 83000,
      "text": "Wide shot tracking behind the guards as they march Juliana down the vaulted, puddle-strewn corridor toward the heavy iron cell door.",
      "line_number": 221,
      "duration_ms": 2100
    },
    {
      "block_id": "EP029_B052",
      "episode_id": "EP029",
      "file_index": 51,
      "scene_id": "EP029_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:23.00",
      "end_raw": "01:26.50",
      "start_ms": 83000,
      "end_ms": 86500,
      "text": "Wide shot inside the pitch-dark cell as the heavy iron door swings open.",
      "line_number": 232,
      "duration_ms": 3500
    },
    {
      "block_id": "EP029_B053",
      "episode_id": "EP029",
