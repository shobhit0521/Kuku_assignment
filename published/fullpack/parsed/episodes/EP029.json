      ],
      "offscreen": null,
      "start_raw": "01:42.60",
      "end_raw": "01:45.30",
      "start_ms": 102600,
      "end_ms": 105300,
      "text": "\"I saved the Duchess!\"",
      "line_number": 292,
      "duration_ms": 2700
    },
    {
      "block_id": "EP029_B068",
      "episode_id": "EP029",
      "file_index": 67,
      "scene_id": "EP029_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
