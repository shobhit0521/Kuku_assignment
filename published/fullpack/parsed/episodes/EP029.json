      "duration_ms": 4200
    },
    {
      "block_id": "EP029_B048",
      "episode_id": "EP029",
      "file_index": 47,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Derisive, Biting)",
      "speaker": "CATHERINE",
      "delivery": [
        "Derisive",
        "Biting"
      ],
      "offscreen": null,
      "start_raw": "01:14.70",
      "end_raw": "01:18.10",
      "start_ms": 74700,
      "end_ms": 78100,
      "text": "\"What exactly do you think a penniless veteran can do against Ashbrook?\"",
      "line_number": 209,
      "duration_ms": 3400
    },
    {
      "block_id": "EP029_B049",
      "episode_id": "EP029",
      "file_index": 48,
      "scene_id": "EP029_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:18.50",
      "end_raw": "01:20.90",
      "start_ms": 78500,
      "end_ms": 80900,
      "text": "Medium shot as the guard clamps a heavy hand on Juliana's shoulder, shoving her forward.",
      "line_number": 213,
      "duration_ms": 2400
    },
    {
      "block_id": "EP029_B050",
      "episode_id": "EP029",
      "file_index": 49,
      "scene_id": "EP029_S02",
      "block_type": "DIALOGUE",
