      "end_ms": 2800,
      "text": "High angle tracking shot descending a spiral stone staircase illuminated by flickering wall torches and damp, glistening masonry.",
      "line_number": 14,
      "duration_ms": 2800
    },
    {
      "block_id": "EP029_B002",
      "episode_id": "EP029",
      "file_index": 1,
      "scene_id": "EP029_S01",
      "block_type": "SOUND_FX",
