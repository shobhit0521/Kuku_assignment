      "end_ms": 99600,
      "text": "Medium shot as Juliana pushes herself off the wet stone floor and dashes toward the barred wicket of the heavy door.",
      "line_number": 268,
      "duration_ms": 3500
    },
    {
      "block_id": "EP029_B062",
      "episode_id": "EP029",
      "file_index": 61,
      "scene_id": "EP029_S03",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Desperate, Shouting)",
