      "end_ms": 96100,
      "text": "Extreme close-up of Juliana's tear-drenched face crumpling in overwhelming grief.",
      "line_number": 260,
      "duration_ms": 2400
    },
    {
      "block_id": "EP029_B060",
      "episode_id": "EP029",
      "file_index": 59,
      "scene_id": "EP029_S03",
      "block_type": "DIALOGUE",
