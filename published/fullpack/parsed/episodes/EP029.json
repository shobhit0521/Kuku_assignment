      "offscreen": null,
      "start_raw": "01:39.70",
      "end_raw": "01:42.30",
      "start_ms": 99700,
      "end_ms": 102300,
      "text": "\"I saved her! I healed her!\"",
      "line_number": 280,
      "duration_ms": 2600
    },
    {
      "block_id": "EP029_B065",
      "episode_id": "EP029",
