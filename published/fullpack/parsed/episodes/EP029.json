      "end_ms": 95500,
      "text": "\"Mother...\"",
      "line_number": 264,
      "duration_ms": 1300
    },
    {
      "block_id": "EP029_B061",
      "episode_id": "EP029",
      "file_index": 60,
      "scene_id": "EP029_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
