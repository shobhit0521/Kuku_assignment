        "Shouting"
      ],
      "offscreen": null,
      "start_raw": "01:37.30",
      "end_raw": "01:39.50",
      "start_ms": 97300,
      "end_ms": 99500,
      "text": "\"I have done nothing!\"",
      "line_number": 272,
      "duration_ms": 2200
    },
    {
      "block_id": "EP029_B063",
      "episode_id": "EP029",
      "file_index": 62,
      "scene_id": "EP029_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
