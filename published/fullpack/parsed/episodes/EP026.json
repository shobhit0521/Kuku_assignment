  "blocks": [
    {
      "block_id": "EP026_B001",
      "episode_id": "EP026",
      "file_index": 0,
      "scene_id": "EP026_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
