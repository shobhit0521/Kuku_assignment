      "end_raw": "00:04.00",
      "start_ms": 0,
      "end_ms": 4000,
      "text": "Wide shot framing the gothic stone archway of Ashbury Manor as other maidservants carrying laundry baskets pass through the damp courtyard.",
      "line_number": 14,
      "duration_ms": 4000
    },
    {
      "block_id": "EP022_B002",
      "episode_id": "EP022",
      "file_index": 1,
      "scene_id": "EP022_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:04.00",
      "start_ms": 0,
      "end_ms": 4000,
      "text": "Lady Juliana walks nervously along the stone pavement dressed in a modest dark maid's dress and a plain white apron, looking around cautiously.",
      "line_number": 18,
      "duration_ms": 4000
    },
    {
      "block_id": "EP022_B003",
      "episode_id": "EP022",
      "file_index": 2,
      "scene_id": "EP022_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:04.00",
      "end_raw": "00:07.00",
      "start_ms": 4000,
      "end_ms": 7000,
      "text": "Medium close-up of Lady Juliana adjusting her high buttoned collar, anxious yet determined, against the backdrop of the gloomy coast.",
      "line_number": 22,
      "duration_ms": 3000
    },
    {
      "block_id": "EP022_B004",
      "episode_id": "EP022",
      "file_index": 3,
      "scene_id": "EP022_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:06.50",
      "end_raw": "00:08.50",
      "start_ms": 6500,
      "end_ms": 8500,
      "text": "Prudence rushes up behind Lady Juliana, pulling her into the shelter of the stone archway.",
      "line_number": 26,
      "duration_ms": 2000
    },
    {
      "block_id": "EP022_B005",
      "episode_id": "EP022",
      "file_index": 4,
      "scene_id": "EP022_S01",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Urgent, Whispering)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Urgent",
        "Whispering"
      ],
      "offscreen": null,
      "start_raw": "00:07.00",
      "end_raw": "00:11.10",
      "start_ms": 7000,
      "end_ms": 11100,
      "text": "\"Keep your head down. If anyone recognizes you, everything is over.\"",
      "line_number": 30,
      "duration_ms": 4100
    },
    {
      "block_id": "EP022_B006",
      "episode_id": "EP022",
      "file_index": 5,
      "scene_id": "EP022_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:11.10",
      "end_raw": "00:14.20",
      "start_ms": 11100,
      "end_ms": 14200,
      "text": "Close-up of Lady Juliana leaning back against the rough stone wall, whispering back firmly.",
      "line_number": 34,
      "duration_ms": 3100
    },
    {
      "block_id": "EP022_B007",
      "episode_id": "EP022",
      "file_index": 6,
      "scene_id": "EP022_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Resolute, Quiet)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Resolute",
        "Quiet"
      ],
      "offscreen": null,
      "start_raw": "00:11.20",
      "end_raw": "00:14.20",
      "start_ms": 11200,
      "end_ms": 14200,
      "text": "\"No one will recognize me dressed like this.\"",
      "line_number": 38,
      "duration_ms": 3000
    },
    {
      "block_id": "EP022_B008",
      "episode_id": "EP022",
      "file_index": 7,
      "scene_id": "EP022_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:14.20",
      "end_raw": "00:19.00",
      "start_ms": 14200,
      "end_ms": 19000,
      "text": "Medium close-up of Prudence glancing nervously toward the courtyard before fixing her gaze on Juliana.",
      "line_number": 42,
      "duration_ms": 4800
    },
    {
      "block_id": "EP022_B009",
      "episode_id": "EP022",
      "file_index": 8,
      "scene_id": "EP022_S01",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Nervous, Warning)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Nervous",
        "Warning"
      ],
      "offscreen": null,
      "start_raw": "00:14.20",
      "end_raw": "00:19.00",
      "start_ms": 14200,
      "end_ms": 19000,
      "text": "\"This is Ashburton Manor. The housekeeper watches everyone. Lady Catherine watches everyone, and Lord Rupert...\"",
      "line_number": 46,
      "duration_ms": 4800
    },
    {
      "block_id": "EP022_B010",
      "episode_id": "EP022",
      "file_index": 9,
      "scene_id": "EP022_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:19.00",
      "end_raw": "00:21.20",
      "start_ms": 19000,
      "end_ms": 21200,
      "text": "Close-up of Lady Juliana cutting in with fierce, unyielding conviction.",
      "line_number": 50,
      "duration_ms": 2200
    },
    {
      "block_id": "EP022_B011",
      "episode_id": "EP022",
      "file_index": 10,
      "scene_id": "EP022_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Determined)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Determined"
      ],
      "offscreen": null,
      "start_raw": "00:19.10",
      "end_raw": "00:21.00",
      "start_ms": 19100,
      "end_ms": 21000,
      "text": "\"The Duchess is dying.\"",
      "line_number": 54,
      "duration_ms": 1900
    },
    {
      "block_id": "EP022_B012",
      "episode_id": "EP022",
      "file_index": 11,
      "scene_id": "EP022_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:21.20",
      "end_raw": "00:25.80",
      "start_ms": 21200,
      "end_ms": 25800,
      "text": "Low-angle shot looking up at Lady Juliana and Prudence standing beneath the looming stone facade of the manor.",
      "line_number": 58,
      "duration_ms": 4600
    },
    {
      "block_id": "EP022_B013",
      "episode_id": "EP022",
      "file_index": 12,
      "scene_id": "EP022_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Defiant, Firm)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Defiant",
        "Firm"
      ],
      "offscreen": null,
      "start_raw": "00:22.00",
      "end_raw": "00:25.50",
      "start_ms": 22000,
      "end_ms": 25500,
      "text": "\"I saved Toby. I can save her.\"",
      "line_number": 62,
      "duration_ms": 3500
    },
    {
      "block_id": "EP022_B014",
      "episode_id": "EP022",
      "file_index": 13,
      "scene_id": "EP022_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:25.80",
      "end_raw": "00:28.10",
      "start_ms": 25800,
      "end_ms": 28100,
      "text": "Close-up on Prudence, her eyes wide with dread.",
      "line_number": 66,
      "duration_ms": 2300
    },
    {
      "block_id": "EP022_B015",
      "episode_id": "EP022",
      "file_index": 14,
      "scene_id": "EP022_S01",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Fretful)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Fretful"
      ],
      "offscreen": null,
      "start_raw": "00:26.00",
      "end_raw": "00:28.10",
      "start_ms": 26000,
      "end_ms": 28100,
      "text": "\"And if they discover who you are?\"",
      "line_number": 70,
      "duration_ms": 2100
    },
    {
      "block_id": "EP022_B016",
      "episode_id": "EP022",
      "file_index": 15,
      "scene_id": "EP022_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:28.10",
      "end_raw": "00:31.50",
      "start_ms": 28100,
      "end_ms": 31500,
      "text": "Close-up on Lady Juliana holding her gaze steadily.",
      "line_number": 74,
      "duration_ms": 3400
    },
    {
      "block_id": "EP022_B017",
      "episode_id": "EP022",
      "file_index": 16,
      "scene_id": "EP022_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Steely, Selfless)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Steely",
        "Selfless"
      ],
      "offscreen": null,
      "start_raw": "00:28.20",
      "end_raw": "00:31.00",
      "start_ms": 28200,
      "end_ms": 31000,
      "text": "\"Then I will face that when she is breathing again.\"",
      "line_number": 78,
      "duration_ms": 2800
    },
    {
      "block_id": "EP022_B018",
      "episode_id": "EP022",
      "file_index": 17,
      "scene_id": "EP022_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:31.50",
      "end_raw": "00:36.20",
      "start_ms": 31500,
      "end_ms": 36200,
      "text": "Medium two-shot outside the heavy wooden servant entrance door.",
      "line_number": 82,
      "duration_ms": 4700
    },
    {
      "block_id": "EP022_B019",
      "episode_id": "EP022",
      "file_index": 18,
      "scene_id": "EP022_S01",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Solemn)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Solemn"
      ],
      "offscreen": null,
      "start_raw": "00:33.80",
      "end_raw": "00:36.00",
      "start_ms": 33800,
      "end_ms": 36000,
      "text": "\"Then forget you were ever a lady.\"",
      "line_number": 86,
      "duration_ms": 2200
    },
    {
      "block_id": "EP022_B020",
      "episode_id": "EP022",
      "file_index": 19,
      "scene_id": "EP022_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:36.20",
      "end_raw": "00:39.80",
      "start_ms": 36200,
      "end_ms": 39800,
      "text": "Close-up of Lady Juliana swallowing her pride and accepting her perilous disguise.",
      "line_number": 90,
      "duration_ms": 3600
    },
    {
      "block_id": "EP022_B021",
      "episode_id": "EP022",
      "file_index": 20,
      "scene_id": "EP022_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Quietly Resolute)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Quietly Resolute"
      ],
      "offscreen": null,
      "start_raw": "00:37.00",
      "end_raw": "00:39.50",
      "start_ms": 37000,
      "end_ms": 39500,
      "text": "\"Today, I am only a maid.\"",
      "line_number": 94,
      "duration_ms": 2500
    },
    {
      "block_id": "EP022_B022",
      "episode_id": "EP022",
      "file_index": 21,
      "scene_id": "EP022_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:39.80",
      "end_raw": "00:42.50",
      "start_ms": 39800,
      "end_ms": 42500,
      "text": "Prudence opens the heavy wooden service door, and both women step inside into the dark servants' corridor as the door shuts firmly behind them.",
      "line_number": 98,
      "duration_ms": 2700
    },
    {
      "block_id": "EP022_B023",
      "episode_id": "EP022",
      "file_index": 22,
      "scene_id": "EP022_S01",
      "block_type": "SOUND_FX",
