      "start_raw": "00:43.00",
      "end_raw": "00:44.20",
      "start_ms": 43000,
      "end_ms": 44200,
      "text": "\"Prudence.\"",
      "line_number": 113,
      "duration_ms": 1200
    },
    {
      "block_id": "EP022_B025",
      "episode_id": "EP022",
      "file_index": 24,
      "scene_id": "EP022_S02",
      "block_type": "CAMERA",
