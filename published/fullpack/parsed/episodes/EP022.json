      "end_raw": "00:49.20",
      "start_ms": 46000,
      "end_ms": 49200,
      "text": "Medium shot of Prudence curtsying low with downcast eyes while Lady Juliana stands behind her carrying a heavy wooden water bucket.",
      "line_number": 125,
      "duration_ms": 3200
    },
    {
      "block_id": "EP022_B028",
      "episode_id": "EP022",
      "file_index": 27,
      "scene_id": "EP022_S02",
      "block_type": "DIALOGUE",
