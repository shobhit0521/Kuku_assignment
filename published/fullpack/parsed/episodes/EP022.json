      "speaker": "PRUDENCE",
      "delivery": [
        "Submissive"
      ],
      "offscreen": null,
      "start_raw": "00:46.00",
      "end_raw": "00:49.00",
      "start_ms": 46000,
      "end_ms": 49000,
      "text": "\"Julian, ma'am. New help for the winter cleaning.\"",
      "line_number": 129,
      "duration_ms": 3000
    },
    {
      "block_id": "EP022_B029",
      "episode_id": "EP022",
      "file_index": 28,
