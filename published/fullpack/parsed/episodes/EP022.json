      "end_raw": "00:46.00",
      "start_ms": 43000,
      "end_ms": 46000,
      "text": "Medium shot of the formidable Housekeeper standing in the dim stone hallway with arms folded, ring of keys dangling from her waist.",
      "line_number": 117,
      "duration_ms": 3000
    },
    {
      "block_id": "EP022_B026",
      "episode_id": "EP022",
      "file_index": 25,
      "scene_id": "EP022_S02",
      "block_type": "DIALOGUE",
      "label_raw": "HOUSEKEEPER (Suspicious)",
      "speaker": "HOUSEKEEPER",
      "delivery": [
        "Suspicious"
      ],
      "offscreen": null,
      "start_raw": "00:44.30",
      "end_raw": "00:45.60",
      "start_ms": 44300,
      "end_ms": 45600,
      "text": "\"Who is this?\"",
      "line_number": 121,
      "duration_ms": 1300
    },
    {
      "block_id": "EP022_B027",
      "episode_id": "EP022",
      "file_index": 26,
      "scene_id": "EP022_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
