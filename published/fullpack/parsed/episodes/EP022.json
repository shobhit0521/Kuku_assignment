      "end_raw": "00:42.80",
      "start_ms": 41500,
      "end_ms": 42800,
      "text": "Heavy wooden latch clicks shut with a thud.",
      "line_number": 102,
      "duration_ms": 1300
    },
    {
      "block_id": "EP022_B024",
      "episode_id": "EP022",
      "file_index": 23,
      "scene_id": "EP022_S02",
