      "start_ms": 0,
      "end_ms": 3500,
      "text": "Full shot of Alexander and Juliana standing side by side before the altar, their hands tightly clasped beneath the soaring stained-glass windows.",
      "line_number": 14,
      "duration_ms": 3500
    },
    {
      "block_id": "EP046_B002",
      "episode_id": "EP046",
      "file_index": 1,
      "scene_id": "EP046_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:03.50",
      "start_ms": 0,
      "end_ms": 3500,
      "text": "Alexander holds Juliana's hand resolutely as Juliana gazes toward the church aisle where the intrusion unfolds.",
      "line_number": 18,
      "duration_ms": 3500
    },
    {
      "block_id": "EP046_B003",
      "episode_id": "EP046",
      "file_index": 2,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
