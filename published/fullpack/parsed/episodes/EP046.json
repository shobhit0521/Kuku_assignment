      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:03.50",
      "end_raw": "00:05.80",
      "start_ms": 3500,
      "end_ms": 5800,
      "text": "Medium close-up of an elderly noblewoman seated in the pew, clutching her chest with anxious apprehension.",
      "line_number": 22,
      "duration_ms": 2300
    },
    {
      "block_id": "EP046_B004",
      "episode_id": "EP046",
      "file_index": 3,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:05.80",
      "end_raw": "00:07.10",
      "start_ms": 5800,
      "end_ms": 7100,
      "text": "Medium shot of Catherine in her lavish bridal gown, her fists clenched tightly in silent fury.",
      "line_number": 26,
      "duration_ms": 1300
    },
    {
      "block_id": "EP046_B005",
      "episode_id": "EP046",
      "file_index": 4,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:07.10",
      "end_raw": "00:11.00",
      "start_ms": 7100,
      "end_ms": 11000,
      "text": "Wide tracking shot down the ruined nave aisle as the High Priest marches forward flanked by armed royal guards with halberds.",
      "line_number": 30,
      "duration_ms": 3900
    },
    {
      "block_id": "EP046_B006",
      "episode_id": "EP046",
      "file_index": 5,
      "scene_id": "EP046_S01",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:07.80",
      "end_raw": "00:11.00",
      "start_ms": 7800,
      "end_ms": 11000,
      "text": "Heavy armored footsteps and boots crunching against loose stone debris.",
      "line_number": 34,
      "duration_ms": 3200
    },
    {
      "block_id": "EP046_B007",
      "episode_id": "EP046",
      "file_index": 6,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:11.00",
      "end_raw": "00:13.80",
      "start_ms": 11000,
      "end_ms": 13800,
      "text": "Medium shot of the High Priest holding up a wax-sealed document before his chest, flanked by two armed guards.",
      "line_number": 38,
      "duration_ms": 2800
    },
    {
      "block_id": "EP046_B008",
      "episode_id": "EP046",
      "file_index": 7,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Booming, Authoritative)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Booming",
        "Authoritative"
      ],
      "offscreen": null,
      "start_raw": "00:11.50",
      "end_raw": "00:16.80",
      "start_ms": 11500,
      "end_ms": 16800,
      "text": "\"By Royal command, this sanctuary is placed under immediate Crown scesion.\"",
      "line_number": 42,
      "duration_ms": 5300
    },
    {
      "block_id": "EP046_B009",
      "episode_id": "EP046",
      "file_index": 8,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:13.80",
      "end_raw": "00:17.20",
      "start_ms": 13800,
      "end_ms": 17200,
      "text": "Close-up of the High Priest's fingers breaking the crimson wax seal and string on the war office envelope.",
      "line_number": 46,
      "duration_ms": 3400
    },
    {
      "block_id": "EP046_B010",
      "episode_id": "EP046",
      "file_index": 9,
      "scene_id": "EP046_S01",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:15.00",
      "end_raw": "00:16.80",
      "start_ms": 15000,
      "end_ms": 16800,
      "text": "Crisp tear of wax and parchment string snapping open.",
      "line_number": 50,
      "duration_ms": 1800
    },
    {
      "block_id": "EP046_B011",
      "episode_id": "EP046",
      "file_index": 10,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:17.20",
      "end_raw": "00:20.50",
      "start_ms": 17200,
      "end_ms": 20500,
      "text": "Low-angle medium shot of the High Priest opening the yellowed War Office document.",
      "line_number": 54,
      "duration_ms": 3300
    },
    {
      "block_id": "EP046_B012",
      "episode_id": "EP046",
      "file_index": 11,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Stern, Commanding)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Stern",
        "Commanding"
      ],
      "offscreen": null,
      "start_raw": "00:17.30",
      "end_raw": "00:20.40",
      "start_ms": 17300,
      "end_ms": 20400,
      "text": "\"None shall leave until every witness is accounted for.\"",
      "line_number": 58,
      "duration_ms": 3100
    },
    {
      "block_id": "EP046_B013",
      "episode_id": "EP046",
      "file_index": 12,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:20.50",
      "end_raw": "00:22.80",
      "start_ms": 20500,
      "end_ms": 22800,
      "text": "Wide shot of Alexander and Juliana standing defiant at the altar as congregation members watch in silence.",
      "line_number": 62,
      "duration_ms": 2300
    },
    {
      "block_id": "EP046_B014",
      "episode_id": "EP046",
      "file_index": 13,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (O.S.) (Cold, Accusatory)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Cold",
        "Accusatory"
      ],
      "offscreen": "O.S.",
      "start_raw": "00:20.60",
      "end_raw": "00:22.80",
      "start_ms": 20600,
      "end_ms": 22800,
      "text": "\"You married this woman as a nameless beggar...\"",
      "line_number": 66,
      "duration_ms": 2200
    },
    {
      "block_id": "EP046_B015",
      "episode_id": "EP046",
      "file_index": 14,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:22.80",
      "end_raw": "00:26.80",
      "start_ms": 22800,
      "end_ms": 26800,
      "text": "Medium close-up of the High Priest holding the decree, his gaze burning with disdain.",
      "line_number": 70,
      "duration_ms": 4000
    },
    {
      "block_id": "EP046_B016",
      "episode_id": "EP046",
      "file_index": 15,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Scornful, Harsh)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Scornful",
        "Harsh"
      ],
      "offscreen": null,
      "start_raw": "00:22.90",
      "end_raw": "00:26.50",
      "start_ms": 22900,
      "end_ms": 26500,
      "text": "\"...in a hedge ceremony no clerk in England ever recorded.\"",
      "line_number": 74,
      "duration_ms": 3600
    },
    {
      "block_id": "EP046_B017",
      "episode_id": "EP046",
      "file_index": 16,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:26.80",
      "end_raw": "00:30.50",
      "start_ms": 26800,
      "end_ms": 30500,
      "text": "Full shot of the High Priest brandishing the letter aloft in the center of the chapel nave.",
      "line_number": 78,
      "duration_ms": 3700
    },
    {
      "block_id": "EP046_B018",
      "episode_id": "EP046",
      "file_index": 17,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Resonant, Dismissive)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Resonant",
        "Dismissive"
      ],
      "offscreen": null,
      "start_raw": "00:26.80",
      "end_raw": "00:31.80",
      "start_ms": 26800,
      "end_ms": 31800,
      "text": "\"Three years later, the beggar is revealed to be a Duke. The marriage does not rise with him.\"",
      "line_number": 82,
      "duration_ms": 5000
    },
    {
      "block_id": "EP046_B019",
      "episode_id": "EP046",
      "file_index": 18,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:30.50",
      "end_raw": "00:34.20",
      "start_ms": 30500,
      "end_ms": 34200,
      "text": "Medium shot of Alexander turning toward Juliana, placing a protective hand on her arm.",
      "line_number": 86,
      "duration_ms": 3700
    },
    {
      "block_id": "EP046_B020",
      "episode_id": "EP046",
      "file_index": 19,
      "scene_id": "EP046_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:32.50",
      "end_raw": "00:34.50",
      "start_ms": 32500,
      "end_ms": 34500,
      "text": "Juliana places her hand over Alexander's as he steps forward to shield her.",
      "line_number": 90,
      "duration_ms": 2000
    },
    {
      "block_id": "EP046_B021",
      "episode_id": "EP046",
      "file_index": 20,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:34.20",
      "end_raw": "00:37.00",
      "start_ms": 34200,
      "end_ms": 37000,
      "text": "Close-up of Alexander, his scarred face hardening with unwavering conviction.",
      "line_number": 94,
      "duration_ms": 2800
    },
    {
      "block_id": "EP046_B022",
      "episode_id": "EP046",
      "file_index": 21,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Gravely, Firm)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Gravely",
        "Firm"
      ],
      "offscreen": null,
      "start_raw": "00:34.30",
      "end_raw": "00:36.70",
      "start_ms": 34300,
      "end_ms": 36700,
      "text": "\"She married the man... not the title.\"",
      "line_number": 98,
      "duration_ms": 2400
    },
    {
      "block_id": "EP046_B023",
      "episode_id": "EP046",
      "file_index": 22,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:37.00",
      "end_raw": "00:42.80",
      "start_ms": 37000,
      "end_ms": 42800,
      "text": "Low-angle shot looking up at the High Priest as he raises the parchment toward the vaulted ceiling.",
      "line_number": 102,
      "duration_ms": 5800
    },
    {
      "block_id": "EP046_B024",
      "episode_id": "EP046",
      "file_index": 23,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Harsh, Derisive)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Harsh",
        "Derisive"
      ],
      "offscreen": null,
      "start_raw": "00:37.30",
      "end_raw": "00:42.50",
      "start_ms": 37300,
      "end_ms": 42500,
      "text": "\"The church married a vagrant to a ruined lady. It never married the Duke of Ashburton to anyone.\"",
      "line_number": 106,
      "duration_ms": 5200
    },
    {
      "block_id": "EP046_B025",
      "episode_id": "EP046",
      "file_index": 24,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:42.80",
      "end_raw": "00:47.00",
      "start_ms": 42800,
      "end_ms": 47000,
      "text": "Medium shot of the High Priest lowering the document, raising a single finger in admonishment.",
      "line_number": 110,
      "duration_ms": 4200
    },
    {
      "block_id": "EP046_B026",
      "episode_id": "EP046",
      "file_index": 25,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Rigid, Formal)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Rigid",
        "Formal"
      ],
      "offscreen": null,
      "start_raw": "00:42.80",
      "end_raw": "00:47.00",
      "start_ms": 42800,
      "end_ms": 47000,
      "text": "\"No Crown license was sought, because no one thought to ask leave for a Duke to marry.\"",
      "line_number": 114,
      "duration_ms": 4200
    },
    {
      "block_id": "EP046_B027",
      "episode_id": "EP046",
      "file_index": 26,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:47.00",
      "end_raw": "00:49.00",
      "start_ms": 47000,
      "end_ms": 49000,
      "text": "Two-shot of Juliana and Alexander listening intently, Juliana's eyes flashing with hurt and defiance.",
      "line_number": 118,
      "duration_ms": 2000
    },
    {
      "block_id": "EP046_B028",
      "episode_id": "EP046",
      "file_index": 27,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (O.S.) (Sharp)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Sharp"
      ],
      "offscreen": "O.S.",
      "start_raw": "00:47.10",
      "end_raw": "00:49.00",
      "start_ms": 47100,
      "end_ms": 49000,
      "text": "\"No licensed clergyman presided...\"",
      "line_number": 122,
      "duration_ms": 1900
    },
    {
      "block_id": "EP046_B029",
      "episode_id": "EP046",
      "file_index": 28,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:49.00",
      "end_raw": "00:52.20",
      "start_ms": 49000,
      "end_ms": 52200,
      "text": "Close-up of the High Priest glaring intently.",
      "line_number": 126,
      "duration_ms": 3200
    },
    {
      "block_id": "EP046_B030",
      "episode_id": "EP046",
      "file_index": 29,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Scathing)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Scathing"
      ],
      "offscreen": null,
      "start_raw": "00:49.00",
      "end_raw": "00:52.20",
      "start_ms": 49000,
      "end_ms": 52200,
      "text": "\"...because a frightened village priest has no authority to bind a peer.\"",
      "line_number": 130,
      "duration_ms": 3200
    },
    {
      "block_id": "EP046_B031",
      "episode_id": "EP046",
      "file_index": 30,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:52.20",
      "end_raw": "00:58.20",
      "start_ms": 52200,
      "end_ms": 58200,
      "text": "Medium shot pushing into a close-up as the High Priest thrusts the royal War Office proclamation directly into the camera.",
      "line_number": 134,
      "duration_ms": 6000
    },
    {
      "block_id": "EP046_B032",
      "episode_id": "EP046",
      "file_index": 31,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Thundering)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Thundering"
      ],
      "offscreen": null,
      "start_raw": "00:52.20",
      "end_raw": "00:58.00",
      "start_ms": 52200,
      "end_ms": 58000,
      "text": "\"And no clerk in London ever entered your name in the Royal register, because as far as the Crown knew, Alexander Ashburton was already dead.\"",
      "line_number": 138,
      "duration_ms": 5800
    },
    {
      "block_id": "EP046_B033",
      "episode_id": "EP046",
      "file_index": 32,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:58.20",
      "end_raw": "01:02.80",
      "start_ms": 58200,
      "end_ms": 62800,
      "text": "Close-up of Juliana lifting her chin, tearful yet burning with righteous fury.",
      "line_number": 142,
      "duration_ms": 4600
    },
    {
      "block_id": "EP046_B034",
      "episode_id": "EP046",
      "file_index": 33,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Fierce, Defiant)",
      "speaker": "JULIANA",
      "delivery": [
        "Fierce",
        "Defiant"
      ],
      "offscreen": null,
      "start_raw": "00:58.50",
      "end_raw": "01:02.50",
      "start_ms": 58500,
      "end_ms": 62500,
      "text": "\"I didn't ask this church for permission to survive, Father.\"",
      "line_number": 146,
      "duration_ms": 4000
    },
    {
      "block_id": "EP046_B035",
      "episode_id": "EP046",
      "file_index": 34,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:02.80",
      "end_raw": "01:05.80",
      "start_ms": 62800,
      "end_ms": 65800,
      "text": "Medium two-shot of Juliana standing proudly beside Alexander.",
      "line_number": 150,
      "duration_ms": 3000
    },
    {
      "block_id": "EP046_B036",
      "episode_id": "EP046",
      "file_index": 35,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Passionate, Resolute)",
      "speaker": "JULIANA",
      "delivery": [
        "Passionate",
        "Resolute"
      ],
      "offscreen": null,
      "start_raw": "01:02.90",
      "end_raw": "01:05.50",
      "start_ms": 62900,
      "end_ms": 65500,
      "text": "\"I won't ask it for permission to love.\"",
      "line_number": 154,
      "duration_ms": 2600
    },
    {
      "block_id": "EP046_B037",
      "episode_id": "EP046",
      "file_index": 36,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:05.80",
      "end_raw": "01:11.00",
      "start_ms": 65800,
      "end_ms": 71000,
      "text": "Close-up of the High Priest looking down, a sinister, condescending smirk gracing his lips.",
      "line_number": 158,
      "duration_ms": 5200
    },
    {
      "block_id": "EP046_B038",
      "episode_id": "EP046",
      "file_index": 37,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Condescending, Venomous)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Condescending",
        "Venomous"
      ],
      "offscreen": null,
      "start_raw": "01:06.80",
      "end_raw": "01:10.50",
      "start_ms": 66800,
      "end_ms": 70500,
      "text": "\"Love doesn't make a Duchess, girl. Paper does.\"",
      "line_number": 162,
      "duration_ms": 3700
    },
    {
      "block_id": "EP046_B039",
      "episode_id": "EP046",
      "file_index": 38,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:11.00",
      "end_raw": "01:16.80",
      "start_ms": 71000,
      "end_ms": 76800,
      "text": "Slow push-in medium close-up on Juliana, her voice trembling with intense indignation.",
      "line_number": 166,
      "duration_ms": 5800
    },
    {
      "block_id": "EP046_B040",
      "episode_id": "EP046",
      "file_index": 39,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Accusatory, Pained)",
      "speaker": "JULIANA",
      "delivery": [
        "Accusatory",
        "Pained"
      ],
      "offscreen": null,
      "start_raw": "01:11.40",
      "end_raw": "01:14.30",
      "start_ms": 71400,
      "end_ms": 74300,
      "text": "\"Then look at this floor honestly, for once.\"",
      "line_number": 170,
      "duration_ms": 2900
    },
    {
      "block_id": "EP046_B041",
      "episode_id": "EP046",
      "file_index": 40,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Voice Breaking, Passionate)",
      "speaker": "JULIANA",
      "delivery": [
        "Voice Breaking",
        "Passionate"
      ],
      "offscreen": null,
      "start_raw": "01:14.40",
      "end_raw": "01:16.60",
      "start_ms": 74400,
      "end_ms": 76600,
      "text": "\"A church called me unworthy.\"",
      "line_number": 174,
      "duration_ms": 2200
    },
    {
      "block_id": "EP046_B042",
      "episode_id": "EP046",
      "file_index": 41,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:16.80",
      "end_raw": "01:18.00",
      "start_ms": 76800,
      "end_ms": 78000,
      "text": "Quick cut to the High Priest maintaining a smug, impenetrable stare.",
      "line_number": 178,
      "duration_ms": 1200
    },
    {
      "block_id": "EP046_B043",
      "episode_id": "EP046",
      "file_index": 42,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (O.S.) (Bitter)",
      "speaker": "JULIANA",
      "delivery": [
        "Bitter"
      ],
      "offscreen": "O.S.",
      "start_raw": "01:16.80",
      "end_raw": "01:18.00",
      "start_ms": 76800,
      "end_ms": 78000,
      "text": "\"A church chained me.\"",
      "line_number": 182,
      "duration_ms": 1200
    },
    {
      "block_id": "EP046_B044",
      "episode_id": "EP046",
      "file_index": 43,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:18.00",
      "end_raw": "01:25.80",
      "start_ms": 78000,
      "end_ms": 85800,
      "text": "Extreme close-up on Juliana's face as she shouts at the priest.",
      "line_number": 186,
      "duration_ms": 7800
    },
    {
      "block_id": "EP046_B045",
      "episode_id": "EP046",
      "file_index": 44,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Furious, Resolute)",
      "speaker": "JULIANA",
      "delivery": [
        "Furious",
        "Resolute"
      ],
      "offscreen": null,
      "start_raw": "01:18.10",
      "end_raw": "01:21.00",
      "start_ms": 78100,
      "end_ms": 81000,
      "text": "\"Now a church calls my marriage a lie!\"",
      "line_number": 190,
      "duration_ms": 2900
    },
    {
      "block_id": "EP046_B046",
      "episode_id": "EP046",
      "file_index": 45,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Shouting, Triumphant)",
      "speaker": "JULIANA",
      "delivery": [
        "Shouting",
        "Triumphant"
      ],
      "offscreen": null,
      "start_raw": "01:21.10",
      "end_raw": "01:25.50",
      "start_ms": 81100,
      "end_ms": 85500,
      "text": "\"God married us, Father! You are just angry no one asked you first!\"",
      "line_number": 194,
      "duration_ms": 4400
    },
    {
      "block_id": "EP046_B047",
      "episode_id": "EP046",
      "file_index": 46,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:25.80",
      "end_raw": "01:29.20",
      "start_ms": 85800,
      "end_ms": 89200,
      "text": "Medium close-up of Catherine leaning against a stone archway, whispering with venomous mockery.",
      "line_number": 198,
      "duration_ms": 3400
    },
    {
      "block_id": "EP046_B048",
      "episode_id": "EP046",
      "file_index": 47,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "CATHERINE (Malicious, Taunting)",
      "speaker": "CATHERINE",
      "delivery": [
        "Malicious",
        "Taunting"
      ],
      "offscreen": null,
      "start_raw": "01:26.10",
      "end_raw": "01:29.00",
      "start_ms": 86100,
      "end_ms": 89000,
      "text": "\"Careful, healer. The floor isn't finished with you.\"",
      "line_number": 202,
      "duration_ms": 2900
    },
    {
      "block_id": "EP046_B049",
      "episode_id": "EP046",
      "file_index": 48,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:29.20",
      "end_raw": "01:32.50",
      "start_ms": 89200,
      "end_ms": 92500,
      "text": "Close-up of the High Priest pressing the document against his chest, his eyes darkening with anger.",
      "line_number": 206,
      "duration_ms": 3300
    },
    {
      "block_id": "EP046_B050",
      "episode_id": "EP046",
      "file_index": 49,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (O.S. / Low, Threatening)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "O.S. / Low",
        "Threatening"
      ],
      "offscreen": null,
      "start_raw": "01:29.30",
      "end_raw": "01:32.40",
      "start_ms": 89300,
      "end_ms": 92400,
      "text": "\"Careful, girl. You mistake my patience for weakness.\"",
      "line_number": 210,
      "duration_ms": 3100
    },
    {
      "block_id": "EP046_B051",
      "episode_id": "EP046",
      "file_index": 50,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:32.50",
      "end_raw": "01:36.00",
      "start_ms": 92500,
      "end_ms": 96000,
      "text": "Low-angle shot of the High Priest stepping up the altar steps toward them.",
      "line_number": 214,
      "duration_ms": 3500
    },
    {
      "block_id": "EP046_B052",
      "episode_id": "EP046",
      "file_index": 51,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Commanding, Severe)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Commanding",
        "Severe"
      ],
      "offscreen": null,
      "start_raw": "01:32.20",
      "end_raw": "01:36.20",
      "start_ms": 92200,
      "end_ms": 96200,
      "text": "\"God did not marry you. A frightened parishioner did, without leave, without license, without the Crown's blessing!\"",
      "line_number": 218,
      "duration_ms": 4000
    },
    {
      "block_id": "EP046_B053",
      "episode_id": "EP046",
      "file_index": 52,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:36.00",
      "end_raw": "01:36.80",
      "start_ms": 96000,
      "end_ms": 96800,
      "text": "Brief insert of Catherine smirking as she watches from the side.",
      "line_number": 222,
      "duration_ms": 800
    },
    {
      "block_id": "EP046_B054",
      "episode_id": "EP046",
      "file_index": 53,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:36.80",
      "end_raw": "01:40.50",
      "start_ms": 96800,
      "end_ms": 100500,
      "text": "Wide shot of the High Priest waving the letter overhead before the congregation.",
      "line_number": 226,
      "duration_ms": 3700
    },
    {
      "block_id": "EP046_B055",
      "episode_id": "EP046",
      "file_index": 54,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Booming, Threatening)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Booming",
        "Threatening"
      ],
      "offscreen": null,
      "start_raw": "01:36.80",
      "end_raw": "01:40.40",
      "start_ms": 96800,
      "end_ms": 100400,
      "text": "\"And I have the power to undo in one hearing what took you three years to steal!\"",
      "line_number": 230,
      "duration_ms": 3600
    },
    {
      "block_id": "EP046_B056",
      "episode_id": "EP046",
      "file_index": 55,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:40.50",
      "end_raw": "01:41.80",
      "start_ms": 100500,
      "end_ms": 101800,
      "text": "Close-up of Catherine listening eagerly.",
      "line_number": 234,
      "duration_ms": 1300
    },
    {
      "block_id": "EP046_B057",
      "episode_id": "EP046",
      "file_index": 56,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:41.80",
      "end_raw": "01:46.80",
      "start_ms": 101800,
      "end_ms": 106800,
      "text": "Profile medium shot of Alexander confronting the High Priest face-to-face at the foot of the altar.",
      "line_number": 238,
      "duration_ms": 5000
    },
    {
      "block_id": "EP046_B058",
      "episode_id": "EP046",
      "file_index": 57,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Cold, Resolute)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Cold",
        "Resolute"
      ],
      "offscreen": null,
      "start_raw": "01:41.80",
      "end_raw": "01:46.50",
      "start_ms": 101800,
      "end_ms": 106500,
      "text": "\"A Duke's marriage is judged by the Crown's peerage court, not by a parish priest's seal.\"",
      "line_number": 242,
      "duration_ms": 4700
    },
    {
      "block_id": "EP046_B059",
      "episode_id": "EP046",
      "file_index": 58,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:46.80",
      "end_raw": "01:51.80",
      "start_ms": 106800,
      "end_ms": 111800,
      "text": "Low-angle two-shot of the High Priest staring up into Alexander's imposing frame.",
      "line_number": 246,
      "duration_ms": 5000
    },
    {
      "block_id": "EP046_B060",
      "episode_id": "EP046",
      "file_index": 59,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Stern, Unflinching)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Stern",
        "Unflinching"
      ],
      "offscreen": null,
      "start_raw": "01:47.00",
      "end_raw": "01:51.50",
      "start_ms": 107000,
      "end_ms": 111500,
      "text": "\"The High Religious Council rules on matters of holy matrimony. That includes yours.\"",
      "line_number": 250,
      "duration_ms": 4500
    },
    {
      "block_id": "EP046_B061",
      "episode_id": "EP046",
      "file_index": 60,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:51.80",
      "end_raw": "01:58.50",
      "start_ms": 111800,
      "end_ms": 118500,
      "text": "Medium close-up of Alexander glaring with icy authority.",
      "line_number": 254,
      "duration_ms": 6700
    },
    {
      "block_id": "EP046_B062",
      "episode_id": "EP046",
      "file_index": 61,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Defiant, Commanding)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Defiant",
        "Commanding"
      ],
      "offscreen": null,
      "start_raw": "01:52.00",
      "end_raw": "01:58.20",
      "start_ms": 112000,
      "end_ms": 118200,
      "text": "\"Then let it prove that in ten days, before witnesses. Not with six halberds pointed at me in my own chapel.\"",
      "line_number": 258,
      "duration_ms": 6200
    },
    {
      "block_id": "EP046_B063",
      "episode_id": "EP046",
      "file_index": 62,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:58.50",
      "end_raw": "02:04.00",
      "start_ms": 118500,
      "end_ms": 124000,
      "text": "Wide profile two-shot of the High Priest and Alexander locked in an intense standoff before the altar.",
      "line_number": 262,
      "duration_ms": 5500
    },
    {
      "block_id": "EP046_B064",
      "episode_id": "EP046",
      "file_index": 63,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "HIGH PRIEST (Chilling, Victorious)",
      "speaker": "HIGH PRIEST",
      "delivery": [
        "Chilling",
        "Victorious"
      ],
      "offscreen": null,
      "start_raw": "01:58.80",
      "end_raw": "02:03.60",
      "start_ms": 118800,
      "end_ms": 123600,
      "text": "\"Ten days. And if the council rules against you, this county watches you lose her twice.\"",
      "line_number": 266,
      "duration_ms": 4800
    },
    {
      "block_id": "EP046_B065",
      "episode_id": "EP046",
      "file_index": 64,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Steely, Unfazed)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Steely",
        "Unfazed"
      ],
      "offscreen": null,
      "start_raw": "02:04.00",
      "end_raw": "02:06.50",
      "start_ms": 124000,
      "end_ms": 126500,
      "text": "\"I'll take that wager over your decree.\"",
      "line_number": 270,
      "duration_ms": 2500
    },
    {
      "block_id": "EP046_B066",
      "episode_id": "EP046",
      "file_index": 65,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "02:06.50",
      "end_raw": "02:07.20",
      "start_ms": 126500,
      "end_ms": 127200,
      "text": "Quick reaction shot of the elderly woman in the pew gripping her beads in distress.",
      "line_number": 274,
      "duration_ms": 700
    },
    {
      "block_id": "EP046_B067",
      "episode_id": "EP046",
      "file_index": 66,
      "scene_id": "EP046_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "02:07.20",
      "end_raw": "02:13.50",
      "start_ms": 127200,
      "end_ms": 133500,
      "text": "Wide shot from behind the guards as they surround Alexander and Juliana, halberds and swords pointed inches from Alexander's chest.",
      "line_number": 278,
      "duration_ms": 6300
    },
    {
      "block_id": "EP046_B068",
      "episode_id": "EP046",
      "file_index": 67,
      "scene_id": "EP046_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Thunderous, Imposing)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Thunderous",
        "Imposing"
      ],
      "offscreen": null,
      "start_raw": "02:07.20",
      "end_raw": "02:13.20",
      "start_ms": 127200,
      "end_ms": 133200,
      "text": "\"Lower them! Or explain to the Crown why its own bailiffs raised iron on the Duke it just confirmed!\"",
