      "start_raw": "00:06.50",
      "end_raw": "00:11.80",
      "start_ms": 6500,
      "end_ms": 11800,
      "text": "Medium shot of Lady Juliana gently lifting the frail, trembling hands of the Dowager Duchess resting atop the linen covers.",
      "line_number": 26,
      "duration_ms": 5300
    },
    {
      "block_id": "EP023_B005",
      "episode_id": "EP023",
      "file_index": 4,
