      "start_raw": "00:13.50",
      "end_raw": "00:16.00",
      "start_ms": 13500,
      "end_ms": 16000,
      "text": "\"How long has she been like this?\"",
      "line_number": 38,
      "duration_ms": 2500
    },
    {
