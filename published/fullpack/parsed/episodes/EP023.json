      "start_ms": 1800,
      "end_ms": 6500,
      "text": "Medium close-up of Prudence holding a brass candlestick with trembling hands, glancing nervously toward the doorway.",
      "line_number": 18,
      "duration_ms": 4700
    },
    {
      "block_id": "EP023_B003",
      "episode_id": "EP023",
      "file_index": 2,
      "scene_id": "EP023_S01",
      "block_type": "DIALOGUE",
