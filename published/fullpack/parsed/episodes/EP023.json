      "start_raw": "00:07.50",
      "end_raw": "00:11.80",
      "start_ms": 7500,
      "end_ms": 11800,
      "text": "Juliana cradles the Duchess's frail hands in hers, inspecting her fingers with furrowed brows.",
      "line_number": 30,
      "duration_ms": 4300
    },
    {
      "block_id": "EP023_B006",
      "episode_id": "EP023",
