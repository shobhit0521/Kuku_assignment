      "end_raw": "00:16.80",
      "start_ms": 11800,
      "end_ms": 16800,
      "text": "Close-up of the Duchess's fingertips, revealing pronounced dark, purplish-black discoloration beneath the nails.",
      "line_number": 34,
      "duration_ms": 5000
    },
    {
      "block_id": "EP023_B007",
      "episode_id": "EP023",
