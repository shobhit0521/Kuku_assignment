      "end_raw": "01:08.50",
      "start_ms": 62000,
      "end_ms": 68500,
      "text": "\"Weakness. Dry mouth. The discoloration beneath the nails. The slow wasting.\"",
      "line_number": 138,
      "duration_ms": 6500
    },
