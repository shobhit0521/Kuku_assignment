      "start_ms": 16800,
      "end_ms": 20000,
      "text": "Medium shot of Prudence leaning against the bedpost, tears glistening in her eyes.",
      "line_number": 42,
      "duration_ms": 3200
    },
    {
      "block_id": "EP023_B009",
      "episode_id": "EP023",
