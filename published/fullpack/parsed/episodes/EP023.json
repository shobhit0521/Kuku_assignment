      "start_raw": "00:01.80",
      "end_raw": "00:06.00",
      "start_ms": 1800,
      "end_ms": 6000,
      "text": "\"Juliana, we cannot stay for long. Someone will come.\"",
      "line_number": 22,
      "duration_ms": 4200
    },
    {
      "block_id": "EP023_B004",
      "episode_id": "EP023",
      "file_index": 3,
