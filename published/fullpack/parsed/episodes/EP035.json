      "start_raw": "00:28.50",
      "end_raw": "00:30.80",
      "start_ms": 28500,
      "end_ms": 30800,
      "text": "Alexander, wearing a rugged trench coat, his scarred face framed by long dark hair, stands studying an unfolded tactical map before snapping his head up in alarm.",
      "line_number": 88,
      "duration_ms": 2300
    },
    {
      "block_id": "EP035_B017",
      "episode_id": "EP035",
      "file_index": 16,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
