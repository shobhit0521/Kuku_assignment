      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:11.20",
      "end_raw": "00:13.00",
      "start_ms": 11200,
      "end_ms": 13000,
      "text": "Heavy stone grating and metallic latch clanging as the lock releases.",
      "line_number": 34,
      "duration_ms": 1800
    },
    {
      "block_id": "EP035_B007",
      "episode_id": "EP035",
      "file_index": 6,
      "scene_id": "EP035_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:13.00",
      "end_raw": "00:15.50",
      "start_ms": 13000,
      "end_ms": 15500,
      "text": "The heavy stone doorway swings inward, and the elderly woman ducks low, crawling through the opening into the cold night outside.",
      "line_number": 38,
      "duration_ms": 2500
    },
    {
      "block_id": "EP035_B008",
      "episode_id": "EP035",
      "file_index": 7,
      "scene_id": "EP035_S02",
      "block_type": "CAMERA",
