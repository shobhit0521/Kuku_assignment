      "start_raw": "00:30.80",
      "end_raw": "00:33.80",
      "start_ms": 30800,
      "end_ms": 33800,
      "text": "Medium shot of Alexander's mother stepping across the threshold, holding up her burning lantern, her eyes wide with shock.",
      "line_number": 92,
      "duration_ms": 3000
    },
    {
      "block_id": "EP035_B018",
      "episode_id": "EP035",
      "file_index": 17,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
