      "end_raw": "00:36.50",
      "start_ms": 33800,
      "end_ms": 36500,
      "text": "Extreme close-up on Alexander's scarred left cheek and wide, disbelieving blue eyes.",
      "line_number": 96,
      "duration_ms": 2700
    },
    {
      "block_id": "EP035_B019",
      "episode_id": "EP035",
      "file_index": 18,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:36.50",
      "end_raw": "00:40.50",
      "start_ms": 36500,
      "end_ms": 40500,
      "text": "Close-up on his mother's tear-streaked face as her chin trembles and tears spill down her cheeks.",
      "line_number": 100,
      "duration_ms": 4000
    },
    {
      "block_id": "EP035_B020",
      "episode_id": "EP035",
      "file_index": 19,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Sobbing, Stunned)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": [
        "Sobbing",
        "Stunned"
      ],
      "offscreen": null,
      "start_raw": "00:37.00",
      "end_raw": "00:40.00",
      "start_ms": 37000,
      "end_ms": 40000,
      "text": "\"Alexander!\"",
      "line_number": 104,
      "duration_ms": 3000
    },
    {
      "block_id": "EP035_B021",
      "episode_id": "EP035",
      "file_index": 20,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:40.50",
      "end_raw": "00:44.20",
      "start_ms": 40500,
      "end_ms": 44200,
      "text": "Close-up on Alexander as his hard expression crumbles into utter astonishment.",
      "line_number": 108,
      "duration_ms": 3700
    },
    {
      "block_id": "EP035_B022",
      "episode_id": "EP035",
      "file_index": 21,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Breathless, In Disbelief)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Breathless",
        "In Disbelief"
      ],
      "offscreen": null,
      "start_raw": "00:42.50",
      "end_raw": "00:44.20",
      "start_ms": 42500,
      "end_ms": 44200,
      "text": "\"Mother?\"",
      "line_number": 112,
      "duration_ms": 1700
    },
    {
      "block_id": "EP035_B023",
      "episode_id": "EP035",
      "file_index": 22,
      "scene_id": "EP035_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:44.20",
      "end_raw": "00:47.50",
      "start_ms": 44200,
      "end_ms": 47500,
      "text": "She drops her walking staff and rushes forward, throwing her arms around Alexander's neck. He pulls her tightly into his chest.",
      "line_number": 116,
      "duration_ms": 3300
    },
    {
      "block_id": "EP035_B024",
      "episode_id": "EP035",
      "file_index": 23,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Weeping, Overwhelmed)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": [
        "Weeping",
        "Overwhelmed"
      ],
      "offscreen": null,
      "start_raw": "00:45.50",
      "end_raw": "00:48.00",
      "start_ms": 45500,
      "end_ms": 48000,
      "text": "\"You're alive.\"",
      "line_number": 120,
      "duration_ms": 2500
    },
    {
      "block_id": "EP035_B025",
      "episode_id": "EP035",
      "file_index": 24,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Gentle, Choked Up)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Gentle",
        "Choked Up"
      ],
      "offscreen": null,
      "start_raw": "00:48.00",
      "end_raw": "00:49.80",
      "start_ms": 48000,
      "end_ms": 49800,
      "text": "\"Mother.\"",
      "line_number": 124,
      "duration_ms": 1800
    },
    {
      "block_id": "EP035_B026",
      "episode_id": "EP035",
      "file_index": 25,
      "scene_id": "EP035_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:50.00",
      "end_raw": "00:55.50",
      "start_ms": 50000,
      "end_ms": 55500,
      "text": "She leans back slightly, her frail hand reaching up to gently cup his bearded, scarred cheek, staring into his eyes in disbelief.",
      "line_number": 128,
      "duration_ms": 5500
    },
    {
      "block_id": "EP035_B027",
      "episode_id": "EP035",
      "file_index": 26,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Tearful, Heartbroken)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": [
        "Tearful",
        "Heartbroken"
      ],
      "offscreen": null,
      "start_raw": "00:52.50",
      "end_raw": "00:55.00",
      "start_ms": 52500,
      "end_ms": 55000,
      "text": "\"I buried you.\"",
      "line_number": 132,
      "duration_ms": 2500
    },
    {
      "block_id": "EP035_B028",
      "episode_id": "EP035",
      "file_index": 27,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Soft, Somber)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Soft",
        "Somber"
      ],
      "offscreen": null,
      "start_raw": "00:56.50",
      "end_raw": "00:58.00",
      "start_ms": 56500,
      "end_ms": 58000,
      "text": "\"I know.\"",
      "line_number": 136,
      "duration_ms": 1500
    },
    {
      "block_id": "EP035_B029",
      "episode_id": "EP035",
      "file_index": 28,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Anguished, Accusing)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": [
        "Anguished",
        "Accusing"
      ],
      "offscreen": null,
      "start_raw": "00:59.50",
      "end_raw": "01:06.00",
      "start_ms": 59500,
      "end_ms": 66000,
      "text": "\"They told me you died. They told me your entire regiment was destroyed.\"",
      "line_number": 140,
      "duration_ms": 6500
    },
    {
      "block_id": "EP035_B030",
      "episode_id": "EP035",
      "file_index": 29,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:06.50",
      "end_raw": "01:11.00",
      "start_ms": 66500,
      "end_ms": 71000,
      "text": "Close-up on Alexander's hardened, shadowed profile, his jaw tight with grim memories.",
      "line_number": 144,
      "duration_ms": 4500
    },
