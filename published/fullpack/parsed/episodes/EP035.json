      "start_raw": "00:27.50",
      "end_raw": "00:30.80",
      "start_ms": 27500,
      "end_ms": 30800,
      "text": "Panning shot from the open doorway revealing the warm, dimly lit cabin interior, settling on Alexander standing over a rustic wooden table by lantern light.",
      "line_number": 84,
      "duration_ms": 3300
    },
    {
      "block_id": "EP035_B016",
      "episode_id": "EP035",
      "file_index": 15,
      "scene_id": "EP035_S03",
      "block_type": "ACTION",
