      "start_raw": "01:08.50",
      "end_raw": "01:10.80",
      "start_ms": 68500,
      "end_ms": 70800,
      "text": "\"Most of them were.\"",
      "line_number": 148,
      "duration_ms": 2300
    },
    {
      "block_id": "EP035_B032",
      "episode_id": "EP035",
      "file_index": 31,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Searching, Desperate)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": [
        "Searching",
        "Desperate"
      ],
      "offscreen": null,
      "start_raw": "01:11.50",
      "end_raw": "01:14.00",
      "start_ms": 71500,
      "end_ms": 74000,
      "text": "\"Then how did you survive?\"",
      "line_number": 152,
      "duration_ms": 2500
    },
    {
      "block_id": "EP035_B033",
      "episode_id": "EP035",
      "file_index": 32,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:14.20",
      "end_raw": "01:18.00",
      "start_ms": 74200,
      "end_ms": 78000,
      "text": "Side profile of Alexander as his eyes look into the distance, haunted by the past.",
      "line_number": 156,
      "duration_ms": 3800
    },
    {
      "block_id": "EP035_B034",
      "episode_id": "EP035",
      "file_index": 33,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Grim, Quiet)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Grim",
        "Quiet"
      ],
      "offscreen": null,
      "start_raw": "01:15.00",
      "end_raw": "01:17.50",
      "start_ms": 75000,
      "end_ms": 77500,
      "text": "\"I wasn't supposed to.\"",
      "line_number": 160,
      "duration_ms": 2500
    },
    {
      "block_id": "EP035_B035",
      "episode_id": "EP035",
      "file_index": 34,
      "scene_id": "EP035_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:18.00",
      "end_raw": "01:22.50",
      "start_ms": 78000,
      "end_ms": 82500,
      "text": "Alexander steps over to the wooden table, looking down at the parchment map spread out under the lantern.",
      "line_number": 164,
      "duration_ms": 4500
    },
    {
      "block_id": "EP035_B036",
      "episode_id": "EP035",
      "file_index": 35,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Solemn)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Solemn"
      ],
      "offscreen": null,
      "start_raw": "01:19.00",
      "end_raw": "01:23.00",
      "start_ms": 79000,
      "end_ms": 83000,
      "text": "\"Three years ago, I was sent to the Iberian front.\"",
      "line_number": 168,
      "duration_ms": 4000
    },
    {
      "block_id": "EP035_B037",
      "episode_id": "EP035",
      "file_index": 36,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:23.00",
      "end_raw": "01:27.00",
      "start_ms": 83000,
      "end_ms": 87000,
      "text": "Close-up of Alexander's weathered face looking down pensively as he recounts the mission.",
      "line_number": 172,
      "duration_ms": 4000
    },
    {
      "block_id": "EP035_B038",
      "episode_id": "EP035",
      "file_index": 37,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Steady, Focused)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Steady",
        "Focused"
      ],
      "offscreen": null,
      "start_raw": "01:23.00",
      "end_raw": "01:29.00",
      "start_ms": 83000,
      "end_ms": 89000,
      "text": "\"It was a classified Crown mission. We were investigating a British officer selling military secrets to French spies.\"",
      "line_number": 176,
      "duration_ms": 6000
    },
    {
      "block_id": "EP035_B039",
      "episode_id": "EP035",
      "file_index": 38,
      "scene_id": "EP035_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:27.00",
      "end_raw": "01:29.80",
      "start_ms": 87000,
      "end_ms": 89800,
      "text": "Alexander's scarred finger points to a red-circled location on the parchment map marked near Madrid.",
      "line_number": 180,
      "duration_ms": 2800
    },
    {
      "block_id": "EP035_B040",
      "episode_id": "EP035",
      "file_index": 39,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:29.80",
      "end_raw": "01:32.00",
      "start_ms": 89800,
      "end_ms": 92000,
      "text": "Close-up on his mother, gasping with wide, horrified eyes.",
      "line_number": 184,
      "duration_ms": 2200
    },
    {
      "block_id": "EP035_B041",
      "episode_id": "EP035",
      "file_index": 40,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Shocked)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": [
        "Shocked"
      ],
      "offscreen": null,
      "start_raw": "01:29.80",
      "end_raw": "01:31.50",
      "start_ms": 89800,
      "end_ms": 91500,
      "text": "\"A traitor?\"",
      "line_number": 188,
      "duration_ms": 1700
    },
    {
      "block_id": "EP035_B042",
      "episode_id": "EP035",
      "file_index": 41,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Cold, Firm)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Cold",
        "Firm"
      ],
      "offscreen": null,
      "start_raw": "01:32.00",
      "end_raw": "01:33.20",
      "start_ms": 92000,
      "end_ms": 93200,
      "text": "\"Yes.\"",
      "line_number": 192,
      "duration_ms": 1200
    },
    {
      "block_id": "EP035_B043",
      "episode_id": "EP035",
      "file_index": 42,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:33.50",
      "end_raw": "01:37.50",
      "start_ms": 93500,
      "end_ms": 97500,
      "text": "Medium shot framing both of them across the wooden table bathed in amber lantern glow.",
      "line_number": 196,
      "duration_ms": 4000
    },
    {
      "block_id": "EP035_B044",
      "episode_id": "EP035",
      "file_index": 43,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Grave)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Grave"
      ],
      "offscreen": null,
      "start_raw": "01:34.50",
      "end_raw": "01:37.00",
      "start_ms": 94500,
      "end_ms": 97000,
      "text": "\"We were close to finding him.\"",
      "line_number": 200,
      "duration_ms": 2500
    },
    {
      "block_id": "EP035_B045",
      "episode_id": "EP035",
      "file_index": 44,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Hardened)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Hardened"
      ],
      "offscreen": null,
      "start_raw": "01:38.50",
      "end_raw": "01:41.00",
      "start_ms": 98500,
      "end_ms": 101000,
      "text": "\"Then came the ambush.\"",
      "line_number": 204,
      "duration_ms": 2500
    },
    {
      "block_id": "EP035_B046",
      "episode_id": "EP035",
      "file_index": 45,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:41.20",
      "end_raw": "01:44.20",
      "start_ms": 101200,
      "end_ms": 104200,
      "text": "Close-up on Alexander's scarred hand clenching into a fist, furiously crumbling the parchment map beneath his knuckles.",
      "line_number": 208,
      "duration_ms": 3000
    },
    {
      "block_id": "EP035_B047",
      "episode_id": "EP035",
      "file_index": 46,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Bitter, Painful)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Bitter",
        "Painful"
      ],
      "offscreen": null,
      "start_raw": "01:41.50",
      "end_raw": "01:44.20",
      "start_ms": 101500,
      "end_ms": 104200,
      "text": "\"My men were slaughtered.\"",
      "line_number": 212,
      "duration_ms": 2700
    },
    {
      "block_id": "EP035_B048",
      "episode_id": "EP035",
      "file_index": 47,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:44.20",
      "end_raw": "01:46.50",
      "start_ms": 104200,
      "end_ms": 106500,
      "text": "Close-up of his mother clutching at her throat, tears glistening in her eyes.",
      "line_number": 216,
      "duration_ms": 2300
    },
    {
      "block_id": "EP035_B049",
      "episode_id": "EP035",
      "file_index": 48,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Trembling, Anxious)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": [
        "Trembling",
        "Anxious"
      ],
      "offscreen": null,
      "start_raw": "01:44.50",
      "end_raw": "01:46.00",
      "start_ms": 104500,
      "end_ms": 106000,
      "text": "\"And you?\"",
      "line_number": 220,
      "duration_ms": 1500
    },
    {
      "block_id": "EP035_B050",
      "episode_id": "EP035",
      "file_index": 49,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Hollow)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Hollow"
      ],
      "offscreen": null,
      "start_raw": "01:47.00",
      "end_raw": "01:50.00",
      "start_ms": 107000,
      "end_ms": 110000,
      "text": "\"I was shot. Left for dead.\"",
      "line_number": 224,
      "duration_ms": 3000
    },
    {
      "block_id": "EP035_B051",
      "episode_id": "EP035",
      "file_index": 50,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:50.00",
      "end_raw": "01:53.50",
      "start_ms": 110000,
      "end_ms": 113500,
      "text": "Medium shot of his mother placing both hands on the table, leaning forward in disbelief.",
      "line_number": 228,
      "duration_ms": 3500
    },
    {
      "block_id": "EP035_B052",
      "episode_id": "EP035",
      "file_index": 51,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Pleading, Astonished)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": [
        "Pleading",
        "Astonished"
      ],
      "offscreen": null,
      "start_raw": "01:51.00",
      "end_raw": "01:53.00",
      "start_ms": 111000,
      "end_ms": 113000,
      "text": "\"How did you escape?\"",
      "line_number": 232,
      "duration_ms": 2000
    },
    {
      "block_id": "EP035_B053",
      "episode_id": "EP035",
      "file_index": 52,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:53.50",
      "end_raw": "01:58.00",
      "start_ms": 113500,
      "end_ms": 118000,
      "text": "Close-up on Alexander, his eyes dark with the harrowing memory.",
      "line_number": 236,
      "duration_ms": 4500
    },
    {
      "block_id": "EP035_B054",
      "episode_id": "EP035",
      "file_index": 53,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Somber, Low)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Somber",
        "Low"
      ],
      "offscreen": null,
      "start_raw": "01:54.00",
      "end_raw": "01:58.00",
      "start_ms": 114000,
      "end_ms": 118000,
      "text": "\"I crawled away from the battlefield, half dead, alone.\"",
      "line_number": 240,
      "duration_ms": 4000
    },
    {
      "block_id": "EP035_B055",
      "episode_id": "EP035",
      "file_index": 54,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Continuing)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Continuing"
      ],
      "offscreen": null,
      "start_raw": "01:58.20",
      "end_raw": "02:02.00",
      "start_ms": 118200,
      "end_ms": 122000,
      "text": "\"I survived because the men who came looking for me believed I was already dead.\"",
      "line_number": 244,
      "duration_ms": 3800
    },
    {
      "block_id": "EP035_B056",
      "episode_id": "EP035",
      "file_index": 55,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "02:02.00",
      "end_raw": "02:05.50",
      "start_ms": 122000,
      "end_ms": 125500,
      "text": "Close-up on his mother as her expression shifts to profound bewilderment and outrage.",
      "line_number": 248,
      "duration_ms": 3500
    },
    {
      "block_id": "EP035_B057",
      "episode_id": "EP035",
      "file_index": 56,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Aghast, Stunned)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": [
        "Aghast",
        "Stunned"
      ],
      "offscreen": null,
      "start_raw": "02:02.00",
      "end_raw": "02:05.50",
      "start_ms": 122000,
      "end_ms": 125500,
      "text": "\"Then why did they never tell us?\"",
      "line_number": 252,
      "duration_ms": 3500
    },
    {
      "block_id": "EP035_B058",
      "episode_id": "EP035",
      "file_index": 57,
      "scene_id": "EP035_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "02:05.50",
      "end_raw": "02:09.50",
      "start_ms": 125500,
      "end_ms": 129500,
      "text": "Close-up on Alexander's intense, piercing gaze.",
      "line_number": 256,
      "duration_ms": 4000
    },
    {
      "block_id": "EP035_B059",
      "episode_id": "EP035",
      "file_index": 58,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Ominous, Deliberate)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Ominous",
        "Deliberate"
      ],
      "offscreen": null,
      "start_raw": "02:06.00",
      "end_raw": "02:09.50",
      "start_ms": 126000,
      "end_ms": 129500,
      "text": "\"Because someone wanted you to believe I was dead.\"",
      "line_number": 260,
      "duration_ms": 3500
    },
    {
      "block_id": "EP035_B060",
      "episode_id": "EP035",
      "file_index": 59,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Breathless)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": [
        "Breathless"
      ],
      "offscreen": null,
      "start_raw": "02:09.50",
      "end_raw": "02:10.50",
      "start_ms": 129500,
      "end_ms": 130500,
      "text": "\"Who?\"",
      "line_number": 264,
      "duration_ms": 1000
    },
    {
      "block_id": "EP035_B061",
      "episode_id": "EP035",
      "file_index": 60,
      "scene_id": "EP035_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "02:10.50",
      "end_raw": "02:14.00",
      "start_ms": 130500,
      "end_ms": 134000,
      "text": "Alexander turns away toward the frosted window, staring out into the dark raging blizzard outside.",
      "line_number": 268,
      "duration_ms": 3500
    },
    {
      "block_id": "EP035_B062",
      "episode_id": "EP035",
      "file_index": 61,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Brooding)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Brooding"
      ],
      "offscreen": null,
      "start_raw": "02:11.00",
      "end_raw": "02:14.00",
      "start_ms": 131000,
      "end_ms": 134000,
      "text": "\"I spent three years trying to find out.\"",
      "line_number": 272,
      "duration_ms": 3000
    },
    {
      "block_id": "EP035_B063",
      "episode_id": "EP035",
      "file_index": 62,
      "scene_id": "EP035_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "02:14.00",
      "end_raw": "02:16.80",
      "start_ms": 134000,
      "end_ms": 136800,
      "text": "Alexander abruptly pushes away from the window, storming back toward the table with burning rage.",
      "line_number": 276,
      "duration_ms": 2800
    },
    {
      "block_id": "EP035_B064",
      "episode_id": "EP035",
      "file_index": 63,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Fierce, Resolute)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Fierce",
        "Resolute"
      ],
      "offscreen": null,
      "start_raw": "02:14.00",
      "end_raw": "02:17.00",
      "start_ms": 134000,
      "end_ms": 137000,
      "text": "\"The ambush was not an accident.\"",
      "line_number": 280,
      "duration_ms": 3000
    },
    {
      "block_id": "EP035_B065",
      "episode_id": "EP035",
      "file_index": 64,
      "scene_id": "EP035_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "02:17.00",
      "end_raw": "02:24.00",
      "start_ms": 137000,
      "end_ms": 144000,
      "text": "He leans heavily over the wooden table, looming close as his fury boils over.",
      "line_number": 284,
      "duration_ms": 7000
    },
    {
      "block_id": "EP035_B066",
      "episode_id": "EP035",
      "file_index": 65,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Vehement, Enraged)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Vehement",
        "Enraged"
      ],
      "offscreen": null,
      "start_raw": "02:17.00",
      "end_raw": "02:20.50",
      "start_ms": 137000,
      "end_ms": 140500,
      "text": "\"Someone ordered my men to die.\"",
      "line_number": 288,
      "duration_ms": 3500
    },
    {
      "block_id": "EP035_B067",
      "episode_id": "EP035",
      "file_index": 66,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER (Darkly Intimating)",
      "speaker": "ALEXANDER",
      "delivery": [
        "Darkly Intimating"
      ],
      "offscreen": null,
      "start_raw": "02:21.00",
      "end_raw": "02:24.00",
      "start_ms": 141000,
      "end_ms": 144000,
      "text": "\"Someone wanted me erased.\"",
      "line_number": 292,
      "duration_ms": 3000
    },
    {
      "block_id": "EP035_B068",
      "episode_id": "EP035",
      "file_index": 67,
      "scene_id": "EP035_S03",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Gasping, Terrified)",
