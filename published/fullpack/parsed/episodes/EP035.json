      "start_raw": "00:15.50",
      "end_raw": "00:19.50",
      "start_ms": 15500,
      "end_ms": 19500,
      "text": "Wide atmospheric shot of a deep, snow-covered pine forest at night. In the distance stands a small secluded log cabin nestled under towering snowy trees.",
      "line_number": 49,
      "duration_ms": 4000
    },
    {
      "block_id": "EP035_B009",
      "episode_id": "EP035",
      "file_index": 8,
      "scene_id": "EP035_S02",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:15.50",
      "end_raw": "00:19.50",
      "start_ms": 15500,
      "end_ms": 19500,
      "text": "Alexander's mother plods through the thick snow, leaning heavily on a wooden walking stick, her dark cloak dusted with snow.",
      "line_number": 53,
      "duration_ms": 4000
    },
    {
      "block_id": "EP035_B010",
      "episode_id": "EP035",
      "file_index": 9,
      "scene_id": "EP035_S02",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
