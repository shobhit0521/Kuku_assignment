      "start_ms": 0,
      "end_ms": 5200,
      "text": "Medium tracking shot following an elderly hooded woman clutching an iron lantern as she stumbles anxiously through a damp subterranean stone tunnel.",
      "line_number": 14,
      "duration_ms": 5200
    },
    {
      "block_id": "EP035_B002",
      "episode_id": "EP035",
      "file_index": 1,
      "scene_id": "EP035_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:05.20",
      "start_ms": 0,
      "end_ms": 5200,
      "text": "Alexander's mother, frail with silver hair under a dark hooded cloak, braces her hand against the rough stone wall, panting heavily in fear.",
      "line_number": 18,
      "duration_ms": 5200
    },
    {
      "block_id": "EP035_B003",
      "episode_id": "EP035",
      "file_index": 2,
      "scene_id": "EP035_S01",
      "block_type": "DIALOGUE",
      "label_raw": "ALEXANDER'S MOTHER (Determined, Breathless)",
      "speaker": "ALEXANDER'S MOTHER",
      "delivery": [
        "Determined",
        "Breathless"
      ],
      "offscreen": null,
      "start_raw": "00:05.50",
      "end_raw": "00:08.50",
      "start_ms": 5500,
      "end_ms": 8500,
      "text": "\"I will not die in that house.\"",
      "line_number": 22,
      "duration_ms": 3000
    },
    {
      "block_id": "EP035_B004",
      "episode_id": "EP035",
      "file_index": 3,
      "scene_id": "EP035_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:09.00",
      "end_raw": "00:12.80",
      "start_ms": 9000,
      "end_ms": 12800,
      "text": "Close-up on her trembling, weathered hands gripping a mossy stone bolt set into a heavy iron plate on the stone wall.",
      "line_number": 26,
      "duration_ms": 3800
    },
    {
      "block_id": "EP035_B005",
      "episode_id": "EP035",
      "file_index": 4,
      "scene_id": "EP035_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:09.50",
      "end_raw": "00:12.80",
      "start_ms": 9500,
      "end_ms": 12800,
      "text": "She uses all her strength to shove the stone bolt upward, disengaging the hidden lock mechanism.",
      "line_number": 30,
      "duration_ms": 3300
    },
    {
      "block_id": "EP035_B006",
      "episode_id": "EP035",
      "file_index": 5,
      "scene_id": "EP035_S01",
      "block_type": "SOUND_FX",
