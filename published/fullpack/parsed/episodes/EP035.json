      "start_raw": "00:16.00",
      "end_raw": "00:19.50",
      "start_ms": 16000,
      "end_ms": 19500,
      "text": "Howling winter wind and crunching of footsteps in deep snow.",
      "line_number": 57,
      "duration_ms": 3500
    },
    {
      "block_id": "EP035_B011",
      "episode_id": "EP035",
      "file_index": 10,
