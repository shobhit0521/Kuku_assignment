      "offscreen": null,
      "start_raw": "00:01.80",
      "end_raw": "00:02.80",
      "start_ms": 1800,
      "end_ms": 2800,
      "text": "\"Wait.\"",
      "line_number": 22,
      "duration_ms": 1000
    },
    {
      "block_id": "EP041_B004",
      "episode_id": "EP041",
      "file_index": 3,
