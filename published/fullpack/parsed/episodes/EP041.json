      "end_raw": "00:04.50",
      "start_ms": 1800,
      "end_ms": 4500,
      "text": "Catherine abruptly pulls away from Rupert and raises her white-gloved hand high, commanding silence from the congregation.",
      "line_number": 18,
      "duration_ms": 2700
    },
    {
      "block_id": "EP041_B003",
      "episode_id": "EP041",
