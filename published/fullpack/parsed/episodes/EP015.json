      "delivery": [],
      "offscreen": null,
      "start_raw": "00:03.50",
      "end_raw": "00:05.00",
      "start_ms": 3500,
      "end_ms": 5000,
      "text": "Low-angle medium shot focusing on one thug raising a heavy wooden club overhead.",
      "line_number": 22,
      "duration_ms": 1500
    },
    {
      "block_id": "EP015_B004",
      "episode_id": "EP015",
      "file_index": 3,
      "scene_id": "EP015_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:03.60",
      "end_raw": "00:04.90",
      "start_ms": 3600,
      "end_ms": 4900,
      "text": "The thug brutally smashes his club down into a wooden planter box, shattering the frame.",
      "line_number": 26,
      "duration_ms": 1300
    },
    {
      "block_id": "EP015_B005",
      "episode_id": "EP015",
      "file_index": 4,
      "scene_id": "EP015_S01",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:03.80",
      "end_raw": "00:04.90",
      "start_ms": 3800,
      "end_ms": 4900,
      "text": "A splintering wooden crash echoing through the night air.",
      "line_number": 30,
      "duration_ms": 1100
    },
    {
      "block_id": "EP015_B006",
      "episode_id": "EP015",
      "file_index": 5,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:05.00",
      "end_raw": "00:07.50",
      "start_ms": 5000,
      "end_ms": 7500,
      "text": "Medium close-up of a bald thug leaning over a lush bed of white medicinal chamomile herbs.",
      "line_number": 34,
      "duration_ms": 2500
    },
    {
      "block_id": "EP015_B007",
      "episode_id": "EP015",
      "file_index": 6,
      "scene_id": "EP015_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:05.10",
      "end_raw": "00:07.40",
      "start_ms": 5100,
      "end_ms": 7400,
      "text": "The bald thug roughly rips a massive handful of flowering herbs up by their roots, scattering soil across the path.",
      "line_number": 38,
      "duration_ms": 2300
    },
    {
      "block_id": "EP015_B008",
      "episode_id": "EP015",
      "file_index": 7,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:07.50",
      "end_raw": "00:11.80",
      "start_ms": 7500,
      "end_ms": 11800,
      "text": "Medium shot framing the open doorway of the stone cottage, bathed in warm interior light against the dark night.",
      "line_number": 42,
      "duration_ms": 4300
    },
    {
      "block_id": "EP015_B009",
      "episode_id": "EP015",
      "file_index": 8,
      "scene_id": "EP015_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:07.60",
      "end_raw": "00:11.80",
      "start_ms": 7600,
      "end_ms": 11800,
      "text": "Juliana bursts through the cottage doorway, her hands wrapped in clean white bandages, freezing in horror at the destruction.",
      "line_number": 46,
      "duration_ms": 4200
    },
    {
      "block_id": "EP015_B010",
      "episode_id": "EP015",
      "file_index": 9,
      "scene_id": "EP015_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Desperate, Alarmed)",
      "speaker": "JULIANA",
      "delivery": [
        "Desperate",
        "Alarmed"
      ],
      "offscreen": null,
      "start_raw": "00:08.50",
      "end_raw": "00:11.70",
      "start_ms": 8500,
      "end_ms": 11700,
      "text": "\"Stop! What are you doing?!\"",
      "line_number": 50,
      "duration_ms": 3200
    },
    {
      "block_id": "EP015_B011",
      "episode_id": "EP015",
      "file_index": 10,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:11.80",
      "end_raw": "00:15.80",
      "start_ms": 11800,
      "end_ms": 15800,
      "text": "Medium close-up of the Thug with Cap holding the uprooted chamomile bouquet, sneering with cruel amusement.",
      "line_number": 54,
      "duration_ms": 4000
    },
    {
      "block_id": "EP015_B012",
      "episode_id": "EP015",
      "file_index": 11,
      "scene_id": "EP015_S01",
      "block_type": "DIALOGUE",
      "label_raw": "THUG WITH CAP (Mocking, Smug)",
      "speaker": "THUG WITH CAP",
      "delivery": [
        "Mocking",
        "Smug"
      ],
      "offscreen": null,
      "start_raw": "00:13.00",
      "end_raw": "00:15.70",
      "start_ms": 13000,
      "end_ms": 15700,
      "text": "\"We're clearing this rubbish.\"",
      "line_number": 58,
      "duration_ms": 2700
    },
    {
      "block_id": "EP015_B013",
      "episode_id": "EP015",
      "file_index": 12,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:15.80",
      "end_raw": "00:18.80",
      "start_ms": 15800,
      "end_ms": 18800,
      "text": "Close-up on Juliana, her face tight with anguish and fury as she clutches her bandaged hands against her chest.",
      "line_number": 62,
      "duration_ms": 3000
    },
    {
      "block_id": "EP015_B014",
      "episode_id": "EP015",
      "file_index": 13,
      "scene_id": "EP015_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Furious, Pleading)",
      "speaker": "JULIANA",
      "delivery": [
        "Furious",
        "Pleading"
      ],
      "offscreen": null,
      "start_raw": "00:16.40",
      "end_raw": "00:18.70",
      "start_ms": 16400,
      "end_ms": 18700,
      "text": "\"Those are medicinal plants!\"",
      "line_number": 66,
      "duration_ms": 2300
    },
    {
      "block_id": "EP015_B015",
      "episode_id": "EP015",
      "file_index": 14,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:18.80",
      "end_raw": "00:22.50",
      "start_ms": 18800,
      "end_ms": 22500,
      "text": "Low-angle shot tracking down from the bald thug's grinning face to his worn leather boots on the muddy flagstones.",
      "line_number": 70,
      "duration_ms": 3700
    },
    {
      "block_id": "EP015_B016",
      "episode_id": "EP015",
      "file_index": 15,
      "scene_id": "EP015_S01",
      "block_type": "DIALOGUE",
      "label_raw": "BALD THUG (Callous)",
      "speaker": "BALD THUG",
      "delivery": [
        "Callous"
      ],
      "offscreen": null,
      "start_raw": "00:20.00",
      "end_raw": "00:22.30",
      "start_ms": 20000,
      "end_ms": 22300,
      "text": "\"They look like weeds to me.\"",
      "line_number": 74,
      "duration_ms": 2300
    },
    {
      "block_id": "EP015_B017",
      "episode_id": "EP015",
      "file_index": 16,
      "scene_id": "EP015_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:20.50",
      "end_raw": "00:22.50",
      "start_ms": 20500,
      "end_ms": 22500,
      "text": "The bald thug flings the bouquet into the mud and grinds his heavy boot directly onto the delicate flowers.",
      "line_number": 78,
      "duration_ms": 2000
    },
    {
      "block_id": "EP015_B018",
      "episode_id": "EP015",
      "file_index": 17,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:22.50",
      "end_raw": "00:26.80",
      "start_ms": 22500,
      "end_ms": 26800,
      "text": "High-angle two-shot as Juliana rushes forward and drops directly onto her knees in the cold mud before the thug.",
      "line_number": 82,
      "duration_ms": 4300
    },
    {
      "block_id": "EP015_B019",
      "episode_id": "EP015",
      "file_index": 18,
      "scene_id": "EP015_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:22.80",
      "end_raw": "00:26.50",
      "start_ms": 22800,
      "end_ms": 26500,
      "text": "Juliana frantically tries to scoop the crushed soil and torn stems back into the bed with her bandaged hands.",
      "line_number": 86,
      "duration_ms": 3700
    },
    {
      "block_id": "EP015_B020",
      "episode_id": "EP015",
      "file_index": 19,
      "scene_id": "EP015_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Choked with Tears, Desperate)",
      "speaker": "JULIANA",
      "delivery": [
        "Choked with Tears",
        "Desperate"
      ],
      "offscreen": null,
      "start_raw": "00:23.20",
      "end_raw": "00:26.30",
      "start_ms": 23200,
      "end_ms": 26300,
      "text": "\"Please! Those plants took months to grow!\"",
      "line_number": 90,
      "duration_ms": 3100
    },
    {
      "block_id": "EP015_B021",
      "episode_id": "EP015",
      "file_index": 20,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:26.80",
      "end_raw": "00:31.50",
      "start_ms": 26800,
      "end_ms": 31500,
      "text": "Medium two-shot of the Tall Thug with the club and the Thug with Cap bursting into raucous laughter under the full moon.",
      "line_number": 94,
      "duration_ms": 4700
    },
    {
      "block_id": "EP015_B022",
      "episode_id": "EP015",
      "file_index": 21,
      "scene_id": "EP015_S01",
      "block_type": "DIALOGUE",
      "label_raw": "TALL THUG (Contemptuous, Derisive)",
      "speaker": "TALL THUG",
      "delivery": [
        "Contemptuous",
        "Derisive"
      ],
      "offscreen": null,
      "start_raw": "00:27.50",
      "end_raw": "00:31.20",
      "start_ms": 27500,
      "end_ms": 31200,
      "text": "\"Months? You actually spend your days growing this filth?\"",
      "line_number": 98,
      "duration_ms": 3700
    },
    {
      "block_id": "EP015_B023",
      "episode_id": "EP015",
      "file_index": 22,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:31.50",
      "end_raw": "00:34.00",
      "start_ms": 31500,
      "end_ms": 34000,
      "text": "Tight close-up of Juliana's bandaged hands trembling as she tenderly gathers the soiled white flowers from the puddles.",
      "line_number": 102,
      "duration_ms": 2500
    },
    {
      "block_id": "EP015_B024",
      "episode_id": "EP015",
      "file_index": 23,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:34.00",
      "end_raw": "00:37.00",
      "start_ms": 34000,
      "end_ms": 37000,
      "text": "Low-angle medium shot tilting up as Juliana rises from the ground, standing tall despite her trembling frame.",
      "line_number": 106,
      "duration_ms": 3000
    },
    {
      "block_id": "EP015_B025",
      "episode_id": "EP015",
      "file_index": 24,
      "scene_id": "EP015_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Defiant, Firm)",
      "speaker": "JULIANA",
      "delivery": [
        "Defiant",
        "Firm"
      ],
      "offscreen": null,
      "start_raw": "00:34.80",
      "end_raw": "00:36.80",
      "start_ms": 34800,
      "end_ms": 36800,
      "text": "\"Leave my garden alone.\"",
      "line_number": 110,
      "duration_ms": 2000
    },
    {
      "block_id": "EP015_B026",
      "episode_id": "EP015",
      "file_index": 25,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:37.00",
      "end_raw": "00:40.50",
      "start_ms": 37000,
      "end_ms": 40500,
      "text": "Medium close-up of the Thug with Cap scoffing derisively.",
      "line_number": 114,
      "duration_ms": 3500
    },
    {
      "block_id": "EP015_B027",
      "episode_id": "EP015",
      "file_index": 26,
      "scene_id": "EP015_S01",
      "block_type": "DIALOGUE",
      "label_raw": "THUG WITH CAP (Sneering, Disdainful)",
      "speaker": "THUG WITH CAP",
      "delivery": [
        "Sneering",
        "Disdainful"
      ],
      "offscreen": null,
      "start_raw": "00:37.20",
      "end_raw": "00:40.40",
      "start_ms": 37200,
      "end_ms": 40400,
      "text": "\"A noble lady playing in the dirt. What a joke.\"",
      "line_number": 118,
      "duration_ms": 3200
    },
    {
      "block_id": "EP015_B028",
      "episode_id": "EP015",
      "file_index": 27,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:40.50",
      "end_raw": "00:44.20",
      "start_ms": 40500,
      "end_ms": 44200,
      "text": "Medium close-up of Juliana, her eyes blazing with indignation and wounded pride.",
      "line_number": 122,
      "duration_ms": 3700
    },
    {
      "block_id": "EP015_B029",
      "episode_id": "EP015",
      "file_index": 28,
      "scene_id": "EP015_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Resolute, Dignified)",
      "speaker": "JULIANA",
      "delivery": [
        "Resolute",
        "Dignified"
      ],
      "offscreen": null,
      "start_raw": "00:41.00",
      "end_raw": "00:44.00",
      "start_ms": 41000,
      "end_ms": 44000,
      "text": "\"It is my home. You have no right to destroy anything here.\"",
      "line_number": 126,
      "duration_ms": 3000
    },
    {
      "block_id": "EP015_B030",
      "episode_id": "EP015",
      "file_index": 29,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:44.20",
      "end_raw": "00:46.50",
      "start_ms": 44200,
      "end_ms": 46500,
      "text": "Tight close-up of the Thug with Cap stepping aggressively into Juliana's personal space, snarling with venom.",
      "line_number": 130,
      "duration_ms": 2300
    },
    {
      "block_id": "EP015_B031",
      "episode_id": "EP015",
      "file_index": 30,
      "scene_id": "EP015_S01",
      "block_type": "DIALOGUE",
      "label_raw": "THUG WITH CAP (Menacing Snarl)",
      "speaker": "THUG WITH CAP",
      "delivery": [
        "Menacing Snarl"
      ],
      "offscreen": null,
      "start_raw": "00:44.80",
      "end_raw": "00:46.40",
      "start_ms": 44800,
      "end_ms": 46400,
      "text": "\"Get out of the way!\"",
      "line_number": 134,
      "duration_ms": 1600
    },
    {
      "block_id": "EP015_B032",
      "episode_id": "EP015",
      "file_index": 31,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:46.50",
      "end_raw": "00:48.00",
      "start_ms": 46500,
      "end_ms": 48000,
      "text": "Extreme close-up on Juliana's piercing blue eyes and set jaw, unflinching.",
      "line_number": 138,
      "duration_ms": 1500
    },
    {
      "block_id": "EP015_B033",
      "episode_id": "EP015",
      "file_index": 32,
      "scene_id": "EP015_S01",
      "block_type": "DIALOGUE",
      "label_raw": "JULIANA (Steely, Fearless)",
      "speaker": "JULIANA",
      "delivery": [
        "Steely",
        "Fearless"
      ],
      "offscreen": null,
      "start_raw": "00:46.50",
      "end_raw": "00:47.30",
      "start_ms": 46500,
      "end_ms": 47300,
      "text": "\"No.\"",
      "line_number": 142,
      "duration_ms": 800
    },
    {
