      "start_ms": 0,
      "end_ms": 3500,
      "text": "High-angle wide shot of the raised planter beds illuminated by the pale moonlight as three shadowy figures march purposefully down the central stone path.",
      "line_number": 14,
      "duration_ms": 3500
    },
    {
      "block_id": "EP015_B002",
      "episode_id": "EP015",
      "file_index": 1,
      "scene_id": "EP015_S01",
      "block_type": "ACTION",
