      "start_raw": "00:00.00",
      "end_raw": "00:03.50",
      "start_ms": 0,
      "end_ms": 3500,
      "text": "Three menacing thugs, armed with clubs and tools, stalk through the quiet herbal garden surrounded by stone walls.",
      "line_number": 18,
      "duration_ms": 3500
    },
    {
      "block_id": "EP015_B003",
      "episode_id": "EP015",
      "file_index": 2,
      "scene_id": "EP015_S01",
      "block_type": "CAMERA",
