      "start_raw": "00:56.80",
      "end_raw": "00:58.20",
      "start_ms": 56800,
      "end_ms": 58200,
      "text": "\"And that quiet little face.\"",
      "line_number": 170,
      "duration_ms": 1400
    },
    {
      "block_id": "EP002_B041",
      "episode_id": "EP002",
      "file_index": 40,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:58.20",
      "end_raw": "00:58.60",
      "start_ms": 58200,
      "end_ms": 58600,
      "text": "Wide over-the-shoulder shot from behind Clarissa and Gerald, framing Juliana standing solitary down the center aisle.",
      "line_number": 174,
      "duration_ms": 400
    },
    {
      "block_id": "EP002_B042",
      "episode_id": "EP002",
