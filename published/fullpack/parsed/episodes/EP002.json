      "end_raw": "01:00.50",
      "start_ms": 58600,
      "end_ms": 60500,
      "text": "Medium shot returning to Clarissa laughing at Juliana's expense.",
      "line_number": 178,
      "duration_ms": 1900
    },
    {
      "block_id": "EP002_B043",
      "episode_id": "EP002",
      "file_index": 42,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY IN GOLD GOWN (Conceited, Spiteful)",
      "speaker": "LADY IN GOLD GOWN",
      "delivery": [
        "Conceited",
        "Spiteful"
      ],
      "offscreen": null,
      "start_raw": "00:58.70",
      "end_raw": "01:00.50",
      "start_ms": 58700,
      "end_ms": 60500,
      "text": "\"Gerald needs a real lady...\"",
      "line_number": 182,
      "duration_ms": 1800
    },
    {
      "block_id": "EP002_B044",
      "episode_id": "EP002",
      "file_index": 43,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:00.50",
      "end_raw": "01:03.50",
      "start_ms": 60500,
      "end_ms": 63500,
      "text": "Close-up on Juliana staring straight ahead as Clarissa insults her mother's memory.",
      "line_number": 186,
      "duration_ms": 3000
    },
    {
      "block_id": "EP002_B045",
      "episode_id": "EP002",
      "file_index": 44,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY IN GOLD GOWN (Off-screen) (Vicious)",
      "speaker": "LADY IN GOLD GOWN",
      "delivery": [
        "Off-screen",
        "Vicious"
      ],
      "offscreen": null,
      "start_raw": "01:00.60",
      "end_raw": "01:03.50",
      "start_ms": 60600,
      "end_ms": 63500,
      "text": "\"...not a dull creature who hides in her mother's apothecary herbs.\"",
      "line_number": 190,
      "duration_ms": 2900
    },
    {
      "block_id": "EP002_B046",
      "episode_id": "EP002",
      "file_index": 45,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:03.50",
      "end_raw": "01:06.00",
      "start_ms": 63500,
      "end_ms": 66000,
      "text": "High-angle wide shot of the grand cathedral aisle as a matriarch dressed in an ornate black velvet gown glides toward Juliana.",
      "line_number": 194,
      "duration_ms": 2500
    },
    {
      "block_id": "EP002_B047",
      "episode_id": "EP002",
      "file_index": 46,
      "scene_id": "EP002_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:03.50",
      "end_raw": "01:06.00",
      "start_ms": 63500,
      "end_ms": 66000,
      "text": "The matriarch steps into the center aisle, glaring down at Juliana with cold superiority.",
      "line_number": 198,
      "duration_ms": 2500
    },
    {
      "block_id": "EP002_B048",
      "episode_id": "EP002",
      "file_index": 47,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "OFF-SCREEN VOICE (Cold, Scolding)",
      "speaker": "OFF-SCREEN VOICE",
      "delivery": [
        "Cold",
        "Scolding"
      ],
      "offscreen": null,
      "start_raw": "01:03.60",
      "end_raw": "01:05.80",
      "start_ms": 63600,
      "end_ms": 65800,
      "text": "\"Oh, don't look so wounded, Juliana.\"",
      "line_number": 202,
      "duration_ms": 2200
    },
    {
      "block_id": "EP002_B049",
      "episode_id": "EP002",
      "file_index": 48,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:06.00",
      "end_raw": "01:09.30",
      "start_ms": 66000,
      "end_ms": 69300,
      "text": "Medium profile two-shot of the matriarch confronting Juliana face-to-face.",
      "line_number": 206,
      "duration_ms": 3300
    },
    {
      "block_id": "EP002_B050",
      "episode_id": "EP002",
      "file_index": 49,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "OFF-SCREEN VOICE (Dismissive, Condescending)",
      "speaker": "OFF-SCREEN VOICE",
      "delivery": [
        "Dismissive",
        "Condescending"
