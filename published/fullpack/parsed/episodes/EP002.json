      "start_ms": 0,
      "end_ms": 2800,
      "text": "Medium low-angle shot on Gerald at the altar steps, looking down dismissively, while Clarissa in her shimmering gold gown stands behind him gloating.",
      "line_number": 14,
      "duration_ms": 2800
    },
    {
      "block_id": "EP002_B002",
      "episode_id": "EP002",
      "file_index": 1,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "THE FORMER GROOM (Cold, Callous)",
      "speaker": "THE FORMER GROOM",
      "delivery": [
        "Cold",
        "Callous"
      ],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:02.50",
      "start_ms": 0,
      "end_ms": 2500,
      "text": "\"I cannot marry you, Juliana.\"",
      "line_number": 18,
      "duration_ms": 2500
    },
    {
      "block_id": "EP002_B003",
      "episode_id": "EP002",
      "file_index": 2,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:02.80",
      "end_raw": "00:04.60",
      "start_ms": 2800,
      "end_ms": 4600,
      "text": "Medium close-up on Juliana trembling in disbelief, her hands clasped tightly to her chest.",
      "line_number": 22,
      "duration_ms": 1800
    },
    {
      "block_id": "EP002_B004",
      "episode_id": "EP002",
      "file_index": 3,
      "scene_id": "EP002_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:02.80",
      "end_raw": "00:04.60",
      "start_ms": 2800,
      "end_ms": 4600,
      "text": "Juliana gasps softly in heartbreak, her eyes wide and brimming with tears.",
      "line_number": 26,
      "duration_ms": 1800
    },
    {
      "block_id": "EP002_B005",
      "episode_id": "EP002",
      "file_index": 4,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:04.60",
      "end_raw": "00:06.60",
      "start_ms": 4600,
      "end_ms": 6600,
      "text": "Medium shot returning to Gerald, sneering down at Juliana.",
      "line_number": 30,
      "duration_ms": 2000
    },
    {
      "block_id": "EP002_B006",
      "episode_id": "EP002",
      "file_index": 5,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "THE FORMER GROOM (Cruel, Derisive)",
      "speaker": "THE FORMER GROOM",
      "delivery": [
        "Cruel",
        "Derisive"
      ],
      "offscreen": null,
      "start_raw": "00:04.70",
      "end_raw": "00:06.50",
      "start_ms": 4700,
      "end_ms": 6500,
      "text": "\"You are far too plain...\"",
      "line_number": 34,
      "duration_ms": 1800
    },
    {
      "block_id": "EP002_B007",
      "episode_id": "EP002",
      "file_index": 6,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:06.60",
      "end_raw": "00:09.50",
      "start_ms": 6600,
      "end_ms": 9500,
      "text": "Close-up on Juliana's tear-streaked face, crushed under his biting words.",
      "line_number": 38,
      "duration_ms": 2900
    },
    {
      "block_id": "EP002_B008",
      "episode_id": "EP002",
      "file_index": 7,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "THE FORMER GROOM (Off-screen) (Dismissive)",
      "speaker": "THE FORMER GROOM",
      "delivery": [
        "Off-screen",
        "Dismissive"
      ],
      "offscreen": null,
      "start_raw": "00:06.80",
      "end_raw": "00:09.50",
      "start_ms": 6800,
      "end_ms": 9500,
      "text": "\"...far too silent...\"",
      "line_number": 42,
      "duration_ms": 2700
    },
    {
      "block_id": "EP002_B009",
      "episode_id": "EP002",
      "file_index": 8,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:09.50",
      "end_raw": "00:12.00",
      "start_ms": 9500,
      "end_ms": 12000,
      "text": "Medium shot on Gerald turning slightly toward Clarissa as she smiles admiringly at him.",
      "line_number": 46,
      "duration_ms": 2500
    },
    {
      "block_id": "EP002_B010",
      "episode_id": "EP002",
      "file_index": 9,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "THE FORMER GROOM (Arrogant, Conceited)",
      "speaker": "THE FORMER GROOM",
      "delivery": [
        "Arrogant",
        "Conceited"
      ],
      "offscreen": null,
      "start_raw": "00:09.60",
      "end_raw": "00:12.00",
      "start_ms": 9600,
      "end_ms": 12000,
      "text": "\"...and completely beneath the future I deserve.\"",
      "line_number": 50,
      "duration_ms": 2400
    },
    {
      "block_id": "EP002_B011",
      "episode_id": "EP002",
      "file_index": 10,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:12.00",
      "end_raw": "00:15.80",
      "start_ms": 12000,
      "end_ms": 15800,
      "text": "Wide shot down the aisle as Juliana takes an agonizing step forward toward the altar, extending a trembling hand.",
      "line_number": 54,
      "duration_ms": 3800
    },
    {
      "block_id": "EP002_B012",
      "episode_id": "EP002",
      "file_index": 11,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Desperate, Pleading)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Desperate",
        "Pleading"
      ],
      "offscreen": null,
      "start_raw": "00:12.40",
      "end_raw": "00:15.50",
      "start_ms": 12400,
      "end_ms": 15500,
      "text": "\"Gerald... Look at me.\"",
      "line_number": 58,
      "duration_ms": 3100
    },
    {
      "block_id": "EP002_B013",
      "episode_id": "EP002",
      "file_index": 12,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:15.80",
      "end_raw": "00:18.00",
      "start_ms": 15800,
      "end_ms": 18000,
      "text": "Close-up on Gerald's cold, merciless face staring ahead unblinkingly.",
      "line_number": 62,
      "duration_ms": 2200
    },
    {
      "block_id": "EP002_B014",
      "episode_id": "EP002",
      "file_index": 13,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:18.00",
      "end_raw": "00:20.70",
      "start_ms": 18000,
      "end_ms": 20700,
      "text": "Tight insert on Juliana's hand clutching the heirloom amethyst pendant resting against her gown.",
      "line_number": 66,
      "duration_ms": 2700
    },
    {
      "block_id": "EP002_B015",
      "episode_id": "EP002",
      "file_index": 14,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Trembling, Betrayed)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Trembling",
        "Betrayed"
      ],
      "offscreen": null,
      "start_raw": "00:18.20",
      "end_raw": "00:20.60",
      "start_ms": 18200,
      "end_ms": 20600,
      "text": "\"You gave me your word before both our families.\"",
      "line_number": 70,
      "duration_ms": 2400
    },
    {
      "block_id": "EP002_B016",
      "episode_id": "EP002",
      "file_index": 15,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:20.70",
      "end_raw": "00:23.80",
      "start_ms": 20700,
      "end_ms": 23800,
      "text": "Medium two-shot of Gerald and Clarissa standing side by side before the priest.",
      "line_number": 74,
      "duration_ms": 3100
    },
    {
      "block_id": "EP002_B017",
      "episode_id": "EP002",
      "file_index": 16,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "THE FORMER GROOM (Indifferent, Unapologetic)",
      "speaker": "THE FORMER GROOM",
      "delivery": [
        "Indifferent",
        "Unapologetic"
      ],
      "offscreen": null,
      "start_raw": "00:20.90",
      "end_raw": "00:23.70",
      "start_ms": 20900,
      "end_ms": 23700,
      "text": "\"Promises change when a better choice appears.\"",
      "line_number": 78,
      "duration_ms": 2800
    },
    {
      "block_id": "EP002_B018",
      "episode_id": "EP002",
      "file_index": 17,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:23.80",
      "end_raw": "00:27.60",
      "start_ms": 23800,
      "end_ms": 27600,
      "text": "Medium close-up on Juliana clutching her chest, her voice quivering with disbelief.",
      "line_number": 82,
      "duration_ms": 3800
    },
    {
      "block_id": "EP002_B019",
      "episode_id": "EP002",
      "file_index": 18,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Shattered, Disbelieving)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Shattered",
        "Disbelieving"
      ],
      "offscreen": null,
      "start_raw": "00:24.00",
      "end_raw": "00:27.40",
      "start_ms": 24000,
      "end_ms": 27400,
      "text": "\"A better choice? Is that what she is?\"",
      "line_number": 86,
      "duration_ms": 3400
    },
    {
      "block_id": "EP002_B020",
      "episode_id": "EP002",
      "file_index": 19,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:27.60",
      "end_raw": "00:30.60",
      "start_ms": 27600,
      "end_ms": 30600,
      "text": "Wide shot from behind Juliana looking up the altar stairs at Gerald with Clarissa linked to his arm.",
      "line_number": 90,
      "duration_ms": 3000
    },
    {
      "block_id": "EP002_B021",
      "episode_id": "EP002",
      "file_index": 20,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "THE FORMER GROOM (Resolute, Harsh)",
      "speaker": "THE FORMER GROOM",
      "delivery": [
        "Resolute",
        "Harsh"
      ],
      "offscreen": null,
      "start_raw": "00:27.80",
      "end_raw": "00:30.50",
      "start_ms": 27800,
      "end_ms": 30500,
      "text": "\"She is what I should have chosen from the beginning.\"",
      "line_number": 94,
      "duration_ms": 2700
    },
    {
      "block_id": "EP002_B022",
      "episode_id": "EP002",
      "file_index": 21,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:30.60",
      "end_raw": "00:32.40",
      "start_ms": 30600,
      "end_ms": 32400,
      "text": "Medium shot of Juliana's father seated prominently in the family pew, clutching his gold-topped cane.",
      "line_number": 98,
      "duration_ms": 1800
    },
    {
      "block_id": "EP002_B023",
      "episode_id": "EP002",
      "file_index": 22,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Off-screen) (Vulnerable, Begging)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Off-screen",
        "Vulnerable",
        "Begging"
      ],
      "offscreen": null,
      "start_raw": "00:30.90",
      "end_raw": "00:32.40",
      "start_ms": 30900,
      "end_ms": 32400,
      "text": "\"Father...\"",
      "line_number": 102,
      "duration_ms": 1500
    },
    {
      "block_id": "EP002_B024",
      "episode_id": "EP002",
      "file_index": 23,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:32.40",
      "end_raw": "00:34.20",
      "start_ms": 32400,
      "end_ms": 34200,
      "text": "Close-up of the father's stern, unyielding face.",
      "line_number": 106,
      "duration_ms": 1800
    },
    {
      "block_id": "EP002_B025",
      "episode_id": "EP002",
      "file_index": 24,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:34.20",
      "end_raw": "00:37.20",
      "start_ms": 34200,
      "end_ms": 37200,
      "text": "Medium shot of Juliana turning toward her father in the pews, imploring him.",
      "line_number": 110,
      "duration_ms": 3000
    },
    {
      "block_id": "EP002_B026",
      "episode_id": "EP002",
      "file_index": 25,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Choked with Tears)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Choked with Tears"
      ],
      "offscreen": null,
      "start_raw": "00:34.30",
      "end_raw": "00:37.10",
      "start_ms": 34300,
      "end_ms": 37100,
      "text": "\"Surely you will not let him humiliate me like this?\"",
      "line_number": 114,
      "duration_ms": 2800
    },
    {
      "block_id": "EP002_B027",
      "episode_id": "EP002",
      "file_index": 26,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:37.20",
      "end_raw": "00:42.50",
      "start_ms": 37200,
      "end_ms": 42500,
      "text": "Medium shot tracking in on Juliana's father as he leans firmly upon his cane, looking down coldly.",
      "line_number": 118,
      "duration_ms": 5300
    },
    {
      "block_id": "EP002_B028",
      "episode_id": "EP002",
      "file_index": 27,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "BLOND NOBLEMAN (Stern, Cold)",
      "speaker": "BLOND NOBLEMAN",
      "delivery": [
        "Stern",
        "Cold"
      ],
      "offscreen": null,
      "start_raw": "00:37.50",
      "end_raw": "00:42.30",
      "start_ms": 37500,
      "end_ms": 42300,
      "text": "\"Gerald has made his choice. Accept it, Juliana.\"",
      "line_number": 122,
      "duration_ms": 4800
    },
    {
      "block_id": "EP002_B029",
      "episode_id": "EP002",
      "file_index": 28,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:42.50",
      "end_raw": "00:44.80",
      "start_ms": 42500,
      "end_ms": 44800,
      "text": "Close-up on the father's hardening eyes, entirely unsympathetic.",
      "line_number": 126,
      "duration_ms": 2300
    },
    {
      "block_id": "EP002_B030",
      "episode_id": "EP002",
      "file_index": 29,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "BLOND NOBLEMAN (Severely, Harsh)",
      "speaker": "BLOND NOBLEMAN",
      "delivery": [
        "Severely",
        "Harsh"
      ],
      "offscreen": null,
      "start_raw": "00:42.50",
      "end_raw": "00:44.70",
      "start_ms": 42500,
      "end_ms": 44700,
      "text": "\"Do not disgrace us further.\"",
      "line_number": 130,
      "duration_ms": 2200
    },
    {
      "block_id": "EP002_B031",
      "episode_id": "EP002",
      "file_index": 30,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:44.80",
      "end_raw": "00:47.60",
      "start_ms": 44800,
      "end_ms": 47600,
      "text": "Extreme close-up on Juliana's tear-drenched eyes as the sting of her father's rejection lands.",
      "line_number": 134,
      "duration_ms": 2800
    },
    {
      "block_id": "EP002_B032",
      "episode_id": "EP002",
      "file_index": 31,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Whispering, Crushed)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Whispering",
        "Crushed"
      ],
      "offscreen": null,
      "start_raw": "00:45.30",
      "end_raw": "00:47.40",
      "start_ms": 45300,
      "end_ms": 47400,
      "text": "\"You won't even look at me.\"",
      "line_number": 138,
      "duration_ms": 2100
    },
    {
      "block_id": "EP002_B033",
      "episode_id": "EP002",
      "file_index": 32,
