      "delivery": [],
      "offscreen": null,
      "start_raw": "00:56.70",
      "end_raw": "00:58.20",
      "start_ms": 56700,
      "end_ms": 58200,
      "text": "Close-up on Juliana, whose tearful expression begins to tighten with quiet indignation.",
      "line_number": 166,
      "duration_ms": 1500
    },
    {
      "block_id": "EP002_B040",
      "episode_id": "EP002",
      "file_index": 39,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY IN GOLD GOWN (Off-screen) (Snide)",
      "speaker": "LADY IN GOLD GOWN",
