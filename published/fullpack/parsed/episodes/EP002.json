      "start_raw": "00:53.40",
      "end_raw": "00:56.70",
      "start_ms": 53400,
      "end_ms": 56700,
      "text": "Medium shot of Clarissa smiling radiantly, condescendingly gesturing at Juliana.",
      "line_number": 158,
      "duration_ms": 3300
    },
    {
      "block_id": "EP002_B038",
      "episode_id": "EP002",
      "file_index": 37,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY IN GOLD GOWN (Taunting, Giggling)",
      "speaker": "LADY IN GOLD GOWN",
      "delivery": [
        "Taunting",
        "Giggling"
      ],
      "offscreen": null,
      "start_raw": "00:53.50",
      "end_raw": "00:56.70",
      "start_ms": 53500,
      "end_ms": 56700,
      "text": "\"You look like a kitchen maid who wandered into the wrong wedding.\"",
      "line_number": 162,
      "duration_ms": 3200
    },
    {
      "block_id": "EP002_B039",
      "episode_id": "EP002",
      "file_index": 38,
