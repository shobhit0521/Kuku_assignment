      "delivery": [],
      "offscreen": null,
      "start_raw": "00:47.60",
      "end_raw": "00:51.50",
      "start_ms": 47600,
      "end_ms": 51500,
      "text": "Medium shot on Clarissa, beaming smugly as she clings to Gerald's arm.",
      "line_number": 142,
      "duration_ms": 3900
    },
    {
      "block_id": "EP002_B034",
      "episode_id": "EP002",
      "file_index": 33,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY IN GOLD GOWN (Mocking, Spiteful)",
      "speaker": "LADY IN GOLD GOWN",
      "delivery": [
        "Mocking",
        "Spiteful"
      ],
      "offscreen": null,
      "start_raw": "00:47.80",
      "end_raw": "00:51.40",
      "start_ms": 47800,
      "end_ms": 51400,
      "text": "\"Why are you surprised, sister? Look at you.\"",
      "line_number": 146,
      "duration_ms": 3600
    },
    {
      "block_id": "EP002_B035",
      "episode_id": "EP002",
      "file_index": 34,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:51.50",
      "end_raw": "00:53.40",
      "start_ms": 51500,
      "end_ms": 53400,
      "text": "Tight insert on Clarissa's gloved fingers contemptuously pinching the satin folds of Juliana's gown.",
      "line_number": 150,
      "duration_ms": 1900
    },
    {
      "block_id": "EP002_B036",
      "episode_id": "EP002",
      "file_index": 35,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
