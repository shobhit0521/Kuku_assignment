      "start_raw": "00:51.60",
      "end_raw": "00:53.20",
      "start_ms": 51600,
      "end_ms": 53200,
      "text": "\"That plain, old-fashioned gown.\"",
      "line_number": 154,
      "duration_ms": 1600
    },
    {
      "block_id": "EP002_B037",
      "episode_id": "EP002",
      "file_index": 36,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
