      "offscreen": null,
      "start_raw": "01:06.10",
      "end_raw": "01:09.30",
      "start_ms": 66100,
      "end_ms": 69300,
      "text": "\"You should be grateful you're at least allowed to attend the wedding.\"",
      "line_number": 210,
      "duration_ms": 3200
    },
    {
      "block_id": "EP002_B051",
      "episode_id": "EP002",
      "file_index": 50,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:09.30",
      "end_raw": "01:12.80",
      "start_ms": 69300,
      "end_ms": 72800,
      "text": "Medium shot of Gerald stepping forward on the altar steps, impatiently gesturing Juliana toward the church exit.",
      "line_number": 214,
      "duration_ms": 3500
    },
    {
      "block_id": "EP002_B052",
      "episode_id": "EP002",
      "file_index": 51,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "THE FORMER GROOM (Impatient, Commanding)",
      "speaker": "THE FORMER GROOM",
      "delivery": [
        "Impatient",
        "Commanding"
      ],
      "offscreen": null,
      "start_raw": "01:09.40",
      "end_raw": "01:12.70",
      "start_ms": 69400,
      "end_ms": 72700,
      "text": "\"Go home quietly, Juliana. At least leave this chapel with some dignity.\"",
      "line_number": 218,
      "duration_ms": 3300
    },
    {
      "block_id": "EP002_B053",
      "episode_id": "EP002",
      "file_index": 52,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:12.80",
      "end_raw": "01:14.20",
      "start_ms": 72800,
      "end_ms": 74200,
      "text": "Profile close-up of Juliana turning her face back toward the altar, tears still shimmering on her cheeks.",
      "line_number": 222,
      "duration_ms": 1400
    },
    {
      "block_id": "EP002_B054",
      "episode_id": "EP002",
      "file_index": 53,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:14.20",
      "end_raw": "01:16.50",
      "start_ms": 74200,
      "end_ms": 76500,
      "text": "Direct close-up on Juliana's face as a steely, defiant smile emerges through her pain.",
      "line_number": 226,
      "duration_ms": 2300
    },
    {
      "block_id": "EP002_B055",
      "episode_id": "EP002",
      "file_index": 54,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Bitter, Defiant)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Bitter",
        "Defiant"
      ],
      "offscreen": null,
      "start_raw": "01:14.40",
      "end_raw": "01:16.40",
      "start_ms": 74400,
      "end_ms": 76400,
      "text": "\"Dignity?\"",
      "line_number": 230,
      "duration_ms": 2000
    },
    {
      "block_id": "EP002_B056",
      "episode_id": "EP002",
      "file_index": 55,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:16.50",
      "end_raw": "01:19.00",
      "start_ms": 76500,
      "end_ms": 79000,
      "text": "Full shot of Juliana standing tall, her posture completely transforming into regal composure before the seated guests.",
      "line_number": 234,
      "duration_ms": 2500
    },
    {
      "block_id": "EP002_B057",
      "episode_id": "EP002",
      "file_index": 56,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Clear, Accusing)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Clear",
        "Accusing"
      ],
      "offscreen": null,
      "start_raw": "01:16.50",
      "end_raw": "01:19.00",
      "start_ms": 76500,
      "end_ms": 79000,
      "text": "\"You abandoned a woman who trusted you...\"",
      "line_number": 238,
      "duration_ms": 2500
    },
    {
      "block_id": "EP002_B058",
      "episode_id": "EP002",
      "file_index": 57,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:19.00",
      "end_raw": "01:21.80",
      "start_ms": 79000,
      "end_ms": 81800,
      "text": "Medium profile close-up on Gerald's hardening jawline, Clarissa blurred in the background.",
      "line_number": 242,
      "duration_ms": 2800
    },
    {
      "block_id": "EP002_B059",
      "episode_id": "EP002",
      "file_index": 58,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Off-screen) (Sharp, Piercing)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Off-screen",
        "Sharp",
        "Piercing"
      ],
      "offscreen": null,
      "start_raw": "01:19.20",
      "end_raw": "01:22.50",
      "start_ms": 79200,
      "end_ms": 82500,
      "text": "\"...because another woman promised you greater beauty and wealth.\"",
      "line_number": 246,
      "duration_ms": 3300
    },
    {
      "block_id": "EP002_B060",
      "episode_id": "EP002",
      "file_index": 59,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:21.80",
      "end_raw": "01:22.80",
      "start_ms": 81800,
      "end_ms": 82800,
      "text": "Closer angle on Gerald's uneasy expression as Juliana's voice commands the room.",
      "line_number": 250,
      "duration_ms": 1000
    },
    {
      "block_id": "EP002_B061",
      "episode_id": "EP002",
      "file_index": 60,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:22.80",
      "end_raw": "01:26.70",
      "start_ms": 82800,
      "end_ms": 86700,
      "text": "Medium wide shot framing Juliana confronting Gerald from the foot of the altar stairs.",
      "line_number": 254,
      "duration_ms": 3900
    },
    {
      "block_id": "EP002_B062",
      "episode_id": "EP002",
      "file_index": 61,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Steely, Resolute)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Steely",
        "Resolute"
      ],
      "offscreen": null,
      "start_raw": "01:23.00",
      "end_raw": "01:26.50",
      "start_ms": 83000,
      "end_ms": 86500,
      "text": "\"Do not mistake my heartbreak for your victory, Gerald.\"",
      "line_number": 258,
      "duration_ms": 3500
    },
    {
      "block_id": "EP002_B063",
      "episode_id": "EP002",
      "file_index": 62,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:26.70",
      "end_raw": "01:30.80",
      "start_ms": 86700,
      "end_ms": 90800,
      "text": "Medium close-up push-in on Juliana, her blue eyes shining with fierce conviction.",
      "line_number": 262,
      "duration_ms": 4100
    },
    {
      "block_id": "EP002_B064",
      "episode_id": "EP002",
      "file_index": 63,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Powerful, Unyielding)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Powerful",
        "Unyielding"
      ],
      "offscreen": null,
      "start_raw": "01:26.80",
      "end_raw": "01:33.00",
      "start_ms": 86800,
      "end_ms": 93000,
      "text": "\"You wanted this entire chapel to believe that I was not worthy of you. But you have shown them something far more valuable.\"",
      "line_number": 266,
      "duration_ms": 6200
    },
    {
      "block_id": "EP002_B065",
      "episode_id": "EP002",
      "file_index": 64,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:30.80",
      "end_raw": "01:33.20",
      "start_ms": 90800,
      "end_ms": 93200,
      "text": "Medium profile on Juliana looking up at Gerald, holding the entire hall spellbound.",
      "line_number": 270,
      "duration_ms": 2400
    },
    {
      "block_id": "EP002_B066",
      "episode_id": "EP002",
      "file_index": 65,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:33.20",
      "end_raw": "01:36.80",
      "start_ms": 93200,
      "end_ms": 96800,
      "text": "Close-up on Juliana's face, calm, dignified, and unwavering.",
      "line_number": 274,
      "duration_ms": 3600
    },
    {
      "block_id": "EP002_B067",
      "episode_id": "EP002",
      "file_index": 66,
      "scene_id": "EP002_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Decisive, Scathing)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Decisive",
        "Scathing"
      ],
      "offscreen": null,
      "start_raw": "01:33.40",
      "end_raw": "01:36.60",
      "start_ms": 93400,
      "end_ms": 96600,
      "text": "\"You have shown them exactly what your word is worth.\"",
      "line_number": 278,
      "duration_ms": 3200
    },
    {
      "block_id": "EP002_B068",
      "episode_id": "EP002",
      "file_index": 67,
      "scene_id": "EP002_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:36.80",
      "end_raw": "01:38.20",
