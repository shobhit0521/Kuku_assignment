  "blocks": [
    {
      "block_id": "EP021_B001",
      "episode_id": "EP021",
      "file_index": 0,
      "scene_id": "EP021_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:03.50",
      "start_ms": 0,
      "end_ms": 3500,
      "text": "Medium shot of Lady Juliana in a rustic grey gown, her wrists wrapped in white bandages, smoothing a blanket over a straw pallet in the dimly lit barn.",
      "line_number": 14,
      "duration_ms": 3500
    },
    {
      "block_id": "EP021_B002",
      "episode_id": "EP021",
      "file_index": 1,
      "scene_id": "EP021_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:00.00",
      "end_raw": "00:03.50",
      "start_ms": 0,
      "end_ms": 3500,
      "text": "Lady Juliana gently straightens the grey wool blanket over the hay bed, exhaling a soft, exhausted sigh.",
      "line_number": 18,
      "duration_ms": 3500
    },
    {
      "block_id": "EP021_B003",
      "episode_id": "EP021",
      "file_index": 2,
      "scene_id": "EP021_S01",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:03.50",
      "end_raw": "00:04.80",
      "start_ms": 3500,
      "end_ms": 4800,
      "text": "A loud wooden slam as the heavy double barn doors violently fly open.",
      "line_number": 22,
      "duration_ms": 1300
    },
    {
      "block_id": "EP021_B004",
      "episode_id": "EP021",
      "file_index": 3,
      "scene_id": "EP021_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:03.60",
      "end_raw": "00:08.50",
      "start_ms": 3600,
      "end_ms": 8500,
      "text": "Wide shot framing the open doorway against the overcast daylight as Prudence, a young village girl in an apron, rushes inside, frantic and weeping.",
      "line_number": 26,
      "duration_ms": 4900
    },
    {
      "block_id": "EP021_B005",
      "episode_id": "EP021",
      "file_index": 4,
      "scene_id": "EP021_S01",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Desperate, Panicked)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Desperate",
        "Panicked"
      ],
      "offscreen": null,
      "start_raw": "00:04.20",
      "end_raw": "00:08.00",
      "start_ms": 4200,
      "end_ms": 8000,
      "text": "\"Lady Juliana! Please! You have to help me, Toby is dying!\"",
      "line_number": 30,
      "duration_ms": 3800
    },
    {
      "block_id": "EP021_B006",
      "episode_id": "EP021",
      "file_index": 5,
      "scene_id": "EP021_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:08.20",
      "end_raw": "00:10.50",
      "start_ms": 8200,
      "end_ms": 10500,
      "text": "Lady Juliana hurries over, placing her bandaged hands reassuringly on Prudence's trembling shoulders.",
      "line_number": 34,
      "duration_ms": 2300
    },
    {
      "block_id": "EP021_B007",
      "episode_id": "EP021",
      "file_index": 6,
      "scene_id": "EP021_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:08.50",
      "end_raw": "00:11.20",
      "start_ms": 8500,
      "end_ms": 11200,
      "text": "Medium close-up of Lady Juliana looking into Prudence's tearful face with compassionate urgency.",
      "line_number": 38,
      "duration_ms": 2700
    },
    {
      "block_id": "EP021_B008",
      "episode_id": "EP021",
      "file_index": 7,
      "scene_id": "EP021_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Gentle, Urgent)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Gentle",
        "Urgent"
      ],
      "offscreen": null,
      "start_raw": "00:08.50",
      "end_raw": "00:11.00",
      "start_ms": 8500,
      "end_ms": 11000,
      "text": "\"Oh dear. Breathe. Tell me what has happened.\"",
      "line_number": 42,
      "duration_ms": 2500
    },
    {
      "block_id": "EP021_B009",
      "episode_id": "EP021",
      "file_index": 8,
      "scene_id": "EP021_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:11.20",
      "end_raw": "00:15.10",
      "start_ms": 11200,
      "end_ms": 15100,
      "text": "Close-up of Prudence weeping, clutching her hands to her chest in agony.",
      "line_number": 46,
      "duration_ms": 3900
    },
    {
      "block_id": "EP021_B010",
      "episode_id": "EP021",
      "file_index": 9,
      "scene_id": "EP021_S01",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Sobbing, Breathless)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Sobbing",
        "Breathless"
      ],
      "offscreen": null,
      "start_raw": "00:11.20",
      "end_raw": "00:15.00",
      "start_ms": 11200,
      "end_ms": 15000,
      "text": "\"My little brother Toby... his chest is burning! He cannot breathe!\"",
      "line_number": 50,
      "duration_ms": 3800
    },
    {
      "block_id": "EP021_B011",
      "episode_id": "EP021",
      "file_index": 10,
      "scene_id": "EP021_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:15.10",
      "end_raw": "00:18.20",
      "start_ms": 15100,
      "end_ms": 18200,
      "text": "Close-up of Lady Juliana, her brow furrowing with concern.",
      "line_number": 54,
      "duration_ms": 3100
    },
    {
      "block_id": "EP021_B012",
      "episode_id": "EP021",
      "file_index": 11,
      "scene_id": "EP021_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Inquiring, Strained)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Inquiring",
        "Strained"
      ],
      "offscreen": null,
      "start_raw": "00:15.00",
      "end_raw": "00:18.20",
      "start_ms": 15000,
      "end_ms": 18200,
      "text": "\"Tell me what the apothecary said. Did he not give you medicine?\"",
      "line_number": 58,
      "duration_ms": 3200
    },
    {
      "block_id": "EP021_B013",
      "episode_id": "EP021",
      "file_index": 12,
      "scene_id": "EP021_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:18.20",
      "end_raw": "00:21.80",
      "start_ms": 18200,
      "end_ms": 21800,
      "text": "Close-up of Prudence, her face twisted in bitter anguish as she gestures back toward the rain-soaked outdoors.",
      "line_number": 62,
      "duration_ms": 3600
    },
    {
      "block_id": "EP021_B014",
      "episode_id": "EP021",
      "file_index": 13,
      "scene_id": "EP021_S01",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Anguished, Resentful)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Anguished",
        "Resentful"
      ],
      "offscreen": null,
      "start_raw": "00:18.20",
      "end_raw": "00:21.70",
      "start_ms": 18200,
      "end_ms": 21700,
      "text": "\"He shut the door in my face because we have no silver!\"",
      "line_number": 66,
      "duration_ms": 3500
    },
    {
      "block_id": "EP021_B015",
      "episode_id": "EP021",
      "file_index": 14,
      "scene_id": "EP021_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:21.80",
      "end_raw": "00:25.00",
      "start_ms": 21800,
      "end_ms": 25000,
      "text": "Wide shot of Lady Juliana and Prudence facing each other inside the wooden barn, dust motes drifting in the pale light.",
      "line_number": 70,
      "duration_ms": 3200
    },
    {
      "block_id": "EP021_B016",
      "episode_id": "EP021",
      "file_index": 15,
      "scene_id": "EP021_S01",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Bitter, Tearful)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Bitter",
        "Tearful"
      ],
      "offscreen": null,
      "start_raw": "00:21.80",
      "end_raw": "00:25.30",
      "start_ms": 21800,
      "end_ms": 25300,
      "text": "\"The manor doctor laughed! He said village boys are not worth his time!\"",
      "line_number": 74,
      "duration_ms": 3500
    },
    {
      "block_id": "EP021_B017",
      "episode_id": "EP021",
      "file_index": 16,
      "scene_id": "EP021_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:25.00",
      "end_raw": "00:30.90",
      "start_ms": 25000,
      "end_ms": 30900,
      "text": "Medium profile shot of Lady Juliana looking down at her bandaged hands, holding Prudence's hand with somber heartache.",
      "line_number": 78,
      "duration_ms": 5900
    },
    {
      "block_id": "EP021_B018",
      "episode_id": "EP021",
      "file_index": 17,
      "scene_id": "EP021_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Sorrowful, Dejected)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Sorrowful",
        "Dejected"
      ],
      "offscreen": null,
      "start_raw": "00:25.10",
      "end_raw": "00:27.40",
      "start_ms": 25100,
      "end_ms": 27400,
      "text": "\"We have no clinic now.\"",
      "line_number": 82,
      "duration_ms": 2300
    },
    {
      "block_id": "EP021_B019",
      "episode_id": "EP021",
      "file_index": 18,
      "scene_id": "EP021_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Despondent)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Despondent"
      ],
      "offscreen": null,
      "start_raw": "00:27.50",
      "end_raw": "00:30.80",
      "start_ms": 27500,
      "end_ms": 30800,
      "text": "\"Our cottage is ashes. I have nothing left but this coltsfoot.\"",
      "line_number": 86,
      "duration_ms": 3300
    },
    {
      "block_id": "EP021_B020",
      "episode_id": "EP021",
      "file_index": 19,
      "scene_id": "EP021_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:31.00",
      "end_raw": "00:33.00",
      "start_ms": 31000,
      "end_ms": 33000,
      "text": "Prudence drops desperately to her knees onto the hay-strewn barn floor, clasping her hands in tearful supplication.",
      "line_number": 90,
      "duration_ms": 2000
    },
    {
      "block_id": "EP021_B021",
      "episode_id": "EP021",
      "file_index": 20,
      "scene_id": "EP021_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:31.10",
      "end_raw": "00:35.80",
      "start_ms": 31100,
      "end_ms": 35800,
      "text": "High-angle looking down at Prudence kneeling before Lady Juliana, pleading upward.",
      "line_number": 94,
      "duration_ms": 4700
    },
    {
      "block_id": "EP021_B022",
      "episode_id": "EP021",
      "file_index": 21,
      "scene_id": "EP021_S01",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Pleading, Desperate)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Pleading",
        "Desperate"
      ],
      "offscreen": null,
      "start_raw": "00:31.00",
      "end_raw": "00:35.80",
      "start_ms": 31000,
      "end_ms": 35800,
      "text": "\"He is only seven! If you do not come, he will die! You are his only hope, Lady Juliana!\"",
      "line_number": 98,
      "duration_ms": 4800
    },
    {
      "block_id": "EP021_B023",
      "episode_id": "EP021",
      "file_index": 22,
      "scene_id": "EP021_S01",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:35.80",
      "end_raw": "00:39.50",
      "start_ms": 35800,
      "end_ms": 39500,
      "text": "Lady Juliana immediately reaches down and pulls Prudence firmly back to her feet, then turns to snatch her heavy leather-bound herbal ledger from the wooden workbench.",
      "line_number": 102,
      "duration_ms": 3700
    },
    {
      "block_id": "EP021_B024",
      "episode_id": "EP021",
      "file_index": 23,
      "scene_id": "EP021_S01",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:35.90",
      "end_raw": "00:40.50",
      "start_ms": 35900,
      "end_ms": 40500,
      "text": "Medium shot framing the barn entrance as Lady Juliana lifts Prudence up, grabs her book, and leads the way out.",
      "line_number": 106,
      "duration_ms": 4600
    },
    {
      "block_id": "EP021_B025",
      "episode_id": "EP021",
      "file_index": 24,
      "scene_id": "EP021_S01",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Resolute, Authoritative)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Resolute",
        "Authoritative"
      ],
      "offscreen": null,
      "start_raw": "00:35.90",
      "end_raw": "00:40.40",
      "start_ms": 35900,
      "end_ms": 40400,
      "text": "\"Stand up. Sinking to your knees will not save him. Let me grab my ledger. We go now.\"",
      "line_number": 110,
      "duration_ms": 4500
    },
    {
      "block_id": "EP021_B026",
      "episode_id": "EP021",
      "file_index": 25,
      "scene_id": "EP021_S02",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:40.50",
      "end_raw": "00:42.80",
      "start_ms": 40500,
      "end_ms": 42800,
      "text": "Tracking wide shot following Lady Juliana and Prudence running side by side along a muddy, puddled village road past thatched stone cottages under a gloomy, overcast sky.",
      "line_number": 121,
      "duration_ms": 2300
    },
    {
      "block_id": "EP021_B027",
      "episode_id": "EP021",
      "file_index": 26,
      "scene_id": "EP021_S02",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:40.50",
      "end_raw": "00:42.80",
      "start_ms": 40500,
      "end_ms": 42800,
      "text": "Lady Juliana clutches the thick book to her chest as she and Prudence sprint swiftly through the village.",
      "line_number": 125,
      "duration_ms": 2300
    },
    {
      "block_id": "EP021_B028",
      "episode_id": "EP021",
      "file_index": 27,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:42.80",
      "end_raw": "00:45.50",
      "start_ms": 42800,
      "end_ms": 45500,
      "text": "Low-angle medium shot of seven-year-old Toby lying on a makeshift straw pallet before a roaring fireplace, coughing weakly.",
      "line_number": 136,
      "duration_ms": 2700
    },
    {
      "block_id": "EP021_B029",
      "episode_id": "EP021",
      "file_index": 28,
      "scene_id": "EP021_S03",
      "block_type": "SOUND_FX",
      "label_raw": "SOUND FX",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:42.80",
      "end_raw": "00:45.50",
      "start_ms": 42800,
      "end_ms": 45500,
      "text": "Heavy, raspy chest coughs echoing in the small room, accompanied by crackling hearth fire.",
      "line_number": 140,
      "duration_ms": 2700
    },
    {
      "block_id": "EP021_B030",
      "episode_id": "EP021",
      "file_index": 29,
      "scene_id": "EP021_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:45.50",
      "end_raw": "00:48.00",
      "start_ms": 45500,
      "end_ms": 48000,
      "text": "Lady Juliana rushes in, sets the ledger on the rustic wooden table, and quickly flips open the pages.",
      "line_number": 144,
      "duration_ms": 2500
    },
    {
      "block_id": "EP021_B031",
      "episode_id": "EP021",
      "file_index": 30,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:45.50",
      "end_raw": "00:48.50",
      "start_ms": 45500,
      "end_ms": 48500,
      "text": "Close-up of Lady Juliana rapidly scanning the botanical illustrations and handwritten remedies in the book.",
      "line_number": 148,
      "duration_ms": 3000
    },
    {
      "block_id": "EP021_B032",
      "episode_id": "EP021",
      "file_index": 31,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Alarmed, Focused)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Alarmed",
        "Focused"
      ],
      "offscreen": null,
      "start_raw": "00:47.30",
      "end_raw": "00:48.80",
      "start_ms": 47300,
      "end_ms": 48800,
      "text": "\"His skin is burning hot.\"",
      "line_number": 152,
      "duration_ms": 1500
    },
    {
      "block_id": "EP021_B033",
      "episode_id": "EP021",
      "file_index": 32,
      "scene_id": "EP021_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:48.80",
      "end_raw": "00:50.50",
      "start_ms": 48800,
      "end_ms": 50500,
      "text": "Lady Juliana places her bandaged hand against Toby's flushed, sweating forehead as he wheezes painfully.",
      "line_number": 156,
      "duration_ms": 1700
    },
    {
      "block_id": "EP021_B034",
      "episode_id": "EP021",
      "file_index": 33,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:48.80",
      "end_raw": "00:51.20",
      "start_ms": 48800,
      "end_ms": 51200,
      "text": "Medium close-up of Lady Juliana tending to Toby, with Prudence standing anxiously in the background.",
      "line_number": 160,
      "duration_ms": 2400
    },
    {
      "block_id": "EP021_B035",
      "episode_id": "EP021",
      "file_index": 34,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Commanding)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Commanding"
      ],
      "offscreen": null,
      "start_raw": "00:48.90",
      "end_raw": "00:50.80",
      "start_ms": 48900,
      "end_ms": 50800,
      "text": "\"Prudence, fetch hot water immediately!\"",
      "line_number": 164,
      "duration_ms": 1900
    },
    {
      "block_id": "EP021_B036",
      "episode_id": "EP021",
      "file_index": 35,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:51.20",
      "end_raw": "00:54.00",
      "start_ms": 51200,
      "end_ms": 54000,
      "text": "Medium shot of Prudence nodding rapidly, rushing toward the stone hearth.",
      "line_number": 168,
      "duration_ms": 2800
    },
    {
      "block_id": "EP021_B037",
      "episode_id": "EP021",
      "file_index": 36,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Hurried, Obedient)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Hurried",
        "Obedient"
      ],
      "offscreen": null,
      "start_raw": "00:51.20",
      "end_raw": "00:53.00",
      "start_ms": 51200,
      "end_ms": 53000,
      "text": "\"Yes! Right away, I will get it!\"",
      "line_number": 172,
      "duration_ms": 1800
    },
    {
      "block_id": "EP021_B038",
      "episode_id": "EP021",
      "file_index": 37,
      "scene_id": "EP021_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:53.00",
      "end_raw": "00:55.00",
      "start_ms": 53000,
      "end_ms": 55000,
      "text": "Prudence wraps a cloth around the iron handle of the steaming kettle resting over the hearth fire and lifts it.",
      "line_number": 176,
      "duration_ms": 2000
    },
    {
      "block_id": "EP021_B039",
      "episode_id": "EP021",
      "file_index": 38,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:54.00",
      "end_raw": "00:56.20",
      "start_ms": 54000,
      "end_ms": 56200,
      "text": "Close-up top-down view of Lady Juliana's bandaged fingers gently touching an ink illustration of chamomile flowers in the open ledger.",
      "line_number": 180,
      "duration_ms": 2200
    },
    {
      "block_id": "EP021_B040",
      "episode_id": "EP021",
      "file_index": 39,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (V.O.) (Introspective, Determined)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Introspective",
        "Determined"
      ],
      "offscreen": "V.O.",
      "start_raw": "00:54.10",
      "end_raw": "00:58.20",
      "start_ms": 54100,
      "end_ms": 58200,
      "text": "\"I cannot let my own weariness stop me. This boy needs my mother's knowledge.\"",
      "line_number": 184,
      "duration_ms": 4100
    },
    {
      "block_id": "EP021_B041",
      "episode_id": "EP021",
      "file_index": 40,
      "scene_id": "EP021_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:58.20",
      "end_raw": "01:00.50",
      "start_ms": 58200,
      "end_ms": 60500,
      "text": "Lady Juliana crushes dried herbal leaves into a dark wooden bowl between her bandaged hands, then pours steaming water over them from the kettle.",
      "line_number": 188,
      "duration_ms": 2300
    },
    {
      "block_id": "EP021_B042",
      "episode_id": "EP021",
      "file_index": 41,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "00:58.50",
      "end_raw": "01:00.80",
      "start_ms": 58500,
      "end_ms": 60800,
      "text": "Close-up of hot water pouring into the bowl, releasing aromatic vapors from the dried herbs.",
      "line_number": 192,
      "duration_ms": 2300
    },
    {
      "block_id": "EP021_B043",
      "episode_id": "EP021",
      "file_index": 42,
      "scene_id": "EP021_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:00.80",
      "end_raw": "01:04.00",
      "start_ms": 60800,
      "end_ms": 64000,
      "text": "Lady Juliana sits beside the pallet and brings the steaming herbal bowl close to Toby's face while Prudence cradles his shoulders.",
      "line_number": 196,
      "duration_ms": 3200
    },
    {
      "block_id": "EP021_B044",
      "episode_id": "EP021",
      "file_index": 43,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:00.80",
      "end_raw": "01:04.50",
      "start_ms": 60800,
      "end_ms": 64500,
      "text": "Medium shot of Lady Juliana, Prudence, and Toby huddled together by the warm glow of the fire.",
      "line_number": 200,
      "duration_ms": 3700
    },
    {
      "block_id": "EP021_B045",
      "episode_id": "EP021",
      "file_index": 44,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Instructive, Calm)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Instructive",
        "Calm"
      ],
      "offscreen": null,
      "start_raw": "01:01.00",
      "end_raw": "01:04.00",
      "start_ms": 61000,
      "end_ms": 64000,
      "text": "\"Lift his shoulders, Prudence. Hold the steam close. Let him inhale.\"",
      "line_number": 204,
      "duration_ms": 3000
    },
    {
      "block_id": "EP021_B046",
      "episode_id": "EP021",
      "file_index": 45,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:04.50",
      "end_raw": "01:06.80",
      "start_ms": 64500,
      "end_ms": 66800,
      "text": "Close-up of Prudence supporting Toby's head, whispering tenderly into his ear.",
      "line_number": 208,
      "duration_ms": 2300
    },
    {
      "block_id": "EP021_B047",
      "episode_id": "EP021",
      "file_index": 46,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Tearful, Coaxing)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Tearful",
        "Coaxing"
      ],
      "offscreen": null,
      "start_raw": "01:04.50",
      "end_raw": "01:06.60",
      "start_ms": 64500,
      "end_ms": 66600,
      "text": "\"Like this? Toby, breathe it in, sweet boy.\"",
      "line_number": 212,
      "duration_ms": 2100
    },
    {
      "block_id": "EP021_B048",
      "episode_id": "EP021",
      "file_index": 47,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:06.80",
      "end_raw": "01:10.50",
      "start_ms": 66800,
      "end_ms": 70500,
      "text": "Close-up of Lady Juliana gently waving her hand to direct the medicinal steam toward Toby's nose and mouth.",
      "line_number": 216,
      "duration_ms": 3700
    },
    {
      "block_id": "EP021_B049",
      "episode_id": "EP021",
      "file_index": 48,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Encouraging, Reassuring)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Encouraging",
        "Reassuring"
      ],
      "offscreen": null,
      "start_raw": "01:06.80",
      "end_raw": "01:10.40",
      "start_ms": 66800,
      "end_ms": 70400,
      "text": "\"Yes, just like that. Keep breathing, Toby. Let the vapor clear your chest.\"",
      "line_number": 220,
      "duration_ms": 3600
    },
    {
      "block_id": "EP021_B050",
      "episode_id": "EP021",
      "file_index": 49,
      "scene_id": "EP021_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:10.50",
      "end_raw": "01:13.50",
      "start_ms": 70500,
      "end_ms": 73500,
      "text": "Toby's strained wheezing eases into quiet, rhythmic breathing as he slips into peaceful sleep on his pillow.",
      "line_number": 224,
      "duration_ms": 3000
    },
    {
      "block_id": "EP021_B051",
      "episode_id": "EP021",
      "file_index": 50,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:10.50",
      "end_raw": "01:12.00",
      "start_ms": 70500,
      "end_ms": 72000,
      "text": "Close-up of Toby's face relaxing, his chest falling still and calm.",
      "line_number": 228,
      "duration_ms": 1500
    },
    {
      "block_id": "EP021_B052",
      "episode_id": "EP021",
      "file_index": 51,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:12.00",
      "end_raw": "01:16.00",
      "start_ms": 72000,
      "end_ms": 76000,
      "text": "Close-up of Prudence covering her mouth in overwhelmed relief, tears streaming down her face.",
      "line_number": 232,
      "duration_ms": 4000
    },
    {
      "block_id": "EP021_B053",
      "episode_id": "EP021",
      "file_index": 52,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Overwhelmed, Relieved)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Overwhelmed",
        "Relieved"
      ],
      "offscreen": null,
      "start_raw": "01:12.00",
      "end_raw": "01:15.50",
      "start_ms": 72000,
      "end_ms": 75500,
      "text": "\"Oh, thank God! His chest is quiet! The rattling has stopped!\"",
      "line_number": 236,
      "duration_ms": 3500
    },
    {
      "block_id": "EP021_B054",
      "episode_id": "EP021",
      "file_index": 53,
      "scene_id": "EP021_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:15.50",
      "end_raw": "01:19.50",
      "start_ms": 75500,
      "end_ms": 79500,
      "text": "Lady Juliana pulls the plaid wool blanket snug over Toby's chest, smiling softly with profound relief.",
      "line_number": 240,
      "duration_ms": 4000
    },
    {
      "block_id": "EP021_B055",
      "episode_id": "EP021",
      "file_index": 54,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:16.00",
      "end_raw": "01:19.80",
      "start_ms": 76000,
      "end_ms": 79800,
      "text": "Medium shot of Lady Juliana sitting on a stool beside Toby's bedside, placing a cup of coltsfoot tea on a small wooden table.",
      "line_number": 244,
      "duration_ms": 3800
    },
    {
      "block_id": "EP021_B056",
      "episode_id": "EP021",
      "file_index": 55,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Gentle, Caring)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Gentle",
        "Caring"
      ],
      "offscreen": null,
      "start_raw": "01:16.00",
      "end_raw": "01:19.60",
      "start_ms": 76000,
      "end_ms": 79600,
      "text": "\"Keep him warm. Give him three drops of this coltsfoot tea every morning.\"",
      "line_number": 248,
      "duration_ms": 3600
    },
    {
      "block_id": "EP021_B057",
      "episode_id": "EP021",
      "file_index": 56,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:19.80",
      "end_raw": "01:27.50",
      "start_ms": 79800,
      "end_ms": 87500,
      "text": "Medium close-up of Prudence looking at Lady Juliana with awe and boundless gratitude, her hands clasped in front of her.",
      "line_number": 252,
      "duration_ms": 7700
    },
    {
      "block_id": "EP021_B058",
      "episode_id": "EP021",
      "file_index": 57,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Grateful, Choked with Emotion)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Grateful",
        "Choked with Emotion"
      ],
      "offscreen": null,
      "start_raw": "01:19.80",
      "end_raw": "01:23.00",
      "start_ms": 79800,
      "end_ms": 83000,
      "text": "\"You saved him. The grand doctors left him to choke, but you...\"",
      "line_number": 256,
      "duration_ms": 3200
    },
    {
      "block_id": "EP021_B059",
      "episode_id": "EP021",
      "file_index": 58,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Fervent, Devoted)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Fervent",
        "Devoted"
      ],
      "offscreen": null,
      "start_raw": "01:23.00",
      "end_raw": "01:27.50",
      "start_ms": 83000,
      "end_ms": 87500,
      "text": "\"I have no money, Lady Juliana, but I swear on my life, I will do anything to repay you.\"",
      "line_number": 260,
      "duration_ms": 4500
    },
    {
      "block_id": "EP021_B060",
      "episode_id": "EP021",
      "file_index": 59,
      "scene_id": "EP021_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:27.50",
      "end_raw": "01:30.80",
      "start_ms": 87500,
      "end_ms": 90800,
      "text": "Lady Juliana takes Prudence's trembling hands into hers, smiling with heartfelt warmth.",
      "line_number": 264,
      "duration_ms": 3300
    },
    {
      "block_id": "EP021_B061",
      "episode_id": "EP021",
      "file_index": 60,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:27.50",
      "end_raw": "01:31.00",
      "start_ms": 87500,
      "end_ms": 91000,
      "text": "Close-up of Lady Juliana comforting Prudence warmly.",
      "line_number": 268,
      "duration_ms": 3500
    },
    {
      "block_id": "EP021_B062",
      "episode_id": "EP021",
      "file_index": 61,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "LADY JULIANA (Warm, Sincere)",
      "speaker": "LADY JULIANA",
      "delivery": [
        "Warm",
        "Sincere"
      ],
      "offscreen": null,
      "start_raw": "01:27.70",
      "end_raw": "01:30.50",
      "start_ms": 87700,
      "end_ms": 90500,
      "text": "\"Your brother's breath is payment enough for me, Prudence.\"",
      "line_number": 272,
      "duration_ms": 2800
    },
    {
      "block_id": "EP021_B063",
      "episode_id": "EP021",
      "file_index": 62,
      "scene_id": "EP021_S03",
      "block_type": "CAMERA",
      "label_raw": "CAMERA",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:31.00",
      "end_raw": "01:36.50",
      "start_ms": 91000,
      "end_ms": 96500,
      "text": "Low-angle shot past sleeping Toby toward Prudence standing in the room, her expression darkening with anger.",
      "line_number": 276,
      "duration_ms": 5500
    },
    {
      "block_id": "EP021_B064",
      "episode_id": "EP021",
      "file_index": 63,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Indignant, Resentful)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Indignant",
        "Resentful"
      ],
      "offscreen": null,
      "start_raw": "01:31.00",
      "end_raw": "01:34.50",
      "start_ms": 91000,
      "end_ms": 94500,
      "text": "\"At the grand manor, they ignore us. They only care about their own luxury.\"",
      "line_number": 280,
      "duration_ms": 3500
    },
    {
      "block_id": "EP021_B065",
      "episode_id": "EP021",
      "file_index": 64,
      "scene_id": "EP021_S03",
      "block_type": "DIALOGUE",
      "label_raw": "PRUDENCE (Ominous)",
      "speaker": "PRUDENCE",
      "delivery": [
        "Ominous"
      ],
      "offscreen": null,
      "start_raw": "01:34.60",
      "end_raw": "01:36.40",
      "start_ms": 94600,
      "end_ms": 96400,
      "text": "\"But their gold cannot buy them health.\"",
      "line_number": 284,
      "duration_ms": 1800
    },
    {
      "block_id": "EP021_B066",
      "episode_id": "EP021",
      "file_index": 65,
      "scene_id": "EP021_S03",
      "block_type": "ACTION",
      "label_raw": "ACTION",
      "speaker": null,
      "delivery": [],
      "offscreen": null,
      "start_raw": "01:36.50",
      "end_raw": "01:38.20",
      "start_ms": 96500,
      "end_ms": 98200,
      "text": "Lady Juliana turns sharply, her eyes widening with sudden recognition.",
      "line_number": 288,
      "duration_ms": 1700
    },
    {
      "block_id": "EP021_B067",
